[{"name":"fahadkshehri/RESTful-Weather-Twitter-Bot-Provider","owner":"fahadkshehri","html_url":"https://github.com/fahadkshehri/RESTful-Weather-Twitter-Bot-Provider","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":"This C# weather application is designed so that users can input a city that they would like to check weather details on. The weather data for this program is retrieved by utilizing a free RESTful API service found on openweathermap.org As a result of the query sent to the API with a specific city name and an app_id, a JSON file is returned containing the weather details on the chosen city. To make sense of the data, de-serialization is made to turn the contents of the JSON file to meaningful C# objects. After deserializing the JSON file, useful weather information is gathered by calling the states in of RootObject. Then, the weather details get printed via using the console.","topics":[],"score":210695,"global_rank":270952},{"name":"prescottbreeden/wedding_planner_cs","owner":"prescottbreeden","html_url":"https://github.com/prescottbreeden/wedding_planner_cs","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":null,"topics":[],"score":210695,"global_rank":270954},{"name":"gmfk07/Ball-Racer","owner":"gmfk07","html_url":"https://github.com/gmfk07/Ball-Racer","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":null,"topics":[],"score":210695,"global_rank":270960},{"name":"darrinm/ucupcake","owner":"darrinm","html_url":"https://github.com/darrinm/ucupcake","stars":1,"forks":0,"watchers":1,"issues":0,"language":"C#","description":null,"topics":[],"score":210684,"global_rank":270994},{"name":"booellean/ShutdownAlarm","owner":"booellean","html_url":"https://github.com/booellean/ShutdownAlarm","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":"A two in one shutdown and  'awaken' program for people who go to sleep while watching shows on a computer","topics":[],"score":21