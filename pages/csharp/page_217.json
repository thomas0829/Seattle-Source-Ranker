[{"name":"fahadkshehri/RESTful-Weather-Twitter-Bot-Provider","owner":"fahadkshehri","html_url":"https://github.com/fahadkshehri/RESTful-Weather-Twitter-Bot-Provider","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":"This C# weather application is designed so that users can input a city that they would like to check weather details on. The weather data for this program is retrieved by utilizing a free RESTful API service found on openweathermap.org As a result of the query sent to the API with a specific city name and an app_id, a JSON file is returned containing the weather details on the chosen city. To make sense of the data, de-serialization is made to turn the contents of the JSON file to meaningful C# objects. After deserializing the JSON file, useful weather information is gathered by calling the states in of RootObject. Then, the weather details get printed via using the console.","topics":[],"score":210736,"global_rank":270921},{"name":"MarkStrickland562/PackerTracker.Solution","owner":"MarkStrickland562","html_url":"https://github.com/MarkStrickland562/PackerTracker.Solution","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":null,"topics":[],"score":210736,"global_rank":270947},{"name":"MarkStrickland562/Places.Solution","owner":"MarkStrickland562","html_url":"https://github.com/MarkStrickland562/Places.Solution","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":null,"topics":[],"score":210736,"global_rank":270948},{"name":"prescottbreeden/wedding_planner_cs","owner":"prescottbreeden","html_url":"https://github.com/prescottbreeden/wedding_planner_cs","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":null,"topics":[],"score":210736,"global_rank":270952},{"name":"MicaelaDJ/Places-Been","owner":"MicaelaDJ","html_url":"https://github.com/MicaelaDJ/Places-Been","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C#","description":"epicodus c# week 2 wednesday pro