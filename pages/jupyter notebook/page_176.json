146589},{"name":"rik2801/ML","owner":"rik2801","html_url":"https://github.com/rik2801/ML","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":224576,"global_rank":146608},{"name":"Tingyu98/Analysis-of-factors-affecting-homeownership-A-Support-Vector-Machine-Approach","owner":"Tingyu98","html_url":"https://github.com/Tingyu98/Analysis-of-factors-affecting-homeownership-A-Support-Vector-Machine-Approach","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":224576,"global_rank":146609}]