 long-lived in vivo protein secretion, which can be modeled in small animals.","topics":[],"score":222915,"global_rank":169205},{"name":"sungmoo89/sanfransico_bike_sharing","owner":"sungmoo89","html_url":"https://github.com/sungmoo89/sanfransico_bike_sharing","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":222915,"global_rank":169206},{"name":"thomasgreenacre/DE_Wk1_Project-3--Part1--core-","owner":"thomasgreenacre","html_url":"https://github.com/thomasgreenacre/DE_Wk1_Project-3--Part1--core-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":222915,"global_rank":169218},{"name":"thomasgreenacre/DE_Week1_GitHub-Desktop--Practice-","owner":"thomasgreenacre","html_url":"https://github.com/thomasgreenacre/DE_Week1_GitHub-Desktop--Practice-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":222915,"global_rank":169219},{"name":"Jonny-T87/Books--Core-","owner":"Jonny-T87","html_url":"https://github.com/Jonny-T87/Books--Core-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":222906,"global_rank":169275},{"name":"Jonny-T87/Queries--Sakila--Core-","owner":"Jonny-T87","html_url":"https://github.com/Jonny-T87/Queries--Sakila--Core-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":222906,"global_rank":169276},{"name":"coltenappleby/cribbage-sim","owner":"coltenappleby","html_url":"https://github.com/coltenappleby/cribbage-sim","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":222906,"global_rank":169286},{"name":"ckayxian/iris-prediction-KNN","owner":"ckayxian","html_url":"https://github.com/ckayxian/iris-prediction-KNN","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","descri