,803.","topics":[],"score":237593,"global_rank":85772},{"name":"shik3519/deep-learning","owner":"shik3519","html_url":"https://github.com/shik3519/deep-learning","stars":3,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":null,"topics":["cnn-model","dataloader","pytorch"],"score":237590,"global_rank":85774},{"name":"mjuric/petascale-streaming-demo","owner":"mjuric","html_url":"https://github.com/mjuric/petascale-streaming-demo","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":"Materials for the Kafka streaming demo at Petascale 2019","topics":[],"score":237583,"global_rank":85797},{"name":"liamkirkpatrick/atm552_capstone","owner":"liamkirkpatrick","html_url":"https://github.com/liamkirkpatrick/atm552_capstone","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"ATM 552 Capstone Project - Investigation of Drivers of Denali Precip-Weighted Temp","topics":[],"score":237575,"global_rank":85815},{"name":"srsaito/ft-tutorial","owner":"srsaito","html_url":"https://github.com/srsaito/ft-tutorial","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":237567,"global_rank":85843},{"name":"Photon1c/Flowveyor","owner":"Photon1c","html_url":"https://github.com/Photon1c/Flowveyor","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Supply chain visualizer with continually uploaded scripts","topics":[],"score":237567,"global_rank":85849},{"name":"Krish-Mahajan/LangChainIntro","owner":"Krish-Mahajan","html_url":"https://github.com/Krish-Mahajan/LangChainIntro","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":237567,"global_rank":85850},{"name":"dezertdweller/mentor-assignments","owner":"dezertdweller","html_url":"https://github.com/dezertdweller/mentor-assignments","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jup