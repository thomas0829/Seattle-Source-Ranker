,803.","topics":[],"score":237019,"global_rank":85235},{"name":"pauescalantec/big-data-act","owner":"pauescalantec","html_url":"https://github.com/pauescalantec/big-data-act","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Actividades de big data","topics":[],"score":237019,"global_rank":85245},{"name":"ishitajain21/MIR-lab","owner":"ishitajain21","html_url":"https://github.com/ishitajain21/MIR-lab","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Human readable transcription","topics":[],"score":237019,"global_rank":85252},{"name":"zachsevart/COMP3330Assignment2","owner":"zachsevart","html_url":"https://github.com/zachsevart/COMP3330Assignment2","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"This repository contains all code and files used to complete assignment2 for COMP3330: Machine Intelligence. The project uses a LSTM neural network to attempt to identify a recession in the US economy using key indicators. ","topics":[],"score":237019,"global_rank":85259}]