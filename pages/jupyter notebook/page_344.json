[{"name":"karanmurthy7/Progresa_Data_Analysis","owner":"karanmurthy7","html_url":"https://github.com/karanmurthy7/Progresa_Data_Analysis","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":"This is an in-depth analysis of the Progresa program, a government social assistance program in Mexico. This program, as well as the details of its impact, are described in the paper \"School subsidies for the poor: evaluating the Mexican Progresa poverty program\", by Paul Shultz (available on Canvas). The goal of this problem set is to implement some of the basic econometric techniques to measure the impact of Progresa on secondary school enrollment rates. The timeline of the program was: Baseline survey conducted in 1997 Intervention begins in 1998, \"Wave 1\" of data collected in 1998 \"Wave 2 of data\" collected in 1999 Evaluation ends in 2000, at which point the control villages were treated. The data is the actual data collected to evaluate the impact of the Progresa program. In this file, each row corresponds to an observation taken for a given child for a given year. There are two years of data (1997 and 1998), and just under 40,000 children who are surveyed in each year.","topics":[],"score":1891,"global_rank":351678},{"name":"legomushroom/ML_washington_course1","owner":"legomushroom","html_url":"https://github.com/legomushroom/ML_washington_course1","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":1890,"global_rank":351793},{"name":"kurtrm/ml_projects","owner":"kurtrm","html_url":"https://github.com/kurtrm/ml_projects","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":"This repository is dedicated to my personal journey through machine learning in Python. ","topics":[],"score":1890,"global_rank":351801},{"name":"nicholas-maltbie/QToe","owner":"nicholas-maltbie","html_url":"https://github.com/nicholas-maltbie/QToe","stars":0,"forks":