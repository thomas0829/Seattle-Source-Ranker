[{"name":"jerome9189/shors-algorithm","owner":"jerome9189","html_url":"https://github.com/jerome9189/shors-algorithm","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Jupyter Notebook","description":"Implementation of Shor's factoring algorithm in Qiskit","topics":[],"score":223327,"global_rank":168913},{"name":"MeetTheSDE/Object-Detection","owner":"MeetTheSDE","html_url":"https://github.com/MeetTheSDE/Object-Detection","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223327,"global_rank":168929},{"name":"calvintirrell/smartphone_price_classification","owner":"calvintirrell","html_url":"https://github.com/calvintirrell/smartphone_price_classification","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Determine a new smartphone's price based on similar specifications to current phone models.","topics":[],"score":223327,"global_rank":168947},{"name":"shivankgoel/unbiased_reviews","owner":"shivankgoel","html_url":"https://github.com/shivankgoel/unbiased_reviews","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Online review aggregation platforms suffer from biases which can lead to distress to both the platforms and their consumers as the average rating crowd sourced on these platforms do not represent the correct perceived quality of the product or service. We look at the problem of polarization bias on Yelp and present the evaluation of an estimation model to determine the unbiased average rating. We explore how the Yelp's elite membership program helps in cutting down the bias. Our results propose that the average biased rating listed on platforms is correlated with the true unbiased rating and by including more information from online reviews as input features of our model we can get a reasonably well\u00a0estimate of the average unbiased ratings. We propose and compare several predictive models to estimate unbiased average ratings and show how textual data can play a critical role in enhancing the predictive power. Our results can help review aggregation platforms to determine mechanisms to cut down the bias on their platforms and can benefit businesses and consumers on their platform to access a fairer metric for service quality.","topics":[],"score":223327,"global_rank":168954},{"name":"ch3rnoalpha/Efficient-Yelp-API-Calls--Core-","owner":"ch3rnoalpha","html_url":"https://github.com/ch3rnoalpha/Efficient-Yelp-API-Calls--Core-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223322,"global_rank":168966},{"name":"laurinalastella/PyBer_Analysis","owner":"laurinalastella","html_url":"https://github.com/laurinalastella/PyBer_Analysis","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223322,"global_rank":168971},{"name":"datatalking/Epic_Generator","owner":"datatalking","html_url":"https://github.com/datatalking/Epic_Generator","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Python script to automate repo documentation","topics":[],"score":223322,"global_rank":168988},{"name":"gothwalritu/PyBer_Analysis","owner":"gothwalritu","html_url":"https://github.com/gothwalritu/PyBer_Analysis","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"To create visualization","topics":[],"score":223322,"global_rank":168994},{"name":"Yabuku-xD/bfloat16-fraud-detection","owner":"Yabuku-xD","html_url":"https://github.com/Yabuku-xD/bfloat16-fraud-detection","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"This project focuses on detecting fraudulent credit card transactions by comparing standard floating-point (float32) and bfloat16 precision methods to improve scalability and efficiency.","topics":[],"score":223316,"global_rank":169006},{"name":"shubham-gaur-