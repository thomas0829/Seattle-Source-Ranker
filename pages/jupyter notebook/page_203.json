223042,"global_rank":168861},{"name":"silvanoross/Arbitrage_Analysis_2","owner":"silvanoross","html_url":"https://github.com/silvanoross/Arbitrage_Analysis_2","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Asset risk analysis","topics":[],"score":223042,"global_rank":168875},{"name":"sungmoo89/sanfransico_bike_sharing","owner":"sungmoo89","html_url":"https://github.com/sungmoo89/sanfransico_bike_sharing","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223042,"global_rank":168882},{"name":"hashem20/billups","owner":"hashem20","html_url":"https://github.com/hashem20/billups","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223042,"global_rank":168884},{"name":"Rene2718/Long-term-engraftment-of-engineered-human-plasma-cells-","owner":"Rene2718","html_url":"https://github.com/Rene2718/Long-term-engraftment-of-engineered-human-plasma-cells-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"Due to their unique longevity and capacity to secrete high levels of protein, plasma B cells play have the potential to be used as a cell therapy for protein replacement. Here, we show that ex vivo engineered human plasma cells exhibited transcriptional and ultrastructural features of long-lived plasma cells and migrated to the bone marrow in immunodeficient mice. After transferring human plasma cells to immunodeficient mice in the presence of the human cytokines BAFF and IL6, we observed increases in retention of plasma cells in the bone marrow, with engraftment exceeding a year. The most profound in vivo effects of human IL6 were observed within 20 days of transfer and could be explained by decreased apoptosis in newly differentiated plasma cells. Collectively, these results show that ex vivo engineered and differentiated human plasma cells have the potential for long-lived in vivo protein secretion, which can be modeled in small animals.","topics":[],"score":223042,"global_rank":168911},{"name":"thomasgreenacre/DE_Wk1_Project-3--Part1--core-","owner":"thomasgreenacre","html_url":"https://github.com/thomasgreenacre/DE_Wk1_Project-3--Part1--core-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223042,"global_rank":168914},{"name":"thomasgreenacre/DE_Week1_GitHub-Desktop--Practice-","owner":"thomasgreenacre","html_url":"https://github.com/thomasgreenacre/DE_Week1_GitHub-Desktop--Practice-","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":223042,"global_rank":168915},{"name":"seabassR5/ml_from_scratch","owner":"seabassR5","html_url":"https://github.com/seabassR5/ml_from_scratch","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Jupyter Notebook","description":"me learning by building small scale stuff from scratch","topics":[],"score":223042,"global_rank":168932}]