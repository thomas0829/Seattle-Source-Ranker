[{"name":"karanmurthy7/Progresa_Data_Analysis","owner":"karanmurthy7","html_url":"https://github.com/karanmurthy7/Progresa_Data_Analysis","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":"This is an in-depth analysis of the Progresa program, a government social assistance program in Mexico. This program, as well as the details of its impact, are described in the paper \"School subsidies for the poor: evaluating the Mexican Progresa poverty program\", by Paul Shultz (available on Canvas). The goal of this problem set is to implement some of the basic econometric techniques to measure the impact of Progresa on secondary school enrollment rates. The timeline of the program was: Baseline survey conducted in 1997 Intervention begins in 1998, \"Wave 1\" of data collected in 1998 \"Wave 2 of data\" collected in 1999 Evaluation ends in 2000, at which point the control villages were treated. The data is the actual data collected to evaluate the impact of the Progresa program. In this file, each row corresponds to an observation taken for a given child for a given year. There are two years of data (1997 and 1998), and just under 40,000 children who are surveyed in each year.","topics":[],"score":187848,"global_rank":374344},{"name":"enesdilber/Project_Pokemon2","owner":"enesdilber","html_url":"https://github.com/enesdilber/Project_Pokemon2","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":"Deep Learning for Pok\u00e9mon","topics":[],"score":187840,"global_rank":374406},{"name":"SaloniDash7/MachineLearning-Algorithms","owner":"SaloniDash7","html_url":"https://github.com/SaloniDash7/MachineLearning-Algorithms","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Jupyter Notebook","description":"Vanilla implementation of generic Machine Learning algorithms","topics":[],"score":187832,"global_rank":374459},{"name":"rjleveque/visualization_2016","owner":"rjleveque","html_url":"https://github.com/rjlev