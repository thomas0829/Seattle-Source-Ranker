[{"name":"Geeoon/Rockets2D","owner":"Geeoon","html_url":"https://github.com/Geeoon/Rockets2D","stars":1,"forks":0,"watchers":2,"issues":0,"language":"C++","description":"Rockets2D, a 2D rocket simulator.","topics":[],"score":250839,"global_rank":60795},{"name":"moltenform/foobar2000_drag_drop_play","owner":"moltenform","html_url":"https://github.com/moltenform/foobar2000_drag_drop_play","stars":3,"forks":1,"watchers":1,"issues":0,"language":"C++","description":"Plugin for Foobar2000 audio player that plays music instantly after drag and drop","topics":[],"score":250837,"global_rank":60799},{"name":"artkolpakov/Hunt-the-Wumpus","owner":"artkolpakov","html_url":"https://github.com/artkolpakov/Hunt-the-Wumpus","stars":1,"forks":0,"watchers":1,"issues":0,"language":"C++","description":"Hunt the Wumpus is a console game set inside the cave of the Wumpus, a scary, gold-hoarding monster who likes to eat people who disturb its sleep. The player's goal is to guide an adventurer to kill the Wumpus, find its hidden gold, and escape alive. The Wumpus lives in a large cave of rooms arranged in a grid, where each room has four tunnels leading to the rooms to the north, east, south, and west.  The adventurer starts the game in a random empty room in the Wumpus\u2019 cave. Her starting position is also the location of the escape rope that she must use to escape after she's completed her task.  Each room may be empty, or it may contain one (and only one) of four \"events\" (all described below): two kinds of dangerous hazards, the terrifying Wumpus, and the gold treasure. When the adventurer is in a room that\u2019s adjacent to one containing an \"event\", the player will receive a percept (a message) to inform them about the event the adventurer is close to.  If the adventurer perishes while searching for the Wumpus, the player should be presented with the option to start the game over with the same cave configuration, start the game over with a new random cave configuration, or quit the game entirely.  The player wins the game if they can safely guide the adventurer through the cave to kill the Wumpus, pick up the gold, and make it back to the escape rope unharmed! Note: If you enter the cave, retrieve the gold, and escape without killing the Wumpus, that's okay too. The player still wins.","topics":[],"score":250810,"global_rank":60853},{"name":"jkguiang/cmsql","owner":"jkguiang","html_url":"https://github.com/jkguiang/cmsql","stars":0,"forks":2,"watchers":2,"issues":0,"language":"C++","description":null,"topics":[],"score":250803,"global_rank":60869},{"name":"alloy/TremoloAudioUnitTutorial","owner":"alloy","html_url":"https://github.com/alloy/TremoloAudioUnitTutorial","stars":3,"forks":2,"watchers":2,"issues":0,"language":"C++","description":null,"topics":[],"score":250787,"global_rank":60893},{"name":"rohsara/sensor-battle","owner":"rohsara","html_url":"https://github.com/rohsara/sensor-battle","stars":1,"forks":0,"watchers":1,"issues":0,"language":"C++","description":null,"topics":[],"score":250774,"global_rank":60935},{"name":"rjrivera/code-dojo","owner":"rjrivera","html_url":"https://github.com/rjrivera/code-dojo","stars":0,"forks":2,"watchers":1,"issues":0,"language":"C++","description":null,"topics":[],"score":250770,"global_rank":60940},{"name":"RodDeacon/cockatrice_booster","owner":"RodDeacon","html_url":"https://github.com/RodDeacon/cockatrice_booster","stars":1,"forks":0,"watchers":1,"issues":0,"language":"C++","description":null,"topics":[],"score":250749,"global_rank":60971},{"name":"afrdt/mechClassTest","owner":"afrdt","html_url":"https://github.com/afrdt/mechClassTest","stars":1,"forks":0,"watchers":1,"issues":0,"language":"C++","description":null,"topics":[],"score":250749,"global_rank":60973},{"name":"Shuvo091/Living-room-with-GLUT","owner":"Shuvo091","html_url":"https://github.com/Shuvo091/Living-room-with-GLUT","stars":1,"forks":0,"watchers":1,"issues":0,"language":"C++","description":null,"topics":[],"score":250749,"glob