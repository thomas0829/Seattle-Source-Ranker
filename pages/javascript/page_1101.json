9210},{"name":"karmjeetnamol/react_portfolio","owner":"karmjeetnamol","html_url":"https://github.com/karmjeetnamol/react_portfolio","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"This project was bootstrapped with Create React App.  Acceptance Criteria GIVEN a single-page application portfolio for a web developer WHEN I load the portfolio THEN I am presented with a page containing a header, a section for content, and a footer WHEN I view the header THEN I am presented with the developer's name and navigation with titles corresponding to different sections of the portfolio WHEN I view the navigation titles THEN I am presented with the titles About Me, Portfolio, Contact, and Resume, and the title corresponding to the current section is highlighted WHEN I click on a navigation title THEN I am presented with the corresponding section below the navigation without the page reloading and that title is highlighted WHEN I load the portfolio the first time THEN the About Me title and section are selected by default WHEN I am presented with the About Me section THEN I see a recent photo of the developer and a short bio about me WHEN I am presented with the Portfolio section THEN I see titled images of three of the developer\u2019s applications with links to both the deployed applications and the corresponding GitHub repository WHEN I am presented with the Contact section THEN I see a contact form with fields for a name, an email address, and a message WHEN I move my cursor out of one of the form fields without entering text THEN I receive a notification that this field is required WHEN I enter text into the email address field THEN I receive a notification if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":216356,"global_rank":239211},{"name":"NateBennett9/Dinner_and_a_Movie","owner":"NateBennett9","html_url":"https://github.com/NateBennett9/Dinner_and_a_Movie","stars":1,"forks":0,"watchers":0,"issues":12,"language":"JavaScript","description":"Dinner and a Movie","topics":[],"score":216351,"global_rank":239216},{"name":"everest7/Socket-Chat","owner":"everest7","html_url":"https://github.com/everest7/Socket-Chat","stars":1,"forks":0,"watchers":0,"issues":8,"language":"JavaScript","description":"Real-time chat application","topics":[],"score":216351,"global_rank":239217},{"name":"nreynoldson/TSSS","owner":"nreynoldson","html_url":"https://github.com/nreynoldson/TSSS","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"Database for CS340","topics":[],"score":216348,"global_rank":239228},{"name":"srinivasrk/node-influx-file-upload","owner":"srinivasrk","html_url":"https://github.com/srinivasrk/node-influx-file-upload","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"handle large file upload to node using a intelligent buffer","topics":[],"score":216345,"global_rank":239240},{"name":"arnellebalane/stylelint-config-arnellebalane","owner":"arnellebalane","html_url":"https://github.com/arnellebalane/stylelint-config-arnellebalane","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"My personal Stylelint configuration","topics":["stylelint","stylelint-config"],"score":216345,"global_rank":239242},{"name":"h64/react-burger","owner":"h64","html_url":"https://github.com/h64/react-burger","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":216345,"global_rank":239247},{"name":"Ashwin7mak/unit-testing-in-mocha","owner":"Ashwin7mak","html_url":"https://github.com/Ashwin7mak/unit-testing-in-mocha","stars"