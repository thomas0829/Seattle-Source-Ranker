plicated instances are maintained which are served with Elastic Load Balancers to forward requests fairly. ","topics":[],"score":191694,"global_rank":340000},{"name":"khnguyen94/Burgers","owner":"khnguyen94","html_url":"https://github.com/khnguyen94/Burgers","stars":0,"forks":0,"watchers":0,"issues":7,"language":"JavaScript","description":null,"topics":[],"score":191694,"global_rank":340001},{"name":"nickubed/social-life-sim","owner":"nickubed","html_url":"https://github.com/nickubed/social-life-sim","stars":0,"forks":0,"watchers":0,"issues":6,"language":"JavaScript","description":null,"topics":[],"score":191694,"global_rank":340002},{"name":"pruicr/watch-viewer-app","owner":"pruicr","html_url":"https://github.com/pruicr/watch-viewer-app","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"An app to store and view my watch collection on.","topics":[],"score":191694,"global_rank":340003},{"name":"vbharam/angular1.5-myBlog","owner":"vbharam","html_url":"https://github.com/vbharam/angular1.5-myBlog","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Basic blog using Angular 1.5 + ES6","topics":[],"score":191694,"global_rank":340007},{"name":"ewelaryba/object_practice_pt","owner":"ewelaryba","html_url":"https://github.com/ewelaryba/object_practice_pt","stars":0,"forks":1,"watchers":0,"issues":1,"language":"JavaScript","description":null,"topics":[],"score":191688,"global_rank":340014},{"name":"martiansnoop/fetch-wrappers","owner":"martiansnoop","html_url":"https://github.com/martiansnoop/fetch-wrappers","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Some small utilities involving the fetch api that I want to share among nodejs projects","topics":[],"score":191686,"global_rank":340019},{"name":"kumudug/Angular-Tutorial-Heroes-VisualStudio","owner":"kumudug","html_url":"https://github.com/kumudug/Angular-Tutorial-Heroes-VisualStudio","stars":0,"forks":0,"watchers":1,"issues"