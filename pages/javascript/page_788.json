GitHub repository WHEN I am presented with the Contact section THEN I see a contact form with fields for a name, an email address, and a message WHEN I move my cursor out of one of the form fields without entering text THEN I receive a notification that this field is required WHEN I enter text into the email address field THEN I receive a notification if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":223475,"global_rank":173433},{"name":"kenneth-bakke/address-book","owner":"kenneth-bakke","html_url":"https://github.com/kenneth-bakke/address-book","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223475,"global_rank":173438},{"name":"carolyvn/note-taker","owner":"carolyvn","html_url":"https://github.com/carolyvn/note-taker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223475,"global_rank":173441},{"name":"AndrewJFleming/purgation-react-ecommerce","owner":"AndrewJFleming","html_url":"https://github.com/AndrewJFleming/purgation-react-ecommerce","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Digital products ecommerce web app built with the MERN stack.","topics":[],"score":223475,"global_rank":173443},{"name":"bbtrombone01/David_Scott_Ut1","owner":"bbtrombone01","html_url":"https://github.com/bbtrombone01/David_Scott_Ut1","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223475,"global_rank":173448},{"name":"calvin-kim13/noteTaker","owner":"calvin-kim13","html_url":"https://github.com/calvin-kim13