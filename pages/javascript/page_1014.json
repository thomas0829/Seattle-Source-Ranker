tonGuessingGame","owner":"fabricekalvanda","html_url":"https://github.com/fabricekalvanda/washingtonGuessingGame","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"The Cities of Washington State Guessing Game allows the user to make five guesses to name a city in Washington, while also giving three hints: the first letter in the city, the last letter of the city, and the number of letters in the city. It will provide the user with the name of the city if he-or-she fails to correctly guess it, and will ask the user if he-or-she would like to play the game again.","topics":[],"score":217539,"global_rank":231040},{"name":"myerstina515/auth-api","owner":"myerstina515","html_url":"https://github.com/myerstina515/auth-api","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":217539,"global_rank":231041}]