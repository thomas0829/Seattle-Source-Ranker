[{"name":"mssrinivas/Slack-Clone","owner":"mssrinivas","html_url":"https://github.com/mssrinivas/Slack-Clone","stars":0,"forks":0,"watchers":1,"issues":16,"language":"JavaScript","description":"The developed aims to achieve the following objectives:  Development of a messaging application which allows users to post fast, durable messages to other users and groups.  Integration of the developed messaging application with a Buffer space (Kafka message Queue) that increases the durability of the stored messages in cases of complete memory consumption and network partition.  Integrating a durable messaging system which allows the separation of concerns between scaling and database (Database independent message queueing).  Kafka ensures message delivery at least once (Delivery guarantee). Message offsets that help consumers (The Backend Spring Boot Application here) track the point till which messages have been consumed from the Kafka queue.   Deployment of the messaging application with the Kafka broker to the cloud (AWS) where replicated instances are maintained which are served with Elastic Load Balancers to forward requests fairly. ","topics":[],"score":202327,"global_rank":305288},{"name":"khnguyen94/Burgers","owner":"khnguyen94","html_url":"https://github.com/khnguyen94/Burgers","stars":0,"forks":0,"watchers":1,"issues":7,"language":"JavaScript","description":null,"topics":[],"score":202327,"global_rank":305289},{"name":"nickubed/social-life-sim","owner":"nickubed","html_url":"https://github.com/nickubed/social-life-sim","stars":0,"forks":0,"watchers":1,"issues":6,"language":"JavaScript","description":null,"topics":[],"score":202327,"global_rank":305290},{"name":"chrisarevir/game-of-jeffpardy","owner":"chrisarevir","html_url":"https://github.com/chrisarevir/game-of-jeffpardy","stars":0,"forks":0,"watchers":1,"issues":15,"language":"JavaScript","description":"It answers","topics":[],"score":202327,"global_rank":305292},{"name":"justinsoliz/backbone_tunes","owner":"j