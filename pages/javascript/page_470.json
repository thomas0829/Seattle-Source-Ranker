[{"name":"fabricekalvanda/TheHangmanGame","owner":"fabricekalvanda","html_url":"https://github.com/fabricekalvanda/TheHangmanGame","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"The Hangman Game allows the user to make ten chances to select letters to guess the secret word. With every letter guess, the letter will be displayed along with the previous letter guesses. Incorrect guesses will slowly build the scaffolding, noose, and sections of the hanged man's body (by swapping out images) until all ten guesses are used up. The game will 'reveal' correct letters as they are guessed (by replacing asterisks *), keep track of the number of guesses used, as well as the number of guesses remaining. It will provide the user with the name of the secret word if he-or-she fails to correctly guess it.","topics":[],"score":226817,"global_rank":120879},{"name":"fabricekalvanda/washingtonGuessingGame","owner":"fabricekalvanda","html_url":"https://github.com/fabricekalvanda/washingtonGuessingGame","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"The Cities of Washington State Guessing Game allows the user to make five guesses to name a city in Washington, while also giving three hints: the first letter in the city, the last letter of the city, and the number of letters in the city. It will provide the user with the name of the city if he-or-she fails to correctly guess it, and will ask the user if he-or-she would like to play the game again.","topics":[],"score":226817,"global_rank":120886},{"name":"myerstina515/auth-api","owner":"myerstina515","html_url":"https://github.com/myerstina515/auth-api","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":226817,"global_rank":120890},{"name":"dbpatnode/mithril-playground","owner":"dbpatnode","html_url":"https://github.com/dbpatnode/mithril-playground","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript