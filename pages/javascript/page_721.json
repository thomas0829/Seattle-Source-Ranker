if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":2269,"global_rank":160044},{"name":"Daymond-Blair/pokemon-game","owner":"Daymond-Blair","html_url":"https://github.com/Daymond-Blair/pokemon-game","stars":0,"forks":0,"watchers":1,"issues":2,"language":"JavaScript","description":null,"topics":[],"score":2269,"global_rank":160046},{"name":"Merkraith/Dragon-City-Resource","owner":"Merkraith","html_url":"https://github.com/Merkraith/Dragon-City-Resource","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":2269,"global_rank":160047},{"name":"bmhan319/countriesRestAPI","owner":"bmhan319","html_url":"https://github.com/bmhan319/countriesRestAPI","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Country search app","topics":[],"score":2269,"global_rank":160054},{"name":"struelensc/express-note-taker","owner":"struelensc","html_url":"https://github.com/struelensc/express-note-taker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":2269,"global_rank":160055},{"name":"struelensc/password-generator","owner":"struelensc","html_url":"https://github.com/struelensc/password-generator","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":2269,"global_rank":160056},{"name":"carlydekock/book_app","owner":"carlydekock","html_url":"https://github.com/carlydekock/book_app","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":2269,"global_rank":160065},{"name":"uhAlexGrant/c