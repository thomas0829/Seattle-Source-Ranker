[{"name":"karmjeetnamol/Book-Search_Engine","owner":"karmjeetnamol","html_url":"https://github.com/karmjeetnamol/Book-Search_Engine","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223502,"global_rank":173161},{"name":"karmjeetnamol/react_portfolio","owner":"karmjeetnamol","html_url":"https://github.com/karmjeetnamol/react_portfolio","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"This project was bootstrapped with Create React App.  Acceptance Criteria GIVEN a single-page application portfolio for a web developer WHEN I load the portfolio THEN I am presented with a page containing a header, a section for content, and a footer WHEN I view the header THEN I am presented with the developer's name and navigation with titles corresponding to different sections of the portfolio WHEN I view the navigation titles THEN I am presented with the titles About Me, Portfolio, Contact, and Resume, and the title corresponding to the current section is highlighted WHEN I click on a navigation title THEN I am presented with the corresponding section below the navigation without the page reloading and that title is highlighted WHEN I load the portfolio the first time THEN the About Me title and section are selected by default WHEN I am presented with the About Me section THEN I see a recent photo of the developer and a short bio about me WHEN I am presented with the Portfolio section THEN I see titled images of three of the developer\u2019s applications with links to both the deployed applications and the corresponding GitHub repository WHEN I am presented with the Contact section THEN I see a contact form with fields for a name, an email address, and a message WHEN I move my cursor out of one of the form fields without entering text THEN I receive a notification that this field is required WHEN I enter text into the email address field THEN I receive a notification if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":223502,"global_rank":173162},{"name":"taegorov/shopping-list","owner":"taegorov","html_url":"https://github.com/taegorov/shopping-list","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223502,"global_rank":173163},{"name":"robertipk/React_Web3","owner":"robertipk","html_url":"https://github.com/robertipk/React_Web3","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Miscellaenous React Web3 snippets","topics":[],"score":223502,"global_rank":173172},{"name":"Marc-Chiu/anagrams","owner":"Marc-Chiu","html_url":"https://github.com/Marc-Chiu/anagrams","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Using Node.js and Javascript to make anagrams game","topics":[],"score":223502,"global_rank":173173},{"name":"bbtrombone01/David_Scott_Ut1","owner":"bbtrombone01","html_url":"https://github.com/bbtrombone01/David_Scott_Ut1","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223502,"global_rank":173175},{"name":"AndrewJFleming/purgation-react-ecommerce","owner":"AndrewJFleming","html_url":"https://github.com/AndrewJFleming/purgation-react-ecommerce","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Digital products ecommerce web app built with the MERN stack.","topics":[],"score":223502,"global_rank":173176},{"name":"vogtn/SafetyPin","owner":"vogtn","html_url":"https://github.com/vogtn/SafetyPin","stars":0,"forks":2,"watchers":2,"issues":0,"language":"JavaScript","description":"P