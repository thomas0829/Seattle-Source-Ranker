 section THEN I see a contact form with fields for a name, an email address, and a message WHEN I move my cursor out of one of the form fields without entering text THEN I receive a notification that this field is required WHEN I enter text into the email address field THEN I receive a notification if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":223448,"global_rank":173938},{"name":"PastaShock/express-note-taker","owner":"PastaShock","html_url":"https://github.com/PastaShock/express-note-taker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223448,"global_rank":173945},{"name":"kenneth-bakke/address-book","owner":"kenneth-bakke","html_url":"https://github.com/kenneth-bakke/address-book","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223448,"global_rank":173951},{"name":"robertipk/React_Web3","owner":"robertipk","html_url":"https://github.com/robertipk/React_Web3","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Miscellaenous React Web3 snippets","topics":[],"score":223448,"global_rank":173952},{"name":"VitaRox/homework-3","owner":"VitaRox","html_url":"https://github.com/VitaRox/homework-3","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223448,"global_rank":173955},{"name":"DameonL/ILoveLamp","owner":"DameonL","html_url":"https://github.com/DameonL/ILoveLamp","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":223448,"global_rank":17395