 temperature, the wind speed, and the humidity. When you click on a city in the search history, Then you will be presented with current and future conditions for that city.","topics":[],"score":226085,"global_rank":175846},{"name":"sugoiJG/Products-of-Arrays-lab","owner":"sugoiJG","html_url":"https://github.com/sugoiJG/Products-of-Arrays-lab","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"Week 8 Lab 1","topics":[],"score":226084,"global_rank":175850},{"name":"DariaSidorko/Week-11-Day2-HW-water-on--the-shelf","owner":"DariaSidorko","html_url":"https://github.com/DariaSidorko/Week-11-Day2-HW-water-on--the-shelf","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":226084,"global_rank":175856},{"name":"Adan206/my-gat-blog","owner":"Adan206","html_url":"https://github.com/Adan206/my-gat-blog","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":226084,"global_rank":175858},{"name":"metalyx/ps-react-w8-lab","owner":"metalyx","html_url":"https://github.com/metalyx/ps-react-w8-lab","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":226084,"global_rank":175859}]