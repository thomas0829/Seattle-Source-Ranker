pository WHEN I am presented with the Contact section THEN I see a contact form with fields for a name, an email address, and a message WHEN I move my cursor out of one of the form fields without entering text THEN I receive a notification that this field is required WHEN I enter text into the email address field THEN I receive a notification if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":216419,"global_rank":233191},{"name":"taegorov/shopping-list","owner":"taegorov","html_url":"https://github.com/taegorov/shopping-list","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":216419,"global_rank":233193},{"name":"Teosoft7/jeju-weather","owner":"Teosoft7","html_url":"https://github.com/Teosoft7/jeju-weather","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":216419,"global_rank":233195},{"name":"bkhanal4351/data-structures-and-algorithms","owner":"bkhanal4351","html_url":"https://github.com/bkhanal4351/data-structures-and-algorithms","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"Practice with Data Structures and Algorithms","topics":[],"score":216419,"global_rank":233196},{"name":"yogesh-codes2024/Splash-Learn","owner":"yogesh-codes2024","html_url":"https://github.com/yogesh-codes2024/Splash-Learn","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"Splash Learn","topics":[],"score":216417,"global_rank":233212},{"name":"Kevinoh47/socketseyo","owner":"Kevinoh47","html_url":"https://github.com/Kevinoh47/socketseyo","stars":0,"fo