[{"name":"karmjeetnamol/Book-Search_Engine","owner":"karmjeetnamol","html_url":"https://github.com/karmjeetnamol/Book-Search_Engine","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":224072,"global_rank":155690},{"name":"karmjeetnamol/react_portfolio","owner":"karmjeetnamol","html_url":"https://github.com/karmjeetnamol/react_portfolio","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"This project was bootstrapped with Create React App.  Acceptance Criteria GIVEN a single-page application portfolio for a web developer WHEN I load the portfolio THEN I am presented with a page containing a header, a section for content, and a footer WHEN I view the header THEN I am presented with the developer's name and navigation with titles corresponding to different sections of the portfolio WHEN I view the navigation titles THEN I am presented with the titles About Me, Portfolio, Contact, and Resume, and the title corresponding to the current section is highlighted WHEN I click on a navigation title THEN I am presented with the corresponding section below the navigation without the page reloading and that title is highlighted WHEN I load the portfolio the first time THEN the About Me title and section are selected by default WHEN I am presented with the About Me section THEN I see a recent photo of the developer and a short bio about me WHEN I am presented with the Portfolio section THEN I see titled images of three of the developer\u2019s applications with links to both the deployed applications and the corresponding GitHub repository WHEN I am presented with the Contact section THEN I see a contact form with fields for a name, an email address, and a message WHEN I move my cursor out of one of the form fields without entering text THEN I receive a notification that this field is required WHEN I enter text into the email address field THEN I receive a notification if I have entered an invalid email address WHEN I view the footer THEN I am presented with text or icon links to the developer\u2019s GitHub and LinkedIn profiles.  In the project directory, you can run: npm start Runs the app in the development mode. Open http://localhost:3000 to view it in your browser.  The page will reload when you make changes. You may also see any lint errors in the console.","topics":[],"score":224072,"global_rank":155691},{"name":"PastaShock/express-note-taker","owner":"PastaShock","html_url":"https://github.com/PastaShock/express-note-taker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":224072,"global_rank":155692},{"name":"seattletimes/restaurant-delivery-listing","owner":"seattletimes","html_url":"https://github.com/seattletimes/restaurant-delivery-listing","stars":0,"forks":0,"watchers":13,"issues":14,"language":"JavaScript","description":null,"topics":[],"score":224071,"global_rank":155693},{"name":"jk0609/personalsite","owner":"jk0609","html_url":"https://github.com/jk0609/personalsite","stars":1,"forks":0,"watchers":1,"issues":25,"language":"JavaScript","description":null,"topics":[],"score":224069,"global_rank":155695},{"name":"nitin-22/Weather-Website","owner":"nitin-22","html_url":"https://github.com/nitin-22/Weather-Website","stars":0,"forks":0,"watchers":1,"issues":4,"language":"JavaScript","description":null,"topics":["api","css","express-js","git","heroku","html","http-server","javascript","node-js"],"score":224066,"global_rank":155697},{"name":"juleeb/password-generator","owner":"juleeb","html_url":"https://github.com/juleeb/password-generator","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":224066,"global_rank":155708},{"name":"dansirdan/another_rpg","owner":"dansirdan","html_url":"https://github.com/dansirdan/another_rpg","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"A React Application for fun a