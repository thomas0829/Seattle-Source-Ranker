[{"name":"mssrinivas/Slack-Clone","owner":"mssrinivas","html_url":"https://github.com/mssrinivas/Slack-Clone","stars":0,"forks":0,"watchers":0,"issues":16,"language":"JavaScript","description":"The developed aims to achieve the following objectives:  Development of a messaging application which allows users to post fast, durable messages to other users and groups.  Integration of the developed messaging application with a Buffer space (Kafka message Queue) that increases the durability of the stored messages in cases of complete memory consumption and network partition.  Integrating a durable messaging system which allows the separation of concerns between scaling and database (Database independent message queueing).  Kafka ensures message delivery at least once (Delivery guarantee). Message offsets that help consumers (The Backend Spring Boot Application here) track the point till which messages have been consumed from the Kafka queue.   Deployment of the messaging application with the Kafka broker to the cloud (AWS) where replicated instances are maintained which are served with Elastic Load Balancers to forward requests fairly. ","topics":[],"score":191982,"global_rank":340305},{"name":"anhduc130/simon-easytask","owner":"anhduc130","html_url":"https://github.com/anhduc130/simon-easytask","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":191982,"global_rank":340310},{"name":"rhoon/data-structures","owner":"rhoon","html_url":"https://github.com/rhoon/data-structures","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"MSDV Data Structures Assignments","topics":[],"score":191982,"global_rank":340312},{"name":"BlackFoxgamingstudio/Api-s","owner":"BlackFoxgamingstudio","html_url":"https://github.com/BlackFoxgamingstudio/Api-s","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"I want to learn how APi's work at an enterprise level. I want to use Azure