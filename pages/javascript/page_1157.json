ail addresses entered into the system conform with the pattern [username]@contoso.edu. Hint: Refer to the regex material in the Galloway book.   Use data attributes to insure that Gpa is expressed as a value in range from 0.7 and 4.0 inclusive.   The Students (Index) view should be sortable ascending and descending according to the LastName column or the GPA column. ","topics":[],"score":213351,"global_rank":256615},{"name":"StevenFleming/Pizza-Parlor-","owner":"StevenFleming","html_url":"https://github.com/StevenFleming/Pizza-Parlor-","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":213350,"global_rank":256621},{"name":"surryjm/coursera-hcj-module5-solution","owner":"surryjm","html_url":"https://github.com/surryjm/coursera-hcj-module5-solution","stars":0,"forks":0,"watchers":0,"issues":0,"language":"JavaScript","description":"Coursera HCJ Module 5 Solution","topics":[],"score":213350,"global_rank":256628},{"name":"RandyWeyer/simon-game","owner":"RandyWeyer","html_url":"https://github.com/RandyWeyer/simon-game","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":"Web version of Simon.","topics":[],"score":213347,"global_rank":256632},{"name":"RandyWeyer/ping-pong-2","owner":"RandyWeyer","html_url":"https://github.com/RandyWeyer/ping-pong-2","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":213347,"global_rank":256633},{"name":"KatherineHanson/log_front","owner":"KatherineHanson","html_url":"https://github.com/KatherineHanson/log_front","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":213347,"global_rank":256635},{"name":"KatherineHanson/log_back","owner":"KatherineHanson","html_url":"https://github.com/KatherineHanson/log_back","stars":0,"forks":0,"watchers":1,"issues":0,"language":"JavaScript","description":null,"topics":[],"score":213347,"global_rank":256636},{"nam