 learning.\"","topics":[],"score":219247,"global_rank":224176},{"name":"meghanmullally/third","owner":"meghanmullally","html_url":"https://github.com/meghanmullally/third","stars":0,"forks":0,"watchers":1,"issues":1,"language":"HTML","description":null,"topics":[],"score":219247,"global_rank":224181},{"name":"mason-lynass/bonnie-website","owner":"mason-lynass","html_url":"https://github.com/mason-lynass/bonnie-website","stars":0,"forks":0,"watchers":1,"issues":0,"language":"HTML","description":"bonnie's website","topics":[],"score":219247,"global_rank":224195},{"name":"JSilvas/web-ar-aframe","owner":"JSilvas","html_url":"https://github.com/JSilvas/web-ar-aframe","stars":0,"forks":0,"watchers":1,"issues":0,"language":"HTML","description":null,"topics":[],"score":219238,"global_rank":224223},{"name":"MrYanez/-IT115-final-project","owner":"MrYanez","html_url":"https://github.com/MrYanez/-IT115-final-project","stars":0,"forks":0,"watchers":1,"issues":2,"language":"HTML","description":null,"topics":[],"score":219238,"global_rank":224242},{"name":"Austin1serb/python_flask_template","owner":"Austin1serb","html_url":"https://github.com/Austin1serb/python_flask_template","stars":0,"forks":0,"watchers":1,"issues":0,"language":"HTML","description":null,"topics":[],"score":219238,"global_rank":224243},{"name":"MattMottle/first_jsx","owner":"MattMottle","html_url":"https://github.com/MattMottle/first_jsx","stars":0,"forks":0,"watchers":1,"issues":0,"language":"HTML","description":"JavaScript React, first JavaScript React project. Learning to render elements on the homepage.","topics":[],"score":219238,"global_rank":224253},{"name":"adnanm123/wirefame-exercise","owner":"adnanm123","html_url":"https://github.com/adnanm123/wirefame-exercise","stars":0,"forks":0,"watchers":1,"issues":0,"language":"HTML","description":null,"topics":[],"score":219238,"global_rank":224258},{"name":"LJR41/Core_gitHubBlocks","owner":"LJR41","html_url":"https://github.com/LJR41/Core_gitHubBlocks","stars":