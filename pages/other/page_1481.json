r conclusions can help guide future mutagenesis studies.","topics":[],"score":193528,"global_rank":329555},{"name":"mave89/InfoStorage_Project","owner":"mave89","html_url":"https://github.com/mave89/InfoStorage_Project","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"Some code for the InfoStorage class for F2016 semester. ","topics":[],"score":193526,"global_rank":329560},{"name":"nathanthorpe/scripts","owner":"nathanthorpe","html_url":"https://github.com/nathanthorpe/scripts","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":null,"topics":[],"score":193526,"global_rank":329566},{"name":"cwbriones/elm-hn","owner":"cwbriones","html_url":"https://github.com/cwbriones/elm-hn","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Elm","description":"Elm Hacker News Client","topics":[],"score":193526,"global_rank":329568},{"name":"giodamelio/clojure-tetris","owner":"giodamelio","html_url":"https://github.com/giodamelio/clojure-tetris","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Clojure","description":"A simple Clojure Tetris clone","topics":[],"score":193526,"global_rank":329570},{"name":"adason/coursera_cleandata","owner":"adason","html_url":"https://github.com/adason/coursera_cleandata","stars":0,"forks":1,"watchers":0,"issues":0,"language":"R","description":"UCI Human Activity Recognition","topics":[],"score":193520,"global_rank":329580},{"name":"trevmex/active-alfresco","owner":"trevmex","html_url":"https://github.com/trevmex/active-alfresco","stars":4,"forks":1,"watchers":1,"issues":0,"language":"Other","description":"A project to link Ruby on Rails and Alfresco together.","topics":[],"score":193519,"global_rank":329581},{"name":"gordonwatts/jenkinsNoExecutor","owner":"gordonwatts","html_url":"https://github.com/gordonwatts/jenkinsNoExecutor","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Groovy","description":"Builds a jenkins container with no executors","topics":[],"score":193518,"glo