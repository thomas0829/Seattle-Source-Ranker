[{"name":"ajhurliman/localStory","owner":"ajhurliman","html_url":"https://github.com/ajhurliman/localStory","stars":1,"forks":0,"watchers":2,"issues":0,"language":"Other","description":null,"topics":[],"score":1734.4,"global_rank":434955},{"name":"cpowell/cessna_177RG_cardinal_for_xplane","owner":"cpowell","html_url":"https://github.com/cpowell/cessna_177RG_cardinal_for_xplane","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Other","description":"The 177RG is an excellent training platform for FAR 61.31(e) complex aircraft: it has a controllable pitch prop, retractable gear, and flaps. Its big, 200HP fuel-injected engine will get you there fast, and it is fully IFR capable.  Sonny Lacey has made a really fantastic 1970 Cardinal 177B. His Cardinal flies wonderfully but, being an earlier variant of the plane, lacks the retractable gear and extra power of the later RG. Sonny graciously granted me permission to deviate from his non-modification license and to base my RG upon his B model. I deeply appreciate this and stress that credit for the foundation airframe and its modeling belong to Sonny; his is really well done. I encourage you to fly his plane as well.","topics":[],"score":1734.4,"global_rank":434956},{"name":"ntfrnzn/kibana-kubernetes-proxy","owner":"ntfrnzn","html_url":"https://github.com/ntfrnzn/kibana-kubernetes-proxy","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"kibana docker image for use behind a kubernetes api proxy","topics":[],"score":1734.4,"global_rank":434957},{"name":"imrvshah/Visualizing-Global-Terrorism","owner":"imrvshah","html_url":"https://github.com/imrvshah/Visualizing-Global-Terrorism","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1734.4,"global_rank":434958},{"name":"domain7/html-to-paginated-pdf","owner":"domain7","html_url":"https://github.com/domain7/html-to-paginated-pdf","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Other","desc