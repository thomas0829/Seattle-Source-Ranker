bal_rank":209065},{"name":"Jeffrey-S-Smith/c-input-program","owner":"Jeffrey-S-Smith","html_url":"https://github.com/Jeffrey-S-Smith/c-input-program","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":220584,"global_rank":209079},{"name":"Jeffrey-S-Smith/whoamiinc","owner":"Jeffrey-S-Smith","html_url":"https://github.com/Jeffrey-S-Smith/whoamiinc","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":220584,"global_rank":209080},{"name":"ghoule636/monkey_lang","owner":"ghoule636","html_url":"https://github.com/ghoule636/monkey_lang","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Go","description":null,"topics":[],"score":220584,"global_rank":209084},{"name":"thientran2020/kubernetes_learning","owner":"thientran2020","html_url":"https://github.com/thientran2020/kubernetes_learning","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Go","description":null,"topics":[],"score":220584,"global_rank":209085},{"name":"kishorekumarhanbar/DIFFERENT-APPLICATIONS-OF-SDN-USING-MININET","owner":"kishorekumarhanbar","html_url":"https://github.com/kishorekumarhanbar/DIFFERENT-APPLICATIONS-OF-SDN-USING-MININET","stars":3,"forks":3,"watchers":1,"issues":0,"language":"Other","description":"In traditional networks, the control and the data plane are combined in the network node. In this approach, once the flow management has been defined, the only way to make an adjustment to the policy is via reconfiguration of the devices. With increasing use of mobile devices, the scaling of networks as per changing traffic demands is restricted by this approach. Software Defined Networks (SDN) is a process where the control is moved out of the individual network nodes and into the separate centralized controller. The controller can hence, exploit complete knowledge of the network to optimize flow management and support user requirements. A custom network topology is created in our project and by using a centralized SDN controller, the network is controlled. After programming the network in tune with our application, packets are generated to test different applications that we developed on the SDN. This project demonstrates the different capabilities of SDN, by implementing 3 major network applications- SDN switch as a hub, SDN switch as a Firewall, and Selective Routing using SDN.","topics":[],"score":220582,"global_rank":209090},{"name":"Nathangineer/standard-homeware","owner":"Nathangineer","html_url":"https://github.com/Nathangineer/standard-homeware","stars":2,"forks":0,"watchers":1,"issues":2,"language":"Other","description":null,"topics":[],"score":220582,"global_rank":209091},{"name":"Krylon360/android_device_lge_v909","owner":"Krylon360","html_url":"https://github.com/Krylon360/android_device_lge_v909","stars":2,"forks":0,"watchers":2,"issues":0,"language":"Shell","description":"Device Tree for the LG G-Slate","topics":[],"score":220582,"global_rank":209092},{"name":"aubaugh/libldap-sys","owner":"aubaugh","html_url":"https://github.com/aubaugh/libldap-sys","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Rust","description":"FFI bindings to the OpenLDAP library","topics":[],"score":220578,"global_rank":209103},{"name":"ahrav/go-locks","owner":"ahrav","html_url":"https://github.com/ahrav/go-locks","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Go","description":null,"topics":[],"score":220578,"global_rank":209104},{"name":"luan/factory-palette-calculator","owner":"luan","html_url":"https://github.com/luan/factory-palette-calculator","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Lua","description":null,"topics":[],"score":220578,"global_rank":209112},{"name":"accelbread/game","owner":"accelbread","html_url":"https://github.com/accelbread/game","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Zig","description":"Quick game built with wasm4 and zig","topics":[],"score":220578,"global_rank":209119},{"name":"U007D/evos","