[{"name":"sigsegved/CCN-Simulator","owner":"sigsegved","html_url":"https://github.com/sigsegved/CCN-Simulator","stars":1,"forks":1,"watchers":3,"issues":0,"language":"Other","description":"The simulation system contains two processes. The packet process, which will simulate the complete experience of a packet. The packet process is the complete lifecycle of any packet starting from the node its born to reaching the destination node. The packet process will be able to simulate both interest and data packet experience. It can clone, time out and route itself to destination.   The other process in the system would be the generator process, which wakes up after a particular time and generates a random interest packet. The Generator process will assign a random node as the birth node and an object ID that belongs to another node. Generator process then activates this packet and puts itself to sleep for a random time. ","topics":[],"score":181806,"global_rank":406492},{"name":"harshal-pandya/redisutils","owner":"harshal-pandya","html_url":"https://github.com/harshal-pandya/redisutils","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":"Random Redis utils in scala","topics":[],"score":181805,"global_rank":406497},{"name":"crosenth/resume","owner":"crosenth","html_url":"https://github.com/crosenth/resume","stars":0,"forks":0,"watchers":1,"issues":0,"language":"TeX","description":"My r\u00e9sum\u00e9","topics":["resume","resumes"],"score":181805,"global_rank":406498},{"name":"danielgtaylor/userbadges-node","owner":"danielgtaylor","html_url":"https://github.com/danielgtaylor/userbadges-node","stars":0,"forks":0,"watchers":1,"issues":0,"language":"CoffeeScript","description":"UserBadges.com Javascript API client for Node.js","topics":[],"score":181805,"global_rank":406499},{"name":"dawitz28/aws-event-cap","owner":"dawitz28","html_url":"https://github.com/dawitz28/aws-event-cap","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","descriptio