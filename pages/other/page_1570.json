"html_url":"https://github.com/maringantis/TCP-Socket-data-transfer-no-limit","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"TCP socket program with no limit data transfer from client to server.No FILES operations were used.","topics":[],"score":190938,"global_rank":350069},{"name":"tacoapp/privacy-policy","owner":"tacoapp","html_url":"https://github.com/tacoapp/privacy-policy","stars":3,"forks":0,"watchers":3,"issues":1,"language":"Other","description":null,"topics":[],"score":190936,"global_rank":350072},{"name":"aschokking/aschokking","owner":"aschokking","html_url":"https://github.com/aschokking/aschokking","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":190935,"global_rank":350073},{"name":"upbound/tt-just-a-config","owner":"upbound","html_url":"https://github.com/upbound/tt-just-a-config","stars":0,"forks":2,"watchers":0,"issues":0,"language":"Other","description":null,"topics":[],"score":190934,"global_rank":350074}]