rl":"https://github.com/Seon2020/reading-notes","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Code Fellows Reading Notes","topics":[],"score":180874,"global_rank":402512},{"name":"chiarng/extint_jenkins_demo","owner":"chiarng","html_url":"https://github.com/chiarng/extint_jenkins_demo","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"App for demoing Jenkins Plugin for ServiceNow CI/CD","topics":[],"score":180874,"global_rank":402513},{"name":"sfkunal/DataPrivacy_RESEARCH","owner":"sfkunal","html_url":"https://github.com/sfkunal/DataPrivacy_RESEARCH","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"The world of technology is changing. It used to be one where users could post on social media, order clothes online, and play mobile games without a care in the world. As time progressed, companies eventually realized that they could collect small pieces of information from a user\u2019s technological habits, and use that to form a profile of the user of some sort. I used a packet-monitoring service to listen in on third-party applications and wrote a script to filter out relevant pieces of data that were being sent back to an application\u2019s server. The findings of this study concluded that third-party iOS applications have unmonitored power to access pieces of information like contacts, location, and emails.","topics":[],"score":180874,"global_rank":402514},{"name":"davidklett/katacoda-scenarios","owner":"davidklett","html_url":"https://github.com/davidklett/katacoda-scenarios","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Katacoda Scenarios","topics":[],"score":180874,"global_rank":402515},{"name":"dblitt/ShulkerStore","owner":"dblitt","html_url":"https://github.com/dblitt/ShulkerStore","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":180874,"global_rank":402516},{"name":"erinsteiner-NOAA/fisher