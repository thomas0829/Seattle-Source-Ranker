g the files. The cache web proxy server fetches the files from the main server until its buffer runs out. The server then deletes the files to make space for the new files.","topics":[],"score":196959,"global_rank":316223},{"name":"polashrp/designer_maker","owner":"polashrp","html_url":"https://github.com/polashrp/designer_maker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":196959,"global_rank":316235},{"name":"thipokch/INFO449-iOS-DomainModel","owner":"thipokch","html_url":"https://github.com/thipokch/INFO449-iOS-DomainModel","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":196959,"global_rank":316238},{"name":"Jtfinlay/time-tracker-mobile","owner":"Jtfinlay","html_url":"https://github.com/Jtfinlay/time-tracker-mobile","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Dart","description":null,"topics":[],"score":196959,"global_rank":316243},{"name":"navicore/spark-structured-streaming-on-azure.g8","owner":"navicore","html_url":"https://github.com/navicore/spark-structured-streaming-on-azure.g8","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":"starter kit for spark structured streaming with support for various azure integrations","topics":[],"score":196959,"global_rank":316252},{"name":"vyapham/cmps101pa2","owner":"vyapham","html_url":"https://github.com/vyapham/cmps101pa2","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Doubly Linked List + Insertion sort in C","topics":[],"score":196959,"global_rank":316254},{"name":"Jacobinski/Code-Golf","owner":"Jacobinski","html_url":"https://github.com/Jacobinski/Code-Golf","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"\u26f3 A repository for Code Golf Practice","topics":[],"score":196959,"global_rank":316258},{"name":"Derekisinternet/akasha","owner":"Derekisinternet","html_url":"https://github.com/Derekisinternet/akasha","stars":0,"