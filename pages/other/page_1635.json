[{"name":"phansieeex3/problem3","owner":"phansieeex3","html_url":"https://github.com/phansieeex3/problem3","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C","description":null,"topics":[],"score":1881,"global_rank":363863},{"name":"aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","owner":"aarivan","html_url":"https://github.com/aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","stars":0,"forks":0,"watchers":0,"issues":0,"language":"R","description":"Overview Identifying the strategy employed by business firms has motivated empirical research towards studying a firm\u2019s behavior. If there exists a specific pattern that can describe the interactions between the manufacturers and retailers, the application of causality analysis on their pricing interaction can clarify their strategic behavior. The interactions between the manufacturer and retailer can be discussed to follow a verticalintegrated system or Stackelberg leadership bilateral-monopoly model. In a vertical-integrated system, the manufacturer and retailer cooperate to maximize the profit of the distribution channel instead of individual profit. The important character of this model is that both the manufacturer and retailer affect the sales of the product.","topics":[],"score":1881,"global_rank":363880},{"name":"bryanpleblanc/dev","owner":"bryanpleblanc","html_url":"https://github.com/bryanpleblanc/dev","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Shell","description":"Developer Environment","topics":[],"score":1881,"global_rank":363885},{"name":"gilbertosg/feria-ingenieria","owner":"gilbertosg","html_url":"https://github.com/gilbertosg/feria-ingenieria","stars":0,"forks":0,"watchers":0,"issues":0,"language":"PHP","description":"Web system to upload projects and votations for Tecnologico de Monterrey Campus Santa Fe (Laravel) ","topics":[],"score":1881,"global_rank":363886},{"name":"mvrk/msreport","owner":"mvrk","html_url":"https://github.com/mv