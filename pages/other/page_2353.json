[{"name":"daniellmb/ama","owner":"daniellmb","html_url":"https://github.com/daniellmb/ama","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Ask me anything!","topics":[],"score":153224,"global_rank":432685},{"name":"dev-vishalgaurav/FttLawTester","owner":"dev-vishalgaurav","html_url":"https://github.com/dev-vishalgaurav/FttLawTester","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Fitts\u2019 Law predicts movement-time as a function of distance (to the center of the target) and required accuracy (the size of the target). It can be described using the following formula.  MT = a + b \u00d7 ID;  ID = log2(2A/W)  Where MT is task completion time, ID is the index of difficulty, A (amplitude) is the distance to the center of the target and W (width) is the width of the (square) target. This program will help us to collect data so that we can calculate the coefficients a and b in the future.  ","topics":[],"score":153218,"global_rank":432686},{"name":"tiodan81/partnerAccount","owner":"tiodan81","html_url":"https://github.com/tiodan81/partnerAccount","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":153218,"global_rank":432687},{"name":"laurens914/iOSWeek3","owner":"laurens914","html_url":"https://github.com/laurens914/iOSWeek3","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":153218,"global_rank":432688},{"name":"YangMann/MelissaUpdateAssitant","owner":"YangMann","html_url":"https://github.com/YangMann/MelissaUpdateAssitant","stars":0,"forks":1,"watchers":0,"issues":0,"language":"Other","description":"Update assistant","topics":[],"score":153213,"global_rank":432689},{"name":"sbeckeriv/vimconfigs","owner":"sbeckeriv","html_url":"https://github.com/sbeckeriv/vimconfigs","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":153210,"global_rank":432690},{"name":"jason