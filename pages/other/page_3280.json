ar. There are two years of data (1997 and 1998), and just under 40,000 children who are surveyed in each year.","topics":[],"score":1891,"global_rank":374382},{"name":"sbobrowicz/Arty-S7-50-XADC","owner":"sbobrowicz","html_url":"https://github.com/sbobrowicz/Arty-S7-50-XADC","stars":0,"forks":0,"issues":0,"language":"Tcl","description":null,"topics":[],"score":1891,"global_rank":374392},{"name":"j-rewerts/test-repo","owner":"j-rewerts","html_url":"https://github.com/j-rewerts/test-repo","stars":0,"forks":0,"issues":1,"language":null,"description":null,"topics":[],"score":1891,"global_rank":374395},{"name":"tstapler/JavaJam_Coffee_House","owner":"tstapler","html_url":"https://github.com/tstapler/JavaJam_Coffee_House","stars":0,"forks":0,"issues":0,"language":"HTML","description":null,"topics":[],"score":1891,"global_rank":374396},{"name":"annestarley/Anne-Starley-ADA-Application","owner":"annestarley","html_url":"https://github.com/annestarley/Anne-Starley-ADA-Application","stars":0,"forks":0,"issues":0,"language":null,"description":null,"topics":[],"score":1891,"global_rank":374398},{"name":"annestarley/HTML-CSS-Project-2","owner":"annestarley","html_url":"https://github.com/annestarley/HTML-CSS-Project-2","stars":0,"forks":0,"issues":0,"language":"HTML","description":"Galvanize's HTML/CSS Unit 11: Project 2","topics":[],"score":1891,"global_rank":374399},{"name":"annestarley/Bootstraps-intro-assignment-2","owner":"annestarley","html_url":"https://github.com/annestarley/Bootstraps-intro-assignment-2","stars":0,"forks":0,"issues":0,"language":"HTML","description":"Galvanize intro to CSS/HTML: Unit 10 - Lesson 4","topics":[],"score":1891,"global_rank":374400},{"name":"1gb/fallingrocks","owner":"1gb","html_url":"https://github.com/1gb/fallingrocks","stars":0,"forks":0,"issues":0,"language":"HTML","description":"Caution: Falling Rocks; a webVR experience","topics":[],"score":1891,"global_rank":374410},{"name":"dkim616/linux-server-config","owner":"dkim616","html_url":"h