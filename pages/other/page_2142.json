[{"name":"cpowell/cessna_177RG_cardinal_for_xplane","owner":"cpowell","html_url":"https://github.com/cpowell/cessna_177RG_cardinal_for_xplane","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Other","description":"The 177RG is an excellent training platform for FAR 61.31(e) complex aircraft: it has a controllable pitch prop, retractable gear, and flaps. Its big, 200HP fuel-injected engine will get you there fast, and it is fully IFR capable.  Sonny Lacey has made a really fantastic 1970 Cardinal 177B. His Cardinal flies wonderfully but, being an earlier variant of the plane, lacks the retractable gear and extra power of the later RG. Sonny graciously granted me permission to deviate from his non-modification license and to base my RG upon his B model. I deeply appreciate this and stress that credit for the foundation airframe and its modeling belong to Sonny; his is really well done. I encourage you to fly his plane as well.","topics":[],"score":173426,"global_rank":417012},{"name":"lindzmm/hello-world","owner":"lindzmm","html_url":"https://github.com/lindzmm/hello-world","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Hello world!","topics":[],"score":173426,"global_rank":417013},{"name":"teraliv/settings-repository","owner":"teraliv","html_url":"https://github.com/teraliv/settings-repository","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Sharing settings between installations of IntelliJ Platform based products","topics":[],"score":173426,"global_rank":417014},{"name":"MCasari-PMEL/First-Repo","owner":"MCasari-PMEL","html_url":"https://github.com/MCasari-PMEL/First-Repo","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"This is my first attempt at creating a new repository.","topics":[],"score":173426,"global_rank":417015},{"name":"mjuric/mpsky.org","owner":"mjuric","html_url":"https://github.com/mjuric/mpsky.org","stars":0,"forks":0,"watchers":0,"issues":1,"language":