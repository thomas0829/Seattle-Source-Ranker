n all these things go into foo/) a file index.html containing, for each photo: a properly oriented thumbnail a caption a link from the thumbnail to a properly oriented medium-size version of the photo the thumbnails and medium-size versions.","topics":[],"score":191735,"global_rank":349115},{"name":"avagin/trivial_vpn","owner":"avagin","html_url":"https://github.com/avagin/trivial_vpn","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":191735,"global_rank":349120},{"name":"mbrubeck/cargotest","owner":"mbrubeck","html_url":"https://github.com/mbrubeck/cargotest","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Rust","description":null,"topics":[],"score":191727,"global_rank":349121},{"name":"lowellbander/ethics","owner":"lowellbander","html_url":"https://github.com/lowellbander/ethics","stars":0,"forks":0,"watchers":1,"issues":0,"language":"TeX","description":null,"topics":[],"score":191727,"global_rank":349127},{"name":"wormeyman/EatingRichlyYouTubeEmbed","owner":"wormeyman","html_url":"https://github.com/wormeyman/EatingRichlyYouTubeEmbed","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"Simple Responsive YouTube Embed","topics":[],"score":191727,"global_rank":349137},{"name":"hmorzaria/Atlantis_tuning","owner":"hmorzaria","html_url":"https://github.com/hmorzaria/Atlantis_tuning","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":"Plot code for Atlantis tuning","topics":[],"score":191727,"global_rank":349138},{"name":"sup/cs-hw-template","owner":"sup","html_url":"https://github.com/sup/cs-hw-template","stars":0,"forks":0,"watchers":1,"issues":0,"language":"TeX","description":":page_facing_up: Templates for homework, project design docs, and more for Cornell CS classes. ","topics":[],"score":191727,"global_rank":349143},{"name":"lindison/minecraft","owner":"lindison","html_url":"https://github.com/lindison/minecraft","stars":0,"forks":0,"watchers":1,"issues":0,"lan