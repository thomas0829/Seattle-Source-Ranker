[{"name":"shivakumar121/Molecular_Activity_Prediction","owner":"shivakumar121","html_url":"https://github.com/shivakumar121/Molecular_Activity_Prediction","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"The R interface to Keras provided by RStudio, along with TensorFlow backend, is used to predict biological activity of molecules. Numerical descriptors of the molecule's chemical structure are used as features for the prediction. The data came from an old Kaggle competition. The predictions obtained here are comparable to the top finishers in the original competition. Test data used to evaluate this model, however, is not the same as the one used in the original competition. Additionally, in the original competition models were trained and tested on over 15 different molecular activities. The model here is trained and tested on only one molecular activity. But, the method used here is generally applicable to other molecular activities too.","topics":[],"score":149746,"global_rank":452202},{"name":"Epicodus-MT/readme-project-base","owner":"Epicodus-MT","html_url":"https://github.com/Epicodus-MT/readme-project-base","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":null,"topics":[],"score":149746,"global_rank":452203},{"name":"lowerkey/cookbook","owner":"lowerkey","html_url":"https://github.com/lowerkey/cookbook","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"delicately delicious delicacies","topics":[],"score":149742,"global_rank":452204},{"name":"k45514n/j5-apa102-plugin","owner":"k45514n","html_url":"https://github.com/k45514n/j5-apa102-plugin","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"APA102 plugin for Johnny-Five","topics":[],"score":149740,"global_rank":452205},{"name":"coauxe/code_runner","owner":"coauxe","html_url":"https://github.com/coauxe/code_runner","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"top