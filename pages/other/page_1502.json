opics":[],"score":193470,"global_rank":337519},{"name":"dylanfisher/dot_files","owner":"dylanfisher","html_url":"https://github.com/dylanfisher/dot_files","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"Inspired by jbarnette. All my config files and templates. Misc this and that.","topics":[],"score":193468,"global_rank":337533},{"name":"IzaakPrats/Uber4Snakz","owner":"IzaakPrats","html_url":"https://github.com/IzaakPrats/Uber4Snakz","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":193468,"global_rank":337546},{"name":"TransientObject/RelayTerminalLocalization","owner":"TransientObject","html_url":"https://github.com/TransientObject/RelayTerminalLocalization","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Tcl","description":null,"topics":[],"score":193468,"global_rank":337560},{"name":"harisethuram/Bayesian-Nets-Research","owner":"harisethuram","html_url":"https://github.com/harisethuram/Bayesian-Nets-Research","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":193465,"global_rank":337568},{"name":"raphg/HIPC-papers","owner":"raphg","html_url":"https://github.com/raphg/HIPC-papers","stars":2,"forks":1,"watchers":3,"issues":0,"language":"Other","description":"HIPC review papers","topics":[],"score":193463,"global_rank":337569},{"name":"EmeraldCityIT/Double-Latch-buffer-Gates-in-series-in-a-coil-used-to-transfer-buffer-of-physical-material","owner":"EmeraldCityIT","html_url":"https://github.com/EmeraldCityIT/Double-Latch-buffer-Gates-in-series-in-a-coil-used-to-transfer-buffer-of-physical-material","stars":0,"forks":2,"watchers":0,"issues":0,"language":"Other","description":"Material within a conductive coil can be entered into a buffer by creating a double latch gate by manipulating the coil. Creating two double latch gates in a series will allow transfer of physical matter from the first buffer to the second buffer. Large coils can be built like tunnels or delivery tubes to feed physical objects from one side, and retrieve physical objects from the opposite side. In physics and chemistry, it is known that a physical change to a substance does not create a chemical change. Creating a physical break in a crystal lattice structure will leave chemical bonds between both parts. Physical breakage of a conductive metal such as aluminum will leave two parts which have been physically broken but retain all chemical bonds between both parts which existed before the structure was broken. In a conductive lattice structure, electrons and signals will continue to transfer between fragments. A coil with two double latch gates in series, which is physically broken between the series, will retain the ability to transfer buffers between the series. The first buffer is transfered via chemical signalling between the two segments. One end of the severed coil can be shipped to remote locations to deliver personell, deliverables, fuel, electricity, etc. The remote transfer gates work as escape hatches on submarines, aircraft, space missions, etc. Power from wind and hydro can be transferred to vessels and batteries to replace nuclear power, tritium, and Pycnogonida.","topics":[],"score":193463,"global_rank":337570},{"name":"xgbn/storm-puppet","owner":"xgbn","html_url":"https://github.com/xgbn/storm-puppet","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Puppet","description":null,"topics":[],"score":193460,"global_rank":337575},{"name":"dylanmei/sysdig-haproxy-syslog","owner":"dylanmei","html_url":"https://github.com/dylanmei/sysdig-haproxy-syslog","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Lua","description":"A Sysdig chisel to tail HAProxy logs","topics":[],"score":193460,"global_rank":337577},{"name":"jeff-eng/Whack-A-Penguin","owner":"jeff-eng","html_url":"https://github.com/jeff-eng/Whack-A-Penguin","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":"Repo fo