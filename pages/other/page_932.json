s":[],"score":220228,"global_rank":198594},{"name":"marcdel/godot-companion-demo","owner":"marcdel","html_url":"https://github.com/marcdel/godot-companion-demo","stars":0,"forks":0,"watchers":0,"issues":0,"language":"GDScript","description":null,"topics":[],"score":220226,"global_rank":198596},{"name":"trister/GBM-POSTN","owner":"trister","html_url":"https://github.com/trister/GBM-POSTN","stars":1,"forks":1,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":220224,"global_rank":198599},{"name":"scwood/goals-tab-svelte","owner":"scwood","html_url":"https://github.com/scwood/goals-tab-svelte","stars":0,"forks":0,"watchers":1,"issues":2,"language":"Svelte","description":null,"topics":[],"score":220223,"global_rank":198602},{"name":"davidpluseipi/codesandbox-template-nuxt","owner":"davidpluseipi","html_url":"https://github.com/davidpluseipi/codesandbox-template-nuxt","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Vue","description":"NuxtJS template for CodeSandbox Projects","topics":[],"score":220223,"global_rank":198609},{"name":"iAmAndrewCarroll/AndrewsPortfolio","owner":"iAmAndrewCarroll","html_url":"https://github.com/iAmAndrewCarroll/AndrewsPortfolio","stars":0,"forks":0,"watchers":1,"issues":0,"language":"SCSS","description":null,"topics":[],"score":220223,"global_rank":198614},{"name":"masonJamesWheeler/personal-site","owner":"masonJamesWheeler","html_url":"https://github.com/masonJamesWheeler/personal-site","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Svelte","description":"My own Personal Site","topics":[],"score":220223,"global_rank":198616},{"name":"logos-electromechanical/Arachnio","owner":"logos-electromechanical","html_url":"https://github.com/logos-electromechanical/Arachnio","stars":1,"forks":0,"watchers":3,"issues":0,"language":"C","description":"An Arduino Micro variant with integrated WiFi","topics":[],"score":220222,"global_rank":198633},{"name":"kishorekumarhanbar/DIFFERENT-APPLICATIONS-OF-SDN-USING-MININET","owner":"kishorekumarhanbar","html_url":"https://github.com/kishorekumarhanbar/DIFFERENT-APPLICATIONS-OF-SDN-USING-MININET","stars":3,"forks":3,"watchers":1,"issues":0,"language":"Other","description":"In traditional networks, the control and the data plane are combined in the network node. In this approach, once the flow management has been defined, the only way to make an adjustment to the policy is via reconfiguration of the devices. With increasing use of mobile devices, the scaling of networks as per changing traffic demands is restricted by this approach. Software Defined Networks (SDN) is a process where the control is moved out of the individual network nodes and into the separate centralized controller. The controller can hence, exploit complete knowledge of the network to optimize flow management and support user requirements. A custom network topology is created in our project and by using a centralized SDN controller, the network is controlled. After programming the network in tune with our application, packets are generated to test different applications that we developed on the SDN. This project demonstrates the different capabilities of SDN, by implementing 3 major network applications- SDN switch as a hub, SDN switch as a Firewall, and Selective Routing using SDN.","topics":[],"score":220221,"global_rank":198634},{"name":"you-leee/funcprog-scala2","owner":"you-leee","html_url":"https://github.com/you-leee/funcprog-scala2","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":null,"topics":[],"score":220220,"global_rank":198637},{"name":"topfunky/exercism-projects","owner":"topfunky","html_url":"https://github.com/topfunky/exercism-projects","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Go","description":"My personal exercises on exercism.io for learning new languages","topics":[],"score":220220,"global_rank":198639},{"name":"bpowers/go-tmux","owner":"bpowers","html_url":"https://github.com/bpowers/go-tmux","star