[{"name":"ashishakonnur/Kickstarter-Project---Tableau-KNIME-Workflow","owner":"ashishakonnur","html_url":"https://github.com/ashishakonnur/Kickstarter-Project---Tableau-KNIME-Workflow","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"With this Kickstarter project, our group is trying to build a more nuanced predictive model on what crowdfunding campaigns may succeed, and to what degree they will succeed. Since Kickstarter only makes money once a project has passed its goal \u2013 and has been deemed a success \u2013 it is already in their best interests to only have successful campaigns. But if there were a way to determine which campaigns would be extremely successful \u2013 and could theoretically be even more successful with the right publicity on their end \u2013 Kickstarter would find this information extremely valuable. We could also provide a service to a prospective user of a crowdfunding campaign, on ways that they can optimize their campaign itself to give themselves the best chance of being successful.","topics":[],"score":180327,"global_rank":404601},{"name":"mi4l/Zero","owner":"mi4l","html_url":"https://github.com/mi4l/Zero","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"TODO app for desktop/mobile","topics":[],"score":180327,"global_rank":404602},{"name":"ShreyansPatell/ShreyansPatell","owner":"ShreyansPatell","html_url":"https://github.com/ShreyansPatell/ShreyansPatell","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Config files for my GitHub profile.","topics":["config","github-config"],"score":180327,"global_rank":404603},{"name":"joviegas/test-aws-sdk-v1","owner":"joviegas","html_url":"https://github.com/joviegas/test-aws-sdk-v1","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":180327,"global_rank":404604},{"name":"burcu-erkan/hover-time","owner":"burcu-erkan","html_url":"https://github.com/burcu-erkan/hove