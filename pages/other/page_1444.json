"score":196072,"global_rank":321472},{"name":"maringantis/Proxy-Cache-Server","owner":"maringantis","html_url":"https://github.com/maringantis/Proxy-Cache-Server","stars":0,"forks":0,"watchers":2,"issues":0,"language":"C","description":"Cache web proxy server is an intermediate server between the client and the main server. The proxy server is used to reduce the bandwidth, latency and the server load. The cache web proxy server caches the client\u2019s requests to the server. Each client request goes through the proxy server. The cache web proxy server responds to the client with the requested information if the files exist. If the cache web proxy doesn\u2019t host the requested information, it talks to the server and fetches the requested information. The subsequent requests to that file will be handled by the cache web proxy server instead of the main server hosting the files. The cache web proxy server fetches the files from the main server until its buffer runs out. The server then deletes the files to make space for the new files.","topics":[],"score":196072,"global_rank":321477},{"name":"Derekisinternet/akasha","owner":"Derekisinternet","html_url":"https://github.com/Derekisinternet/akasha","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Groovy","description":"An Ansible repo","topics":[],"score":196072,"global_rank":321483},{"name":"polashrp/designer_maker","owner":"polashrp","html_url":"https://github.com/polashrp/designer_maker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":196072,"global_rank":321484},{"name":"navicore/spark-structured-streaming-on-azure.g8","owner":"navicore","html_url":"https://github.com/navicore/spark-structured-streaming-on-azure.g8","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":"starter kit for spark structured streaming with support for various azure integrations","topics":[],"score":196072,"global_rank":321487},{"name":"iambmelt/Traffic-Pol