[{"name":"RheaMimiCarillo/template-group-project","owner":"RheaMimiCarillo","html_url":"https://github.com/RheaMimiCarillo/template-group-project","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"Includes team agreement, etc","topics":[],"score":192104,"global_rank":346633},{"name":"kuya32/reading-notes-201","owner":"kuya32","html_url":"https://github.com/kuya32/reading-notes-201","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Other","description":"Lecture/Reading notes for 201","topics":[],"score":192104,"global_rank":346634},{"name":"maringantis/UDP-Socket-Throughput","owner":"maringantis","html_url":"https://github.com/maringantis/UDP-Socket-Throughput","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"The server should take 3 command line arguments: the port number from which it reads requests, the message size in bytes, and the sleep time in milliseconds. The server will read a message of the specified size from a client. After that, it will sleep for the specified amount of time (to simulate injected network latency) and then send an acknowledgment for the received message back to the client. Each client message will have a unique sequence number, which is included in the ack sent by the server. The server repeats this for 30 messages and then exit. The client will take 3 command line arguments: the IP address (or the host name) and port number of the server, and the message size in bytes. The client will write a message of the specified size to the server and wait for the ack from the server. The client will repeat this 30 times and keep track of the total amount of time spent on sending all the messages and receiving all the acks. It computes the throughput by: 30 * message_size_in_bytes / total_time_in_seconds and print the throughput value. After that, the client should exit.","topics":[],"score":192097,"global_rank":346639},{"name":"maringantis/TCP-Socket-data-transfer-no-limit","owner":"maringantis","html_url":"https://github.com/maringantis/TCP-Socket-data-transfer-no-limit","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"TCP socket program with no limit data transfer from client to server.No FILES operations were used.","topics":[],"score":192097,"global_rank":346640},{"name":"cbessee/WP-Recipes","owner":"cbessee","html_url":"https://github.com/cbessee/WP-Recipes","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"A simple wordpress plugin for creating custom recipe post types. Recipes are displayed according to the Schema.org/Recipe model.","topics":[],"score":192097,"global_rank":346655},{"name":"mitchthompson/mitchell-thompson-portfolio","owner":"mitchthompson","html_url":"https://github.com/mitchthompson/mitchell-thompson-portfolio","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Hack","description":null,"topics":[],"score":192097,"global_rank":346657},{"name":"Talljoe/oh-my-zsh-plugin","owner":"Talljoe","html_url":"https://github.com/Talljoe/oh-my-zsh-plugin","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"Plugin for Oh My ZSH, mainly for personal use","topics":[],"score":192097,"global_rank":346671},{"name":"pfrcks/MovieQuotePlugin","owner":"pfrcks","html_url":"https://github.com/pfrcks/MovieQuotePlugin","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":null,"topics":[],"score":192097,"global_rank":346679},{"name":"muditmittal/Facebook-Photo-Gallery","owner":"muditmittal","html_url":"https://github.com/muditmittal/Facebook-Photo-Gallery","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Swift","description":"Week 5 Assignment","topics":[],"score":192097,"global_rank":346681},{"name":"littlebee/react-focus-trap-amd","owner":"littlebee","html_url":"https://github.com/littlebee/react-focus-trap-amd","stars":0,"forks":0,"watchers":1,"issues":0,"language":"CoffeeScript","description":"A webpack packaging of react-focus-trap that is