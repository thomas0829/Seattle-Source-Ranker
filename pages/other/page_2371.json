rav/FttLawTester","owner":"dev-vishalgaurav","html_url":"https://github.com/dev-vishalgaurav/FttLawTester","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Fitts\u2019 Law predicts movement-time as a function of distance (to the center of the target) and required accuracy (the size of the target). It can be described using the following formula.  MT = a + b \u00d7 ID;  ID = log2(2A/W)  Where MT is task completion time, ID is the index of difficulty, A (amplitude) is the distance to the center of the target and W (width) is the width of the (square) target. This program will help us to collect data so that we can calculate the coefficients a and b in the future.  ","topics":[],"score":152987,"global_rank":436710},{"name":"jasonmfehr/financial_manager","owner":"jasonmfehr","html_url":"https://github.com/jasonmfehr/financial_manager","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":152981,"global_rank":436711},{"name":"sbeckeriv/vimconfigs","owner":"sbeckeriv","html_url":"https://github.com/sbeckeriv/vimconfigs","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":152981,"global_rank":436712},{"name":"eywalker/test_travis","owner":"eywalker","html_url":"https://github.com/eywalker/test_travis","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Repository to test Travis CI","topics":[],"score":152974,"global_rank":436713},{"name":"gwander/Java","owner":"gwander","html_url":"https://github.com/gwander/Java","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":152974,"global_rank":436714},{"name":"d4l3k/predictive-personal-model","owner":"d4l3k","html_url":"https://github.com/d4l3k/predictive-personal-model","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":152968,"global_rank":436715},{"name":"GKouhia/week4","owner":