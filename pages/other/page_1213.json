tal elongates the path of an electron. Time is literally dialated for an electron within this path. An electron could travel for 1 hour in a crystal and from the outside of the crystal we would see it only 1 second after pressing a switch.","topics":[],"score":210886,"global_rank":269956},{"name":"ericarmstr0ng/Climate-Find","owner":"ericarmstr0ng","html_url":"https://github.com/ericarmstr0ng/Climate-Find","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Go","description":"App to help track users progress in the fight against climate change","topics":[],"score":210886,"global_rank":269960},{"name":"Corvids/tictactoe-rust","owner":"Corvids","html_url":"https://github.com/Corvids/tictactoe-rust","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Rust","description":null,"topics":[],"score":210886,"global_rank":269962},{"name":"JenniferPiper/wptest2","owner":"JenniferPiper","html_url":"https://github.com/JenniferPiper/wptest2","stars":0,"forks":0,"watchers":0,"issues":0,"language":"PHP","description":null,"topics":[],"score":210886,"global_rank":269980},{"name":"JenniferPiper/wp-plugin-dev","owner":"JenniferPiper","html_url":"https://github.com/JenniferPiper/wp-plugin-dev","stars":0,"forks":0,"watchers":0,"issues":0,"language":"PHP","description":null,"topics":[],"score":210886,"global_rank":269981},{"name":"jonathanRinciari/ModuleExample","owner":"jonathanRinciari","html_url":"https://github.com/jonathanRinciari/ModuleExample","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Objective-C","description":"Example of React Native Module","topics":[],"score":210886,"global_rank":269982},{"name":"doct15/jobtest1","owner":"doct15","html_url":"https://github.com/doct15/jobtest1","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Dockerfile","description":null,"topics":[],"score":210886,"global_rank":269991},{"name":"khrisnakamarga/music-genre-classification","owner":"khrisnakamarga","html_url":"https://github.com/khrisnakamarga/music-genre-classificati