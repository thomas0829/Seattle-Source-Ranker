 the product.","topics":[],"score":185359,"global_rank":407880},{"name":"philnguyen/loop-cfa","owner":"philnguyen","html_url":"https://github.com/philnguyen/loop-cfa","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Racket","description":"Small model of static analysis that's only confused between different iterations of a loop","topics":[],"score":185359,"global_rank":407889},{"name":"chuanisawesome/Pebble-Simple-Watchface","owner":"chuanisawesome","html_url":"https://github.com/chuanisawesome/Pebble-Simple-Watchface","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C","description":"A simple watchface for Pebble :)","topics":[],"score":185359,"global_rank":407890},{"name":"alm0st907/go-playground","owner":"alm0st907","html_url":"https://github.com/alm0st907/go-playground","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"sandbox for any go code I want to mess with ","topics":[],"score":185355,"global_rank":407891},{"name":"alm0st907/typescript-playground","owner":"alm0st907","html_url":"https://github.com/alm0st907/typescript-playground","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Repo to play around with anything in typescript, react, node, etc","topics":[],"score":185355,"global_rank":407892},{"name":"alm0st907/rust-playground","owner":"alm0st907","html_url":"https://github.com/alm0st907/rust-playground","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Playground to learn rust, play around with things.","topics":[],"score":185355,"global_rank":407893},{"name":"pranav6226/mentalhealth_acc","owner":"pranav6226","html_url":"https://github.com/pranav6226/mentalhealth_acc","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":185355,"global_rank":407894},{"name":"dluc/dluc","owner":"dluc","html_url":"https://github.com/dluc/dluc","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topic