[{"name":"thipokch/INFO449-iOS-DomainModel","owner":"thipokch","html_url":"https://github.com/thipokch/INFO449-iOS-DomainModel","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":196129,"global_rank":319935},{"name":"maringantis/Proxy-Cache-Server","owner":"maringantis","html_url":"https://github.com/maringantis/Proxy-Cache-Server","stars":0,"forks":0,"watchers":2,"issues":0,"language":"C","description":"Cache web proxy server is an intermediate server between the client and the main server. The proxy server is used to reduce the bandwidth, latency and the server load. The cache web proxy server caches the client\u2019s requests to the server. Each client request goes through the proxy server. The cache web proxy server responds to the client with the requested information if the files exist. If the cache web proxy doesn\u2019t host the requested information, it talks to the server and fetches the requested information. The subsequent requests to that file will be handled by the cache web proxy server instead of the main server hosting the files. The cache web proxy server fetches the files from the main server until its buffer runs out. The server then deletes the files to make space for the new files.","topics":[],"score":196129,"global_rank":319937},{"name":"Nishanth-Panthangi/Nishanth-Panthangi","owner":"Nishanth-Panthangi","html_url":"https://github.com/Nishanth-Panthangi/Nishanth-Panthangi","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":196125,"global_rank":319943},{"name":"zpalexander/Drupal-Boilerplate","owner":"zpalexander","html_url":"https://github.com/zpalexander/Drupal-Boilerplate","stars":0,"forks":1,"watchers":0,"issues":0,"language":"PHP","description":"A boilerplate directory structure for new Drupal projects","topics":[],"score":196123,"global_rank":319944},{"name":"hslee33754/PHP_passphrase_inc","owner":"hslee33754","html_url":"https://github.