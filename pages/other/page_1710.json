ct the sales of the product.","topics":[],"score":187084,"global_rank":382437},{"name":"surprisetalk/slimetime","owner":"surprisetalk","html_url":"https://github.com/surprisetalk/slimetime","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Elixir","description":null,"topics":[],"score":187084,"global_rank":382445},{"name":"DinoChiesa/Edge-DevPortal-ApiProducts-Access-Extended","owner":"DinoChiesa","html_url":"https://github.com/DinoChiesa/Edge-DevPortal-ApiProducts-Access-Extended","stars":2,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"A Drupal module that allows RBAC access to API Products based on the user's role. ","topics":[],"score":187078,"global_rank":382455},{"name":"mvrk/msreport","owner":"mvrk","html_url":"https://github.com/mvrk/msreport","stars":0,"forks":0,"watchers":1,"issues":0,"language":"TeX","description":"latex files","topics":[],"score":187078,"global_rank":382468},{"name":"pragya1990/wp","owner":"pragya1990","html_url":"https://github.com/pragya1990/wp","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":187078,"global_rank":382476},{"name":"pragya1990/wordpress-4.0-1","owner":"pragya1990","html_url":"https://github.com/pragya1990/wordpress-4.0-1","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":187078,"global_rank":382477},{"name":"philnguyen/intern","owner":"philnguyen","html_url":"https://github.com/philnguyen/intern","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Racket","description":"Type-safe interning of datatypes in Typed Racket as subtype of Index","topics":[],"score":187076,"global_rank":382478},{"name":"philnguyen/bnf","owner":"philnguyen","html_url":"https://github.com/philnguyen/bnf","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Racket","description":"Concise Typed Racket macro for declaring data in BNF","topics":[],"score":187076,"global_rank":382479},{"name":"gilbertosg/feria-ingenieri