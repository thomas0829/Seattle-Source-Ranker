rtic and glutamic acid had the most discriminatory power for detecting ligand interface positions. Our work highlights the utility of large-scale mutagenesis data, and our conclusions can help guide future mutagenesis studies.","topics":[],"score":194041,"global_rank":336290},{"name":"JosiahParry/josiahparry.r-universe.dev","owner":"JosiahParry","html_url":"https://github.com/JosiahParry/josiahparry.r-universe.dev","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":194038,"global_rank":336291},{"name":"mnbatra/pr-demo","owner":"mnbatra","html_url":"https://github.com/mnbatra/pr-demo","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":194038,"global_rank":336292},{"name":"ericsueckert/luaTest","owner":"ericsueckert","html_url":"https://github.com/ericsueckert/luaTest","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Lua","description":null,"topics":[],"score":194035,"global_rank":336294},{"name":"ericsueckert/scalaTest","owner":"ericsueckert","html_url":"https://github.com/ericsueckert/scalaTest","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":null,"topics":[],"score":194035,"global_rank":336295},{"name":"ericsueckert/rustTest","owner":"ericsueckert","html_url":"https://github.com/ericsueckert/rustTest","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Rust","description":null,"topics":[],"score":194035,"global_rank":336296},{"name":"vsmith72/eddie-theme","owner":"vsmith72","html_url":"https://github.com/vsmith72/eddie-theme","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"Theme for Ed's Music Site","topics":[],"score":194035,"global_rank":336297},{"name":"JacopoMangiavacchi/KituraBotMessageStore","owner":"JacopoMangiavacchi","html_url":"https://github.com/JacopoMangiavacchi/KituraBotMessageStore","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":"Swift Kitura Message Sto