d of the main server hosting the files. The cache web proxy server fetches the files from the main server until its buffer runs out. The server then deletes the files to make space for the new files.","topics":[],"score":195267,"global_rank":327079},{"name":"polashrp/designer_maker","owner":"polashrp","html_url":"https://github.com/polashrp/designer_maker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":195267,"global_rank":327083},{"name":"thipokch/INFO449-iOS-DomainModel","owner":"thipokch","html_url":"https://github.com/thipokch/INFO449-iOS-DomainModel","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":195267,"global_rank":327085},{"name":"Jtfinlay/time-tracker-mobile","owner":"Jtfinlay","html_url":"https://github.com/Jtfinlay/time-tracker-mobile","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Dart","description":null,"topics":[],"score":195267,"global_rank":327095},{"name":"aaronsteers/devin-reminders-action","owner":"aaronsteers","html_url":"https://github.com/aaronsteers/devin-reminders-action","stars":1,"forks":0,"watchers":0,"issues":1,"language":"Other","description":"Wake up Devin.ai at a future time.","topics":[],"score":195266,"global_rank":327097},{"name":"a4899e/junk","owner":"a4899e","html_url":"https://github.com/a4899e/junk","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"delicious rubbish","topics":[],"score":195266,"global_rank":327098},{"name":"kevinhongw/Notes","owner":"kevinhongw","html_url":"https://github.com/kevinhongw/Notes","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":195266,"global_rank":327099},{"name":"AdvancedUno/ATLAS","owner":"AdvancedUno","html_url":"https://github.com/AdvancedUno/ATLAS","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Other","description":null,"topics":[],"score":195266,"global_rank":327100},{"name":"nmlorg/qjs-