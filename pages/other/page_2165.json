19609},{"name":"jamesN1307/group_project2022","owner":"jamesN1307","html_url":"https://github.com/jamesN1307/group_project2022","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":null,"topics":[],"score":172542,"global_rank":419610},{"name":"alankjackson/VoterChallenge","owner":"alankjackson","html_url":"https://github.com/alankjackson/VoterChallenge","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Build list of po box voter reg addresses in republican areas","topics":[],"score":172539,"global_rank":419611},{"name":"mbmcc/PPP","owner":"mbmcc","html_url":"https://github.com/mbmcc/PPP","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":172539,"global_rank":419612},{"name":"vritant24/ProsePro","owner":"vritant24","html_url":"https://github.com/vritant24/ProsePro","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"A Word Processor for Professional and Hobbyist writer, with inbuilt version control functionality","topics":[],"score":172539,"global_rank":419613},{"name":"kmussar/American_Time_Use_Survey","owner":"kmussar","html_url":"https://github.com/kmussar/American_Time_Use_Survey","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Analysis of the American Time Use Survey from the Bureau of Labor Statistics ","topics":[],"score":172539,"global_rank":419614},{"name":"bhavdeep98/RoadSafetyUsingVANET","owner":"bhavdeep98","html_url":"https://github.com/bhavdeep98/RoadSafetyUsingVANET","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"One serious road accident in the country occurs every minute and 16 die on Indian roads every hour. In most cases, these deaths are due to the delay in the response we get from the external sources. In such situation, an automatic accident detection mechanism can help to save the loss of life. In this solution, we would demonstrate a prototype for automatic accident detection and prevention using Vehicular Ad hoc Network (VANET) and Internet of Things (IoT).   We will be using off the shelf OBD devices to get diagnostics and real-time information of your car, smart bands for medical insights and your phone acting as a field gateway to communicate with the IoT Hub. The data we get from the phone and OBD device will be stored and analyzed using Azure services based on several inputs. This would enable meaningful insights on users driving behavior.   In case of emergency, nearby devices will be alerted immediately and a signal will be sent to our central server, which will send the location of the accident to the nearest emergency centers. This will also act as a base for smart traffic management system.","topics":[],"score":172539,"global_rank":419615},{"name":"cameronphillips/UM_IEEE_SoutheastCon_2016","owner":"cameronphillips","html_url":"https://github.com/cameronphillips/UM_IEEE_SoutheastCon_2016","stars":0,"forks":1,"watchers":4,"issues":0,"language":"Other","description":"Repository for the 2016 University of Miami IEEE SoutheastCon project. ","topics":[],"score":172534,"global_rank":419616},{"name":"sannidhi/packo","owner":"sannidhi","html_url":"https://github.com/sannidhi/packo","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"Run all of kpack's image builds in parallel","topics":[],"score":172531,"global_rank":419617},{"name":"agarner101/ReactSocks","owner":"agarner101","html_url":"https://github.com/agarner101/ReactSocks","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Simple Socket tester in React","topics":[],"score":172529,"global_rank":419618},{"name":"natebru/AzureARMMods","owner":"natebru","html_url":"https://github.com/natebru/AzureARMMods","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Added some modifications to the Azure ARM Public templates","topics":[],"score":172529,"global_rank":419619},{"name":"enriched/typ