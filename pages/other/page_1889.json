[{"name":"Prattbuw/CSE528_Final_Project_Associative_Memory_Neural_Networks","owner":"Prattbuw","html_url":"https://github.com/Prattbuw/CSE528_Final_Project_Associative_Memory_Neural_Networks","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"In this final project, two others and I characterized the differences in efficiency between simple RNN, LSTM, and GRU neural networks in accurately predicting words given a sequence of preceding letters. We determined that GRU neural network generalizes better than the simple RNN and LSTM neural networks in predicting different target sequences. Moreover, the GRU neural network required less training epochs for predicting the sequence \"hello world\" perfectly as compared to the simple RNN and LSTM neural networks. However, the simple RNN and LSTM neural networks could predict the target sequence perfectly with fewer recurrent units than the GRU neural network. Overall, these results may provide insights into how the nervous system optimally encodes sequences of items.  ","topics":[],"score":180710,"global_rank":402571},{"name":"ianliuy/Simple-Distributed-System","owner":"ianliuy","html_url":"https://github.com/ianliuy/Simple-Distributed-System","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":180710,"global_rank":402572},{"name":"kcmuse/first-repo-kc","owner":"kcmuse","html_url":"https://github.com/kcmuse/first-repo-kc","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":180710,"global_rank":402573},{"name":"jutley/jutley","owner":"jutley","html_url":"https://github.com/jutley/jutley","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":180710,"global_rank":402574},{"name":"ltxom/ltxom","owner":"ltxom","html_url":"https://github.com/ltxom/ltxom","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":18071