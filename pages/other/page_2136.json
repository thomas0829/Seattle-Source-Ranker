[{"name":"cpowell/cessna_177RG_cardinal_for_xplane","owner":"cpowell","html_url":"https://github.com/cpowell/cessna_177RG_cardinal_for_xplane","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Other","description":"The 177RG is an excellent training platform for FAR 61.31(e) complex aircraft: it has a controllable pitch prop, retractable gear, and flaps. Its big, 200HP fuel-injected engine will get you there fast, and it is fully IFR capable.  Sonny Lacey has made a really fantastic 1970 Cardinal 177B. His Cardinal flies wonderfully but, being an earlier variant of the plane, lacks the retractable gear and extra power of the later RG. Sonny graciously granted me permission to deviate from his non-modification license and to base my RG upon his B model. I deeply appreciate this and stress that credit for the foundation airframe and its modeling belong to Sonny; his is really well done. I encourage you to fly his plane as well.","topics":[],"score":173453,"global_rank":416452},{"name":"Vrturo/Algorithms","owner":"Vrturo","html_url":"https://github.com/Vrturo/Algorithms","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":null,"topics":[],"score":173453,"global_rank":416453},{"name":"kayodebristol/Hello-HaLVM","owner":"kayodebristol","html_url":"https://github.com/kayodebristol/Hello-HaLVM","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"Example \"Hello World\" HaLVM web-server running on the Xen Hypervisor","topics":[],"score":173453,"global_rank":416454},{"name":"boezzz/Model-Plane-Remote-Control-System","owner":"boezzz","html_url":"https://github.com/boezzz/Model-Plane-Remote-Control-System","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"A model plane remote control system. It use raspberrypi on the plane. It use socket communication to let the raspbarrypi and controller PC to communicate with cloud server. No remote distance limit!","topics":[],"score":173451,"global_rank":4