genesis data, and our conclusions can help guide future mutagenesis studies.","topics":[],"score":191918,"global_rank":350181},{"name":"asmolich/datasciencecoursera","owner":"asmolich","html_url":"https://github.com/asmolich/datasciencecoursera","stars":0,"forks":1,"watchers":0,"issues":0,"language":"R","description":"Repository of the data science coursera specialization.","topics":[],"score":191918,"global_rank":350182},{"name":"jiangchuanheglobal/My_Data_struct","owner":"jiangchuanheglobal","html_url":"https://github.com/jiangchuanheglobal/My_Data_struct","stars":0,"forks":1,"watchers":0,"issues":0,"language":"C","description":"data structure implementation","topics":[],"score":191918,"global_rank":350184},{"name":"bradlipovsky/group-vision","owner":"bradlipovsky","html_url":"https://github.com/bradlipovsky/group-vision","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":191918,"global_rank":350185},{"name":"cathy810218/UserNotifications","owner":"cathy810218","html_url":"https://github.com/cathy810218/UserNotifications","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":191916,"global_rank":350191},{"name":"tstapler/CPRE489-programming-assignment-3","owner":"tstapler","html_url":"https://github.com/tstapler/CPRE489-programming-assignment-3","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":191916,"global_rank":350193},{"name":"nickcharron/opg_husky","owner":"nickcharron","html_url":"https://github.com/nickcharron/opg_husky","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"Husky Rendering for OPG Proposal","topics":[],"score":191916,"global_rank":350195},{"name":"blladnar/VCSpecs","owner":"blladnar","html_url":"https://github.com/blladnar/VCSpecs","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Objective-C","description":"XCTest framework for testing UIVewControllers","topics":[]