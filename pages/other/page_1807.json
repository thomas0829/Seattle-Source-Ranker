[{"name":"sigsegved/CCN-Simulator","owner":"sigsegved","html_url":"https://github.com/sigsegved/CCN-Simulator","stars":1,"forks":1,"watchers":3,"issues":0,"language":"Other","description":"The simulation system contains two processes. The packet process, which will simulate the complete experience of a packet. The packet process is the complete lifecycle of any packet starting from the node its born to reaching the destination node. The packet process will be able to simulate both interest and data packet experience. It can clone, time out and route itself to destination.   The other process in the system would be the generator process, which wakes up after a particular time and generates a random interest packet. The Generator process will assign a random node as the birth node and an object ID that belongs to another node. Generator process then activates this packet and puts itself to sleep for a random time. ","topics":[],"score":182699,"global_rank":396552},{"name":"kfcampbell/seattleexample","owner":"kfcampbell","html_url":"https://github.com/kfcampbell/seattleexample","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Assembly","description":"Rudimentary MLB game tracking application.","topics":[],"score":182698,"global_rank":396553},{"name":"kevmoo/dart_docker_content-shell","owner":"kevmoo","html_url":"https://github.com/kevmoo/dart_docker_content-shell","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Dart","description":"A sample Dockerfile with Dart and content-shell installed","topics":[],"score":182698,"global_rank":396557},{"name":"emonty/broken-presentation-framwork","owner":"emonty","html_url":"https://github.com/emonty/broken-presentation-framwork","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Handlebars","description":null,"topics":[],"score":182698,"global_rank":396558},{"name":"calesennett/jeopardy_scorer","owner":"calesennett","html_url":"https://github.com/calesennett/jeopardy_scorer","stars":0,"forks":0,"watchers":0,"iss