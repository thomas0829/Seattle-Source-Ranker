[{"name":"sigsegved/CCN-Simulator","owner":"sigsegved","html_url":"https://github.com/sigsegved/CCN-Simulator","stars":1,"forks":1,"watchers":3,"issues":0,"language":"Other","description":"The simulation system contains two processes. The packet process, which will simulate the complete experience of a packet. The packet process is the complete lifecycle of any packet starting from the node its born to reaching the destination node. The packet process will be able to simulate both interest and data packet experience. It can clone, time out and route itself to destination.   The other process in the system would be the generator process, which wakes up after a particular time and generates a random interest packet. The Generator process will assign a random node as the birth node and an object ID that belongs to another node. Generator process then activates this packet and puts itself to sleep for a random time. ","topics":[],"score":182719,"global_rank":396470},{"name":"vsbuffalo/pyfermi","owner":"vsbuffalo","html_url":"https://github.com/vsbuffalo/pyfermi","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Experimental Python interface to the fermi assembler","topics":[],"score":182717,"global_rank":396471},{"name":"9ete/LowerMedia_responsive-child-theme","owner":"9ete","html_url":"https://github.com/9ete/LowerMedia_responsive-child-theme","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":182717,"global_rank":396472},{"name":"TobiasWooldridge/colourised-arduino","owner":"TobiasWooldridge","html_url":"https://github.com/TobiasWooldridge/colourised-arduino","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Arduino","description":"Splashpixel for Arduino","topics":[],"score":182717,"global_rank":396475},{"name":"bharley/resist","owner":"bharley","html_url":"https://github.com/bharley/resist","stars":0,"forks":0,"watchers":0,"issues":0,"language":"CoffeeScript","description":"Web socket ver