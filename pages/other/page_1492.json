 guide future mutagenesis studies.","topics":[],"score":1940.0,"global_rank":337519},{"name":"bryanlittlefield/Magento-Info-Tabs","owner":"bryanlittlefield","html_url":"https://github.com/bryanlittlefield/Magento-Info-Tabs","stars":1,"forks":4,"watchers":1,"issues":0,"language":"Other","description":"Add  Tabs to Magento Tabs","topics":[],"score":1940.0,"global_rank":337522},{"name":"vineethsai/vineethsai","owner":"vineethsai","html_url":"https://github.com/vineethsai/vineethsai","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1940.0,"global_rank":337523},{"name":"clarketm/HackerRank-SQL","owner":"clarketm","html_url":"https://github.com/clarketm/HackerRank-SQL","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"HackerRank SQL Solutions","topics":["hackerrank","solutions","sql"],"score":1940.0,"global_rank":337525},{"name":"Wind010/CommonPowershellUtilities","owner":"Wind010","html_url":"https://github.com/Wind010/CommonPowershellUtilities","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PowerShell","description":"Powershell scripts containing utilities such as logging and TFS API calls.","topics":[],"score":1940,"global_rank":337529},{"name":"BrettSpencer/eastwick","owner":"BrettSpencer","html_url":"https://github.com/BrettSpencer/eastwick","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"Eastwick Salon","topics":[],"score":1940,"global_rank":337531},{"name":"binarybana/OBC.jl","owner":"binarybana","html_url":"https://github.com/binarybana/OBC.jl","stars":0,"forks":1,"watchers":0,"issues":0,"language":"Julia","description":"Optimal Bayesian classification for RNA-Seq data","topics":[],"score":1940,"global_rank":337534},{"name":"Bovojon/Algorithms-Sorting-Searching","owner":"Bovojon","html_url":"https://github.com/Bovojon/Algorithms-Sorting-Searching","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Backup of code from Algorith