[{"name":"DanWoodrich/Kelp-qualitative-analysis","owner":"DanWoodrich","html_url":"https://github.com/DanWoodrich/Kelp-qualitative-analysis","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":"Script to assist in user scoring of kelp blade characteristics","topics":[],"score":194906,"global_rank":325431},{"name":"arcuru/kolakoski","owner":"arcuru","html_url":"https://github.com/arcuru/kolakoski","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Rust","description":null,"topics":[],"score":194906,"global_rank":325446},{"name":"EmeraldCityIT/Double-Latch-buffer-Gates-in-series-in-a-coil-used-to-transfer-buffer-of-physical-material","owner":"EmeraldCityIT","html_url":"https://github.com/EmeraldCityIT/Double-Latch-buffer-Gates-in-series-in-a-coil-used-to-transfer-buffer-of-physical-material","stars":0,"forks":2,"watchers":0,"issues":0,"language":"Other","description":"Material within a conductive coil can be entered into a buffer by creating a double latch gate by manipulating the coil. Creating two double latch gates in a series will allow transfer of physical matter from the first buffer to the second buffer. Large coils can be built like tunnels or delivery tubes to feed physical objects from one side, and retrieve physical objects from the opposite side. In physics and chemistry, it is known that a physical change to a substance does not create a chemical change. Creating a physical break in a crystal lattice structure will leave chemical bonds between both parts. Physical breakage of a conductive metal such as aluminum will leave two parts which have been physically broken but retain all chemical bonds between both parts which existed before the structure was broken. In a conductive lattice structure, electrons and signals will continue to transfer between fragments. A coil with two double latch gates in series, which is physically broken between the series, will retain the ability to transfer buffers between the series. The first buffer is transfered via chemical signalling between the two segments. One end of the severed coil can be shipped to remote locations to deliver personell, deliverables, fuel, electricity, etc. The remote transfer gates work as escape hatches on submarines, aircraft, space missions, etc. Power from wind and hydro can be transferred to vessels and batteries to replace nuclear power, tritium, and Pycnogonida.","topics":[],"score":194902,"global_rank":325449},{"name":"fredhutchio/scRNAseq","owner":"fredhutchio","html_url":"https://github.com/fredhutchio/scRNAseq","stars":2,"forks":0,"watchers":2,"issues":9,"language":"Other","description":"UNDER CONSTRUCTION: training material for single cell RNAseq analysis","topics":[],"score":194901,"global_rank":325451},{"name":"alexturek/gowiki","owner":"alexturek","html_url":"https://github.com/alexturek/gowiki","stars":0,"forks":1,"watchers":0,"issues":0,"language":"Go","description":"Following along tutorial at https://golang.org/doc/articles/wiki/final.go","topics":[],"score":194900,"global_rank":325453},{"name":"crahrig/flamebot","owner":"crahrig","html_url":"https://github.com/crahrig/flamebot","stars":0,"forks":0,"watchers":1,"issues":0,"language":"CoffeeScript","description":"flamebot is a chat bot built on the Hubot framework","topics":["azure","hubot","hubot-adapters","slack"],"score":194897,"global_rank":325469},{"name":"JanetMatsen/meta4_bins--old","owner":"JanetMatsen","html_url":"https://github.com/JanetMatsen/meta4_bins--old","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Shell","description":"meta-omics experiment 4 mapping to genome bins","topics":[],"score":194897,"global_rank":325476},{"name":"peterr-s/bi_map","owner":"peterr-s","html_url":"https://github.com/peterr-s/bi_map","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Bidirectional hash map implementation","topics":[],"score":194897,"global_rank":325484},{"name":"lgelfan/docker-varnish5-redis","owner":"lgelfan","html_url":"https