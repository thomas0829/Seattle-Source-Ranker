e index.html containing, for each photo: a properly oriented thumbnail a caption a link from the thumbnail to a properly oriented medium-size version of the photo the thumbnails and medium-size versions.","topics":[],"score":191505,"global_rank":350521},{"name":"patrick-east/devstack-plugin-cinder-image-cache","owner":"patrick-east","html_url":"https://github.com/patrick-east/devstack-plugin-cinder-image-cache","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"DevStack plugin for configuring the Cinder Glance Image Cache","topics":[],"score":191505,"global_rank":350529},{"name":"avagin/trivial_vpn","owner":"avagin","html_url":"https://github.com/avagin/trivial_vpn","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":191505,"global_rank":350531},{"name":"leventeliu/load-agent","owner":"leventeliu","html_url":"https://github.com/leventeliu/load-agent","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Go","description":null,"topics":[],"score":191505,"global_rank":350532},{"name":"kklt92/HAproxy-proxy-protocol-parser","owner":"kklt92","html_url":"https://github.com/kklt92/HAproxy-proxy-protocol-parser","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Go","description":null,"topics":[],"score":191505,"global_rank":350535},{"name":"greyhill/divvy","owner":"greyhill","html_url":"https://github.com/greyhill/divvy","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Rust","description":"Work distribution utility for Rust","topics":[],"score":191505,"global_rank":350540},{"name":"peterkuriyama/hlsimulator_old","owner":"peterkuriyama","html_url":"https://github.com/peterkuriyama/hlsimulator_old","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":191505,"global_rank":350546},{"name":"aftab-hassan/pubmed","owner":"aftab-hassan","html_url":"https://github.com/aftab-hassan/pubmed","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","desc