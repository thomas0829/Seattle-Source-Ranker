ar data set.","topics":[],"score":214182,"global_rank":253164},{"name":"Chrysippean/Singular-Value-Decomposition-Eigenfaces","owner":"Chrysippean","html_url":"https://github.com/Chrysippean/Singular-Value-Decomposition-Eigenfaces","stars":0,"forks":0,"watchers":1,"issues":0,"language":"MATLAB","description":"We use the singular value decomposition on a matrix of pictures and explore the picture details captured by the modes produced in the matrix decomposition. We also compare the significance of each mode, and how details vary as we increase the number of modes active in image reconstruction. ","topics":[],"score":214182,"global_rank":253165},{"name":"jaydeepingle/producer-consumer-char-device","owner":"jaydeepingle","html_url":"https://github.com/jaydeepingle/producer-consumer-char-device","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Implements a char device and producer consumer problem","topics":[],"score":214182,"global_rank":253167}]