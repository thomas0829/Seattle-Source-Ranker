[{"name":"Axiverse/Schmup","owner":"Axiverse","html_url":"https://github.com/Axiverse/Schmup","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Processing","description":null,"topics":[],"score":193944,"global_rank":329934},{"name":"EmeraldCityIT/Double-Latch-buffer-Gates-in-series-in-a-coil-used-to-transfer-buffer-of-physical-material","owner":"EmeraldCityIT","html_url":"https://github.com/EmeraldCityIT/Double-Latch-buffer-Gates-in-series-in-a-coil-used-to-transfer-buffer-of-physical-material","stars":0,"forks":2,"watchers":0,"issues":0,"language":"Other","description":"Material within a conductive coil can be entered into a buffer by creating a double latch gate by manipulating the coil. Creating two double latch gates in a series will allow transfer of physical matter from the first buffer to the second buffer. Large coils can be built like tunnels or delivery tubes to feed physical objects from one side, and retrieve physical objects from the opposite side. In physics and chemistry, it is known that a physical change to a substance does not create a chemical change. Creating a physical break in a crystal lattice structure will leave chemical bonds between both parts. Physical breakage of a conductive metal such as aluminum will leave two parts which have been physically broken but retain all chemical bonds between both parts which existed before the structure was broken. In a conductive lattice structure, electrons and signals will continue to transfer between fragments. A coil with two double latch gates in series, which is physically broken between the series, will retain the ability to transfer buffers between the series. The first buffer is transfered via chemical signalling between the two segments. One end of the severed coil can be shipped to remote locations to deliver personell, deliverables, fuel, electricity, etc. The remote transfer gates work as escape hatches on submarines, aircraft, space missions, etc. Power from wind and hydro can be transferred to vessels and batteries to replace nuclear power, tritium, and Pycnogonida.","topics":[],"score":193941,"global_rank":329935},{"name":"aaronst/cache_simulator","owner":"aaronst","html_url":"https://github.com/aaronst/cache_simulator","stars":0,"forks":0,"watchers":3,"issues":0,"language":"C","description":null,"topics":[],"score":193939,"global_rank":329936},{"name":"NotDevIntended/Hexagram","owner":"NotDevIntended","html_url":"https://github.com/NotDevIntended/Hexagram","stars":0,"forks":1,"watchers":0,"issues":0,"language":"C","description":"Hexagram project for Bizzlebuzz","topics":[],"score":193939,"global_rank":329937},{"name":"karan/homebrew-karan","owner":"karan","html_url":"https://github.com/karan/homebrew-karan","stars":1,"forks":3,"watchers":1,"issues":0,"language":"Other","description":"Homebrew tap for my packages","topics":[],"score":193938,"global_rank":329940},{"name":"danyojang/word-predictor","owner":"danyojang","html_url":"https://github.com/danyojang/word-predictor","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":193936,"global_rank":329944},{"name":"bpshonyak/tech-portal-public-code","owner":"bpshonyak","html_url":"https://github.com/bpshonyak/tech-portal-public-code","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"A website portal for GRC students who need to reset their password","topics":[],"score":193936,"global_rank":329953},{"name":"axelmagn/fp-scala-tut","owner":"axelmagn","html_url":"https://github.com/axelmagn/fp-scala-tut","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":"Following along a book on functional programming in scala","topics":[],"score":193936,"global_rank":329955},{"name":"darkoverlordofdata/spaaace-gopher","owner":"darkoverlordofdata","html_url":"https://github.com/darkoverlordofdata/spaaace-gopher","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Go","description":"Spaaace Gopher - muking about with g