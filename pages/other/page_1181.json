2019s job to worry about safely accessing/modifying the restaurant.  The McGoogles implementation will have all the locking and synchronization (and no threading!). It should ensure that all variables are modified correctly and safely, and that the restaurant is never above capacity. It should also ensure that all orders were fulfilled (number of orders == number of expected orders).","topics":[],"score":2116,"global_rank":265498},{"name":"LuisaSanto/ios-awesome-chat","owner":"LuisaSanto","html_url":"https://github.com/LuisaSanto/ios-awesome-chat","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Swift","description":null,"topics":[],"score":2116,"global_rank":265502},{"name":"jaredscarr/wiki-3","owner":"jaredscarr","html_url":"https://github.com/jaredscarr/wiki-3","stars":0,"forks":3,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":2116.0,"global_rank":265521},{"name":"n3wscott/knperf","owner":"n3wscott","html_url":"https://github.com/n3wscott/knperf","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Go","description":"Knative Performance Testing (playground)","topics":[],"score":2116,"global_rank":265534},{"name":"lindsayad/SurfaceDeposit","owner":"lindsayad","html_url":"https://github.com/lindsayad/SurfaceDeposit","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C","description":null,"topics":[],"score":2116,"global_rank":265535},{"name":"slank/gcod","owner":"slank","html_url":"https://github.com/slank/gcod","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Go","description":"Miscellaneous utilities for generating gcode","topics":[],"score":2116,"global_rank":265548},{"name":"crikeli/ZestiOS","owner":"crikeli","html_url":"https://github.com/crikeli/ZestiOS","stars":0,"forks":1,"watchers":2,"issues":1,"language":"Swift","description":"iOS implementation of E-commerce app.","topics":[],"score":2116,"global_rank":265549},{"name":"Nogbit/terraform-playground","owner":"Nogbit","html_url":"https://github.com/Nog