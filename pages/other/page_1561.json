nail a caption a link from the thumbnail to a properly oriented medium-size version of the photo the thumbnails and medium-size versions.","topics":[],"score":191546,"global_rank":350222},{"name":"peterkuriyama/hlsimulator_old","owner":"peterkuriyama","html_url":"https://github.com/peterkuriyama/hlsimulator_old","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":191546,"global_rank":350227},{"name":"JohannMG/Hedgehog1","owner":"JohannMG","html_url":"https://github.com/JohannMG/Hedgehog1","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Objective-C","description":"AAA intro app for Objective-C","topics":[],"score":191546,"global_rank":350230},{"name":"quinkennedy/flatmap","owner":"quinkennedy","html_url":"https://github.com/quinkennedy/flatmap","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Clojure","description":"an exploration of warping polylines into straight lines","topics":[],"score":191546,"global_rank":350231},{"name":"avagin/trivial_vpn","owner":"avagin","html_url":"https://github.com/avagin/trivial_vpn","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":null,"topics":[],"score":191546,"global_rank":350232},{"name":"lowellbander/cs281a","owner":"lowellbander","html_url":"https://github.com/lowellbander/cs281a","stars":0,"forks":0,"watchers":1,"issues":0,"language":"TeX","description":null,"topics":[],"score":191546,"global_rank":350234},{"name":"cptavatar/cz-parser","owner":"cptavatar","html_url":"https://github.com/cptavatar/cz-parser","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Clojure","description":"Just some clojure JSON parsing code to help do a bit more filtering out of vendor files I needed to look at. ","topics":[],"score":191546,"global_rank":350236},{"name":"aftab-hassan/pubmed","owner":"aftab-hassan","html_url":"https://github.com/aftab-hassan/pubmed","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":191