/ when you invoked album, then all these things go into foo/) a file index.html containing, for each photo: a properly oriented thumbnail a caption a link from the thumbnail to a properly oriented medium-size version of the photo the thumbnails and medium-size versions.","topics":[],"score":191760,"global_rank":349978},{"name":"nniiicc/INSC-570","owner":"nniiicc","html_url":"https://github.com/nniiicc/INSC-570","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Repository for Research Design - A first year PhD seminar in the UW Information School ","topics":[],"score":191758,"global_rank":349995},{"name":"rangelMatt/rangelMatt","owner":"rangelMatt","html_url":"https://github.com/rangelMatt/rangelMatt","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":191756,"global_rank":349996},{"name":"ngutten/patina","owner":"ngutten","html_url":"https://github.com/ngutten/patina","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Tabletop RPG system and setting in development","topics":[],"score":191756,"global_rank":349997},{"name":"pragyy/Time-Series-Data-Predictability","owner":"pragyy","html_url":"https://github.com/pragyy/Time-Series-Data-Predictability","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"Various exponents and laws were used to determine the smoothness of the given dataset","topics":[],"score":191753,"global_rank":349998},{"name":"MrArnoldPalmer/reagent-music","owner":"MrArnoldPalmer","html_url":"https://github.com/MrArnoldPalmer/reagent-music","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Clojure","description":"Clojurescript fun with reagent","topics":[],"score":191752,"global_rank":349999},{"name":"lindison/minecraft","owner":"lindison","html_url":"https://github.com/lindison/minecraft","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":null,"topics":[],"score":191752,"global_rank":350000}