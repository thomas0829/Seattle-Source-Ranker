 product.","topics":[],"score":188045,"global_rank":374354},{"name":"surprisetalk/slimetime","owner":"surprisetalk","html_url":"https://github.com/surprisetalk/slimetime","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Elixir","description":null,"topics":[],"score":188045,"global_rank":374364},{"name":"dmarx/torno","owner":"dmarx","html_url":"https://github.com/dmarx/torno","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"[WIP] Feature store for LLM data enrichment","topics":[],"score":188043,"global_rank":374372},{"name":"sarahcec/openid-aiim-threat-modeling","owner":"sarahcec","html_url":"https://github.com/sarahcec/openid-aiim-threat-modeling","stars":0,"forks":1,"watchers":0,"issues":1,"language":"Other","description":null,"topics":[],"score":188041,"global_rank":374373},{"name":"Sage-Bionetworks/synapse-rest-docs-infra","owner":"Sage-Bionetworks","html_url":"https://github.com/Sage-Bionetworks/synapse-rest-docs-infra","stars":0,"forks":1,"watchers":0,"issues":0,"language":"Other","description":"AWS infrastructure to deploy Synapse REST API documentation","topics":[],"score":188041,"global_rank":374374},{"name":"BenaroyaResearch/Cerosaletti_Self-reactive_Tcells","owner":"BenaroyaResearch","html_url":"https://github.com/BenaroyaResearch/Cerosaletti_Self-reactive_Tcells","stars":0,"forks":1,"watchers":0,"issues":0,"language":"Other","description":"Code for the study entitled \"Self-reactive human conventional and regulatory T cells are clonally expanded but have distinct TCR repertoires\" by Thomas","topics":[],"score":188041,"global_rank":374375},{"name":"jghoman/weekly-data-updates","owner":"jghoman","html_url":"https://github.com/jghoman/weekly-data-updates","stars":0,"forks":1,"watchers":0,"issues":0,"language":"Other","description":"Updates I send out to my team on cool data stuff","topics":[],"score":188041,"global_rank":374376},{"name":"JosiahParry/miniextendr2","owner":"JosiahParry","html_url":"https://github.com/Josiah