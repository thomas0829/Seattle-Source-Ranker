[{"name":"maringantis/Proxy-Cache-Server","owner":"maringantis","html_url":"https://github.com/maringantis/Proxy-Cache-Server","stars":0,"forks":0,"watchers":2,"issues":0,"language":"C","description":"Cache web proxy server is an intermediate server between the client and the main server. The proxy server is used to reduce the bandwidth, latency and the server load. The cache web proxy server caches the client\u2019s requests to the server. Each client request goes through the proxy server. The cache web proxy server responds to the client with the requested information if the files exist. If the cache web proxy doesn\u2019t host the requested information, it talks to the server and fetches the requested information. The subsequent requests to that file will be handled by the cache web proxy server instead of the main server hosting the files. The cache web proxy server fetches the files from the main server until its buffer runs out. The server then deletes the files to make space for the new files.","topics":[],"score":196532,"global_rank":316186},{"name":"wongnat/.emacs","owner":"wongnat","html_url":"https://github.com/wongnat/.emacs","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Emacs Lisp","description":"My emacs config","topics":[],"score":196532,"global_rank":316187},{"name":"polashrp/designer_maker","owner":"polashrp","html_url":"https://github.com/polashrp/designer_maker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":196532,"global_rank":316190},{"name":"MaxMB15/Ocaml","owner":"MaxMB15","html_url":"https://github.com/MaxMB15/Ocaml","stars":0,"forks":0,"watchers":1,"issues":0,"language":"OCaml","description":"All my Ocaml files","topics":[],"score":196532,"global_rank":316192},{"name":"navicore/spark-structured-streaming-on-azure.g8","owner":"navicore","html_url":"https://github.com/navicore/spark-structured-streaming-on-azure.g8","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","d