[{"name":"SKhunteta/Tut-Tut-IoT-Raindrop-Detector","owner":"SKhunteta","html_url":"https://github.com/SKhunteta/Tut-Tut-IoT-Raindrop-Detector","stars":1,"forks":1,"watchers":0,"issues":0,"language":"Assembly","description":"Tut-Tut, the IoT Raindrop Detector, is a project under the domain of the OPEnS (Openly Published Environment Sensing) Lab at Oregon State University. Tut-Tut will be able to detect a raindrop of any size, get an idea of the drop's mass from the intensity at which it falls, and detect the frequency of raindrops. After Tut-Tut gathers this data, it will be able to wirelessly transmit the information to a central server and communicate it to other IoT devices around Oregon State University. The detector will periodically wake up to check for rain and will stay awake as long as rain is detected within two minutes. If it does not detect raindrops within two minutes, it will go back to sleep.","topics":[],"score":249336,"global_rank":63903},{"name":"SamStan4/ExHell","owner":"SamStan4","html_url":"https://github.com/SamStan4/ExHell","stars":0,"forks":0,"watchers":0,"issues":1,"language":"CMake","description":null,"topics":[],"score":249329,"global_rank":63906},{"name":"DaCuteRaccoon/status","owner":"DaCuteRaccoon","html_url":"https://github.com/DaCuteRaccoon/status","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Svelte","description":null,"topics":[],"score":249328,"global_rank":63912},{"name":"jeffreyjtech/portfolio","owner":"jeffreyjtech","html_url":"https://github.com/jeffreyjtech/portfolio","stars":1,"forks":0,"watchers":1,"issues":0,"language":"SCSS","description":"Portfolio for Code 301 Lab 05","topics":[],"score":249319,"global_rank":63933},{"name":"mmuugii/GoldenCount","owner":"mmuugii","html_url":"https://github.com/mmuugii/GoldenCount","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":249315,"global_rank":63937},{"name":"akyuute/rk61-qmk","owner":"akyuute","html_url":"https://github.