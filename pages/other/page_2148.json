[{"name":"tganyan/balanced-tree-and-linked-list-reversal","owner":"tganyan","html_url":"https://github.com/tganyan/balanced-tree-and-linked-list-reversal","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Other","description":null,"topics":[],"score":173251,"global_rank":418905},{"name":"factoryhands/ohhey_v2","owner":"factoryhands","html_url":"https://github.com/factoryhands/ohhey_v2","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Oh Hey redesign","topics":[],"score":173251,"global_rank":418906},{"name":"cpowell/cessna_177RG_cardinal_for_xplane","owner":"cpowell","html_url":"https://github.com/cpowell/cessna_177RG_cardinal_for_xplane","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Other","description":"The 177RG is an excellent training platform for FAR 61.31(e) complex aircraft: it has a controllable pitch prop, retractable gear, and flaps. Its big, 200HP fuel-injected engine will get you there fast, and it is fully IFR capable.  Sonny Lacey has made a really fantastic 1970 Cardinal 177B. His Cardinal flies wonderfully but, being an earlier variant of the plane, lacks the retractable gear and extra power of the later RG. Sonny graciously granted me permission to deviate from his non-modification license and to base my RG upon his B model. I deeply appreciate this and stress that credit for the foundation airframe and its modeling belong to Sonny; his is really well done. I encourage you to fly his plane as well.","topics":[],"score":173249,"global_rank":418907},{"name":"shawnoster/ely","owner":"shawnoster","html_url":"https://github.com/shawnoster/ely","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"A stub project-structure for .NET services","topics":[],"score":173244,"global_rank":418908},{"name":"SBALDOCK/code201-lab5","owner":"SBALDOCK","html_url":"https://github.com/SBALDOCK/code201-lab5","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Other","description":"Code201 - Lab 5 Ass