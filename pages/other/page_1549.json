[{"name":"dannywarren/nagios-plugins-freebsd","owner":"dannywarren","html_url":"https://github.com/dannywarren/nagios-plugins-freebsd","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"Nagios plugins for FreeBSD","topics":[],"score":191982,"global_rank":347126},{"name":"dannywarren/WWW-Epguides","owner":"dannywarren","html_url":"https://github.com/dannywarren/WWW-Epguides","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Perl","description":"Repository for WWW::Epguides perl module","topics":[],"score":191982,"global_rank":347127},{"name":"jgockley62/BasicSTARRseq","owner":"jgockley62","html_url":"https://github.com/jgockley62/BasicSTARRseq","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":191982,"global_rank":347135},{"name":"maringantis/UDP-Socket-Throughput","owner":"maringantis","html_url":"https://github.com/maringantis/UDP-Socket-Throughput","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"The server should take 3 command line arguments: the port number from which it reads requests, the message size in bytes, and the sleep time in milliseconds. The server will read a message of the specified size from a client. After that, it will sleep for the specified amount of time (to simulate injected network latency) and then send an acknowledgment for the received message back to the client. Each client message will have a unique sequence number, which is included in the ack sent by the server. The server repeats this for 30 messages and then exit. The client will take 3 command line arguments: the IP address (or the host name) and port number of the server, and the message size in bytes. The client will write a message of the specified size to the server and wait for the ack from the server. The client will repeat this 30 times and keep track of the total amount of time spent on sending all the messages and receiving all the acks. It computes the throughput by: 30 * message_size_in_bytes / total_time_in_seconds and print the throughput value. After that, the client should exit.","topics":[],"score":191973,"global_rank":347147},{"name":"maringantis/TCP-Socket-data-transfer-no-limit","owner":"maringantis","html_url":"https://github.com/maringantis/TCP-Socket-data-transfer-no-limit","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"TCP socket program with no limit data transfer from client to server.No FILES operations were used.","topics":[],"score":191973,"global_rank":347148},{"name":"Talljoe/oh-my-zsh-plugin","owner":"Talljoe","html_url":"https://github.com/Talljoe/oh-my-zsh-plugin","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":"Plugin for Oh My ZSH, mainly for personal use","topics":[],"score":191973,"global_rank":347150},{"name":"pfrcks/MovieQuotePlugin","owner":"pfrcks","html_url":"https://github.com/pfrcks/MovieQuotePlugin","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":null,"topics":[],"score":191973,"global_rank":347166},{"name":"littlebee/react-focus-trap-amd","owner":"littlebee","html_url":"https://github.com/littlebee/react-focus-trap-amd","stars":0,"forks":0,"watchers":1,"issues":0,"language":"CoffeeScript","description":"A webpack packaging of react-focus-trap that is compatible with requireJs","topics":[],"score":191973,"global_rank":347167},{"name":"mitchthompson/mitchell-thompson-portfolio","owner":"mitchthompson","html_url":"https://github.com/mitchthompson/mitchell-thompson-portfolio","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Hack","description":null,"topics":[],"score":191973,"global_rank":347169},{"name":"muditmittal/Facebook-Photo-Gallery","owner":"muditmittal","html_url":"https://github.com/muditmittal/Facebook-Photo-Gallery","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Swift","description":"Week 5 Assignment","topics":[],"score":191973,"global_rank":347171},{"name":"D-Land/operating-systems",