fectly with fewer recurrent units than the GRU neural network. Overall, these results may provide insights into how the nervous system optimally encodes sequences of items.  ","topics":[],"score":1805.6000000000001,"global_rank":405685},{"name":"DavidRicardoWilde/clover-waller-js-sdk","owner":"DavidRicardoWilde","html_url":"https://github.com/DavidRicardoWilde/clover-waller-js-sdk","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Clover wallet client SDK","topics":[],"score":1805.6000000000001,"global_rank":405686},{"name":"jimnguyen/employee-management-jump","owner":"jimnguyen","html_url":"https://github.com/jimnguyen/employee-management-jump","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"employee-management-jump","topics":[],"score":1805.6000000000001,"global_rank":405687},{"name":"SBALDOCK/code401-reading-notes","owner":"SBALDOCK","html_url":"https://github.com/SBALDOCK/code401-reading-notes","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Reading Notes - 401","topics":[],"score":1805.6000000000001,"global_rank":405688},{"name":"Rubick1997/wallpaper","owner":"Rubick1997","html_url":"https://github.com/Rubick1997/wallpaper","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1805.6000000000001,"global_rank":405689},{"name":"Njanderson/Musescores","owner":"Njanderson","html_url":"https://github.com/Njanderson/Musescores","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1805.6000000000001,"global_rank":405690},{"name":"alisa1649/alisa1649","owner":"alisa1649","html_url":"https://github.com/alisa1649/alisa1649","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1805.6000000000001,"global_rank":405691},{"name":"ianliuy/Simple-Distributed-System","owner":"ianliuy","html_url":"https://github.com/ianliuy/Simple-Distributed-System"