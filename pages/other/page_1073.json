[{"name":"ArunaaSingh/Exploratory-Data-Analysis-NEI","owner":"ArunaaSingh","html_url":"https://github.com/ArunaaSingh/Exploratory-Data-Analysis-NEI","stars":0,"forks":0,"watchers":0,"issues":0,"language":"R","description":"Fine particulate matter (PM2.5) is an ambient air pollutant for which there is strong evidence that it is harmful to human health. In the United States, the Environmental Protection Agency (EPA) is tasked with setting national ambient air quality standards for fine PM and for tracking the emissions of this pollutant into the atmosphere. Approximatly every 3 years, the EPA releases its database on emissions of PM2.5. This database is known as the National Emissions Inventory (NEI). You can read more information about the NEI at the EPA National Emissions Inventory web site.  For each year and for each type of PM source, the NEI records how many tons of PM2.5 were emitted from that source over the course of the entire year. The data that you will use for this assignment are for 1999, 2002, 2005, and 2008","topics":[],"score":216253,"global_rank":236333},{"name":"Gibbsdavidl/BrainDecon","owner":"Gibbsdavidl","html_url":"https://github.com/Gibbsdavidl/BrainDecon","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":"Using Allen scRNA-seq to generate cell signatures, and using them to deconvolve bulk expression. ","topics":[],"score":216249,"global_rank":236358},{"name":"lukeknowles/foodmap","owner":"lukeknowles","html_url":"https://github.com/lukeknowles/foodmap","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"A web app used by a few food banks in Washington to determine client eligibility based on geographic boundaries.","topics":[],"score":216249,"global_rank":236363},{"name":"dwgarrett2013/Team-GLaDOS","owner":"dwgarrett2013","html_url":"https://github.com/dwgarrett2013/Team-GLaDOS","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Shell","description":null,"topics":[],"score":216249,"global_ran