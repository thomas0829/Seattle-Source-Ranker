ml_url":"https://github.com/Seon2020/reading-notes","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Code Fellows Reading Notes","topics":[],"score":180458,"global_rank":403823},{"name":"sfkunal/DataPrivacy_RESEARCH","owner":"sfkunal","html_url":"https://github.com/sfkunal/DataPrivacy_RESEARCH","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"The world of technology is changing. It used to be one where users could post on social media, order clothes online, and play mobile games without a care in the world. As time progressed, companies eventually realized that they could collect small pieces of information from a user\u2019s technological habits, and use that to form a profile of the user of some sort. I used a packet-monitoring service to listen in on third-party applications and wrote a script to filter out relevant pieces of data that were being sent back to an application\u2019s server. The findings of this study concluded that third-party iOS applications have unmonitored power to access pieces of information like contacts, location, and emails.","topics":[],"score":180458,"global_rank":403824},{"name":"alerickson0/AWS","owner":"alerickson0","html_url":"https://github.com/alerickson0/AWS","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Place with useful AWS stuff I've developed, come across, etc.","topics":[],"score":180457,"global_rank":403825},{"name":"eminguyen/eminguyen","owner":"eminguyen","html_url":"https://github.com/eminguyen/eminguyen","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"Follow me at https://emilynguyen.io","topics":[],"score":180457,"global_rank":403826},{"name":"iagox86/nc.bin","owner":"iagox86","html_url":"https://github.com/iagox86/nc.bin","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":180457,"global_rank":403827}]