 to make space for the new files.","topics":[],"score":197008,"global_rank":315997},{"name":"navicore/spark-structured-streaming-on-azure.g8","owner":"navicore","html_url":"https://github.com/navicore/spark-structured-streaming-on-azure.g8","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Scala","description":"starter kit for spark structured streaming with support for various azure integrations","topics":[],"score":197008,"global_rank":316004},{"name":"vyapham/cmps101pa2","owner":"vyapham","html_url":"https://github.com/vyapham/cmps101pa2","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Doubly Linked List + Insertion sort in C","topics":[],"score":197008,"global_rank":316013},{"name":"thipokch/INFO449-iOS-DomainModel","owner":"thipokch","html_url":"https://github.com/thipokch/INFO449-iOS-DomainModel","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":197008,"global_rank":316016},{"name":"wongnat/.emacs","owner":"wongnat","html_url":"https://github.com/wongnat/.emacs","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Emacs Lisp","description":"My emacs config","topics":[],"score":197008,"global_rank":316027},{"name":"dclong/rexcel","owner":"dclong","html_url":"https://github.com/dclong/rexcel","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":197008,"global_rank":316035},{"name":"MaxMB15/Ocaml","owner":"MaxMB15","html_url":"https://github.com/MaxMB15/Ocaml","stars":0,"forks":0,"watchers":1,"issues":0,"language":"OCaml","description":"All my Ocaml files","topics":[],"score":197008,"global_rank":316037},{"name":"jamieahmed/developer-chat-app-back-end","owner":"jamieahmed","html_url":"https://github.com/jamieahmed/developer-chat-app-back-end","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":197006,"global_rank":316042},{"name":"ameliaduvall/ameliaduvall","owner":"ameliaduvall","htm