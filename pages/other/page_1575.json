[{"name":"atindersaini/Home-Value-Patrol","owner":"atindersaini","html_url":"https://github.com/atindersaini/Home-Value-Patrol","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":"Project in R -- Relationship between crime and home value in Seattle Neighborhoods.","topics":[],"score":190717,"global_rank":348666},{"name":"vbharam/iOS-StackView","owner":"vbharam","html_url":"https://github.com/vbharam/iOS-StackView","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":"K@W","topics":[],"score":190717,"global_rank":348667},{"name":"jgockley62/BasicSTARRseq","owner":"jgockley62","html_url":"https://github.com/jgockley62/BasicSTARRseq","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":190717,"global_rank":348669},{"name":"Y--/sample","owner":"Y--","html_url":"https://github.com/Y--/sample","stars":1,"forks":0,"watchers":1,"issues":1,"language":"Other","description":null,"topics":[],"score":190710,"global_rank":348673},{"name":"mitchthompson/mitchell-thompson-portfolio","owner":"mitchthompson","html_url":"https://github.com/mitchthompson/mitchell-thompson-portfolio","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Hack","description":null,"topics":[],"score":190709,"global_rank":348684},{"name":"maringantis/UDP-Socket-Throughput","owner":"maringantis","html_url":"https://github.com/maringantis/UDP-Socket-Throughput","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"The server should take 3 command line arguments: the port number from which it reads requests, the message size in bytes, and the sleep time in milliseconds. The server will read a message of the specified size from a client. After that, it will sleep for the specified amount of time (to simulate injected network latency) and then send an acknowledgment for the received message back to the client. Each client message will have a unique sequence number, which is included in the ack sent by the server. The server repeats this for 30 messages and then exit. The client will take 3 command line arguments: the IP address (or the host name) and port number of the server, and the message size in bytes. The client will write a message of the specified size to the server and wait for the ack from the server. The client will repeat this 30 times and keep track of the total amount of time spent on sending all the messages and receiving all the acks. It computes the throughput by: 30 * message_size_in_bytes / total_time_in_seconds and print the throughput value. After that, the client should exit.","topics":[],"score":190709,"global_rank":348692},{"name":"maringantis/TCP-Socket-data-transfer-no-limit","owner":"maringantis","html_url":"https://github.com/maringantis/TCP-Socket-data-transfer-no-limit","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"TCP socket program with no limit data transfer from client to server.No FILES operations were used.","topics":[],"score":190709,"global_rank":348693},{"name":"muditmittal/Facebook-Photo-Gallery","owner":"muditmittal","html_url":"https://github.com/muditmittal/Facebook-Photo-Gallery","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Swift","description":"Week 5 Assignment","topics":[],"score":190709,"global_rank":348697},{"name":"cbessee/WP-Recipes","owner":"cbessee","html_url":"https://github.com/cbessee/WP-Recipes","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":"A simple wordpress plugin for creating custom recipe post types. Recipes are displayed according to the Schema.org/Recipe model.","topics":[],"score":190709,"global_rank":348712},{"name":"D-Land/operating-systems","owner":"D-Land","html_url":"https://github.com/D-Land/operating-systems","stars":0,"forks":0,"watchers":2,"issues":0,"language":"C","description":"BOOM","topics":[],"score":190708,"global_rank":348719},{"name":"yjyoo773/yjyoo773","owner":"yjyoo773","html_url":"https://github.com/yjyoo773/yjy