ank":375136},{"name":"aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","owner":"aarivan","html_url":"https://github.com/aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","stars":0,"forks":0,"watchers":0,"issues":0,"language":"R","description":"Overview Identifying the strategy employed by business firms has motivated empirical research towards studying a firm\u2019s behavior. If there exists a specific pattern that can describe the interactions between the manufacturers and retailers, the application of causality analysis on their pricing interaction can clarify their strategic behavior. The interactions between the manufacturer and retailer can be discussed to follow a verticalintegrated system or Stackelberg leadership bilateral-monopoly model. In a vertical-integrated system, the manufacturer and retailer cooperate to maximize the profit of the distribution channel instead of individual profit. The important character of this model is that both the manufacturer and retailer affect the sales of the product.","topics":[],"score":188103,"global_rank":375142},{"name":"E-Schaferer/dev-general","owner":"E-Schaferer","html_url":"https://github.com/E-Schaferer/dev-general","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":188100,"global_rank":375152},{"name":"leyulunna/leyulunna","owner":"leyulunna","html_url":"https://github.com/leyulunna/leyulunna","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":188097,"global_rank":375169},{"name":"mvrk/msreport","owner":"mvrk","html_url":"https://github.com/mvrk/msreport","stars":0,"forks":0,"watchers":1,"issues":0,"language":"TeX","description":"latex files","topics":[],"score":188097,"global_rank":375174},{"name":"TerminalWitchcraft/TerminalWitchcraft","owner":"TerminalWitchcraft","html_url":"https://github.com/TerminalWitchcraft/TerminalWitchcraft","stars":0,"forks":0,"watchers":1,"is