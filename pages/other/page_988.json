[{"name":"vineethsai/vineethsai","owner":"vineethsai","html_url":"https://github.com/vineethsai/vineethsai","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1940.0,"global_rank":202608},{"name":"FowlerLab/2017_GRAY_InformativeAA","owner":"FowlerLab","html_url":"https://github.com/FowlerLab/2017_GRAY_InformativeAA","stars":1,"forks":1,"watchers":3,"issues":0,"language":"Other","description":"To draw general conclusions about the effects of different amino acid substitutions, we analyzed 34,373 mutations in fourteen proteins whose effects were measured using large-scale mutagenesis approaches. Methionine was the most tolerated substitution while proline was the least tolerated. Histidine and asparagine best recapitulated the effects of other substitutions, even when the identity of the wild type amino acid was considered. Furthermore, highly disruptive substitutions like aspartic and glutamic acid had the most discriminatory power for detecting ligand interface positions. Our work highlights the utility of large-scale mutagenesis data, and our conclusions can help guide future mutagenesis studies.","topics":[],"score":1940.0,"global_rank":202609},{"name":"Anirudhk94/System-Security","owner":"Anirudhk94","html_url":"https://github.com/Anirudhk94/System-Security","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"The repository includes information and details about various topics relating to system security.","topics":[],"score":1940.0,"global_rank":202610},{"name":"brookinsconsulting/bcpublish","owner":"brookinsconsulting","html_url":"https://github.com/brookinsconsulting/bcpublish","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"eZ Publish Legacy (4.x) fork distribution maintained by Brookins Consulting ","topics":[],"score":1940.0,"global_rank":202613},{"name":"clarketm/HackerRank-SQL","owner":"clarketm","html_url":"https://github.com/clarketm/HackerRank-SQL