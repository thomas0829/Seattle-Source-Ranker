pective user of a crowdfunding campaign, on ways that they can optimize their campaign itself to give themselves the best chance of being successful.","topics":[],"score":1798.4,"global_rank":418574},{"name":"ashishakonnur/YouTube-trends-for-2017-2018---Intro-to-Python","owner":"ashishakonnur","html_url":"https://github.com/ashishakonnur/YouTube-trends-for-2017-2018---Intro-to-Python","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1798.4,"global_rank":418575},{"name":"QPThree/learning_oauth","owner":"QPThree","html_url":"https://github.com/QPThree/learning_oauth","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1798.4,"global_rank":418576},{"name":"insideseanshead/wordpress_rest_api_project","owner":"insideseanshead","html_url":"https://github.com/insideseanshead/wordpress_rest_api_project","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1798.4,"global_rank":418577},{"name":"jeffmendoza/.github","owner":"jeffmendoza","html_url":"https://github.com/jeffmendoza/.github","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1798.4,"global_rank":418578},{"name":"nevzheng/nevzheng","owner":"nevzheng","html_url":"https://github.com/nevzheng/nevzheng","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":"My Github Profile Landing Page","topics":[],"score":1798.4,"global_rank":418579},{"name":"Laiban/background-generator","owner":"Laiban","html_url":"https://github.com/Laiban/background-generator","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1798.4,"global_rank":418580},{"name":"Leodium4f/asds","owner":"Leodium4f","html_url":"https://github.com/Leodium4f/asds","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Other","description":null,"topics":[],"score":1798.4,"global_rank":418581}