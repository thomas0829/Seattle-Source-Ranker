[{"name":"chuanisawesome/Pebble-Simple-Watchface","owner":"chuanisawesome","html_url":"https://github.com/chuanisawesome/Pebble-Simple-Watchface","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C","description":"A simple watchface for Pebble :)","topics":[],"score":186797,"global_rank":384831},{"name":"aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","owner":"aarivan","html_url":"https://github.com/aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","stars":0,"forks":0,"watchers":0,"issues":0,"language":"R","description":"Overview Identifying the strategy employed by business firms has motivated empirical research towards studying a firm\u2019s behavior. If there exists a specific pattern that can describe the interactions between the manufacturers and retailers, the application of causality analysis on their pricing interaction can clarify their strategic behavior. The interactions between the manufacturer and retailer can be discussed to follow a verticalintegrated system or Stackelberg leadership bilateral-monopoly model. In a vertical-integrated system, the manufacturer and retailer cooperate to maximize the profit of the distribution channel instead of individual profit. The important character of this model is that both the manufacturer and retailer affect the sales of the product.","topics":[],"score":186797,"global_rank":384833},{"name":"surprisetalk/slimetime","owner":"surprisetalk","html_url":"https://github.com/surprisetalk/slimetime","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Elixir","description":null,"topics":[],"score":186797,"global_rank":384850},{"name":"philnguyen/loop-cfa","owner":"philnguyen","html_url":"https://github.com/philnguyen/loop-cfa","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Racket","description":"Small model of static analysis that's only confused between different iterations of a loop","topics":[],"score":186797,"global_rank":384857},{"name":"mike-babb/irs_sta