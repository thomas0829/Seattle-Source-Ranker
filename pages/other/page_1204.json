[{"name":"kchoadley/exercism-bash","owner":"kchoadley","html_url":"https://github.com/kchoadley/exercism-bash","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Shell","description":"Exercism bash track","topics":[],"score":211092,"global_rank":264430},{"name":"AishwaryaBhargava/cigarette-smoker-problem","owner":"AishwaryaBhargava","html_url":"https://github.com/AishwaryaBhargava/cigarette-smoker-problem","stars":0,"forks":0,"watchers":0,"issues":0,"language":"C","description":"This is a system with three smoker processes and one agent process. Each smoker continuously rolls a cigarette and then smokes it. But to roll and smoke a cigarette, the smoker needs three ingredients: tobacco, paper, and matches. One of the smoker processes has paper, another has tobacco, and the third has matches. The agent has an infinite supply of all three materials. The agent places two of the ingredients on the table. The smoker who has the remaining ingredient then makes and smokes a cigarette, signaling the agent on completion. The agent then puts out another two of the three ingredients, and the cycle repeats.","topics":[],"score":211092,"global_rank":264434},{"name":"AishwaryaBhargava/BCDtoBIN-BINtoBCD","owner":"AishwaryaBhargava","html_url":"https://github.com/AishwaryaBhargava/BCDtoBIN-BINtoBCD","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Assembly","description":"It is basically a calculator for base conversion (Binary Coded Decimal (BCD) to Binary (BIN) and BIN to BCD). It is the assembly language code used on emulator 8086.","topics":[],"score":211092,"global_rank":264435},{"name":"angle943/flutter-bmi","owner":"angle943","html_url":"https://github.com/angle943/flutter-bmi","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Dart","description":null,"topics":[],"score":211092,"global_rank":264441},{"name":"angle943/flutter-destini","owner":"angle943","html_url":"https://github.com/angle943/flutter-destini","stars":0,"forks":0,"watchers":0,"issues":0,"langu