ugmentation to do this and achieved a classification accuracy of 73% on the test set. ","topics":[],"score":2181,"global_rank":220320},{"name":"connoro7/shorts.sh","owner":"connoro7","html_url":"https://github.com/connoro7/shorts.sh","stars":0,"forks":0,"issues":0,"language":null,"description":"URL Shortener","topics":["shortener","url"],"score":2181,"global_rank":220324},{"name":"swapnilashtekar/forecast-doodle","owner":"swapnilashtekar","html_url":"https://github.com/swapnilashtekar/forecast-doodle","stars":0,"forks":0,"issues":0,"language":"Jupyter Notebook","description":null,"topics":[],"score":2181,"global_rank":220325},{"name":"andrewiggins/coop-coep-reporter-sample","owner":"andrewiggins","html_url":"https://github.com/andrewiggins/coop-coep-reporter-sample","stars":0,"forks":0,"issues":0,"language":"HTML","description":"Sample website demonstrating how the browser reports various COOP and COEP failures","topics":[],"score":2181,"global_rank":220326},{"name":"wellthathappened/Game-Project-Name","owner":"wellthathappened","html_url":"https://github.com/wellthathappened/Game-Project-Name","stars":0,"forks":0,"issues":0,"language":"C#","description":"whatevs","topics":[],"score":2181,"global_rank":220334},{"name":"Yelena1212/template-test","owner":"Yelena1212","html_url":"https://github.com/Yelena1212/template-test","stars":0,"forks":0,"issues":0,"language":"CSS","description":null,"topics":[],"score":2181,"global_rank":220336},{"name":"nitinkc/AsyncRestCalls","owner":"nitinkc","html_url":"https://github.com/nitinkc/AsyncRestCalls","stars":0,"forks":0,"issues":0,"language":null,"description":null,"topics":[],"score":2181,"global_rank":220338}]