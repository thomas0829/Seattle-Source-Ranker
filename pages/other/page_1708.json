pics":[],"score":186682,"global_rank":384242},{"name":"aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","owner":"aarivan","html_url":"https://github.com/aarivan/Causal-Discovery-between-Manufacturer-Retailer-price-channels","stars":0,"forks":0,"watchers":0,"issues":0,"language":"R","description":"Overview Identifying the strategy employed by business firms has motivated empirical research towards studying a firm\u2019s behavior. If there exists a specific pattern that can describe the interactions between the manufacturers and retailers, the application of causality analysis on their pricing interaction can clarify their strategic behavior. The interactions between the manufacturer and retailer can be discussed to follow a verticalintegrated system or Stackelberg leadership bilateral-monopoly model. In a vertical-integrated system, the manufacturer and retailer cooperate to maximize the profit of the distribution channel instead of individual profit. The important character of this model is that both the manufacturer and retailer affect the sales of the product.","topics":[],"score":186682,"global_rank":384244},{"name":"philnguyen/loop-cfa","owner":"philnguyen","html_url":"https://github.com/philnguyen/loop-cfa","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Racket","description":"Small model of static analysis that's only confused between different iterations of a loop","topics":[],"score":186682,"global_rank":384254},{"name":"pragya1990/wp","owner":"pragya1990","html_url":"https://github.com/pragya1990/wp","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":186676,"global_rank":384260},{"name":"pragya1990/wordpress-4.0-1","owner":"pragya1990","html_url":"https://github.com/pragya1990/wordpress-4.0-1","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":186676,"global_rank":384261},{"name":"mvrk/msreport","owner":"mvrk","html_url":"https://g