ank":318204},{"name":"polashrp/designer_maker","owner":"polashrp","html_url":"https://github.com/polashrp/designer_maker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"PHP","description":null,"topics":[],"score":197099,"global_rank":318212},{"name":"MaxMB15/Ocaml","owner":"MaxMB15","html_url":"https://github.com/MaxMB15/Ocaml","stars":0,"forks":0,"watchers":1,"issues":0,"language":"OCaml","description":"All my Ocaml files","topics":[],"score":197099,"global_rank":318221},{"name":"Jtfinlay/time-tracker-mobile","owner":"Jtfinlay","html_url":"https://github.com/Jtfinlay/time-tracker-mobile","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Dart","description":null,"topics":[],"score":197099,"global_rank":318227},{"name":"maringantis/Proxy-Cache-Server","owner":"maringantis","html_url":"https://github.com/maringantis/Proxy-Cache-Server","stars":0,"forks":0,"watchers":2,"issues":0,"language":"C","description":"Cache web proxy server is an intermediate server between the client and the main server. The proxy server is used to reduce the bandwidth, latency and the server load. The cache web proxy server caches the client\u2019s requests to the server. Each client request goes through the proxy server. The cache web proxy server responds to the client with the requested information if the files exist. If the cache web proxy doesn\u2019t host the requested information, it talks to the server and fetches the requested information. The subsequent requests to that file will be handled by the cache web proxy server instead of the main server hosting the files. The cache web proxy server fetches the files from the main server until its buffer runs out. The server then deletes the files to make space for the new files.","topics":[],"score":197098,"global_rank":318239},{"name":"marcdel/sentient_social","owner":"marcdel","html_url":"https://github.com/marcdel/sentient_social","stars":0,"forks":0,"watchers":0,"issues":34,"language":"Elixir","description":null,"topics"