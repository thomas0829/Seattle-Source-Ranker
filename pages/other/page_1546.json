[{"name":"dannywarren/WWW-Epguides","owner":"dannywarren","html_url":"https://github.com/dannywarren/WWW-Epguides","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Perl","description":"Repository for WWW::Epguides perl module","topics":[],"score":1922,"global_rank":346744},{"name":"maringantis/Interfacing-LCD-LPCXpresso-1769-SPI","owner":"maringantis","html_url":"https://github.com/maringantis/Interfacing-LCD-LPCXpresso-1769-SPI","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Interfacing Graphic LCD with LPCXpresso 1769 Using SPI","topics":[],"score":1922,"global_rank":346762},{"name":"maringantis/Interfacing-Flash-LPCXpresso-1769-SPI","owner":"maringantis","html_url":"https://github.com/maringantis/Interfacing-Flash-LPCXpresso-1769-SPI","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"Interfacing Flash Memory With LPCXpresso 1769 Using SPI","topics":[],"score":1922,"global_rank":346763},{"name":"maringantis/UDP-Socket-Throughput","owner":"maringantis","html_url":"https://github.com/maringantis/UDP-Socket-Throughput","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"The server should take 3 command line arguments: the port number from which it reads requests, the message size in bytes, and the sleep time in milliseconds. The server will read a message of the specified size from a client. After that, it will sleep for the specified amount of time (to simulate injected network latency) and then send an acknowledgment for the received message back to the client. Each client message will have a unique sequence number, which is included in the ack sent by the server. The server repeats this for 30 messages and then exit. The client will take 3 command line arguments: the IP address (or the host name) and port number of the server, and the message size in bytes. The client will write a message of the specified size to the server and wait for the ack from the server. The client will repeat this 30 times and keep track of the total amount of time spent on sending all the messages and receiving all the acks. It computes the throughput by: 30 * message_size_in_bytes / total_time_in_seconds and print the throughput value. After that, the client should exit.","topics":[],"score":1922,"global_rank":346764},{"name":"maringantis/TCP-Socket-data-transfer-no-limit","owner":"maringantis","html_url":"https://github.com/maringantis/TCP-Socket-data-transfer-no-limit","stars":0,"forks":0,"watchers":1,"issues":0,"language":"C","description":"TCP socket program with no limit data transfer from client to server.No FILES operations were used.","topics":[],"score":1922,"global_rank":346765},{"name":"flebel/particle-star-wars-hackathon","owner":"flebel","html_url":"https://github.com/flebel/particle-star-wars-hackathon","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Arduino","description":null,"topics":[],"score":1922,"global_rank":346769},{"name":"rsal91/ClearStyleApp","owner":"rsal91","html_url":"https://github.com/rsal91/ClearStyleApp","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Swift","description":null,"topics":[],"score":1922,"global_rank":346770},{"name":"merrillrudd/per_recruit","owner":"merrillrudd","html_url":"https://github.com/merrillrudd/per_recruit","stars":0,"forks":0,"watchers":1,"issues":0,"language":"R","description":null,"topics":[],"score":1922,"global_rank":346776},{"name":"therealfrs/fractalsimulation","owner":"therealfrs","html_url":"https://github.com/therealfrs/fractalsimulation","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Fortran","description":"Fractal generator using monte carlo simulation","topics":[],"score":1922,"global_rank":346777},{"name":"segerphilip/PoE","owner":"segerphilip","html_url":"https://github.com/segerphilip/PoE","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Arduino","description":"Arduino and other code for Principles of Engineering","topics":[],"score":1922,"global_rank":346781},{"na