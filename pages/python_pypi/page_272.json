[{"name":"flebel/django-robinson","owner":"flebel","html_url":"https://github.com/flebel/django-robinson","stars":5,"forks":0,"watchers":2,"issues":1,"language":"Python","description":"Robinson is a Django application that can be used as the underlying foundation for a project that stores references to JPEG files as model instances. Projects that make use of the files' EXIF metadata can benefit from Robinson's automatic import of EXIF metadata at the time the model is saved. Moreover, Robinson offers built-in geolocation utility methods as well as fully functional admin forms that make it trivial to geocode photos that are missing geolocation EXIF metadata. As of right now, this application forces every photo to have a location, either specified manually through the admin form or automatically imported from the file's EXIF metadata. There are future plans to make it suitable for less specific use cases.","topics":[],"score":243679,"global_rank":74735,"on_pypi":false,"top_pypi":false,"python_rank":13551},{"name":"himanshunaidu/ML_Pipeline_iOSPointMapper","owner":"himanshunaidu","html_url":"https://github.com/himanshunaidu/ML_Pipeline_iOSPointMapper","stars":1,"forks":0,"watchers":1,"issues":7,"language":"Python","description":"Machine Learning Pipeline for iOSPointMapper","topics":[],"score":243675,"global_rank":74742,"on_pypi":false,"top_pypi":false,"python_rank":13552},{"name":"brydavis/rental_db","owner":"brydavis","html_url":"https://github.com/brydavis/rental_db","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Simple Product Rental App","topics":[],"score":243672,"global_rank":74744,"on_pypi":false,"top_pypi":false,"python_rank":13553},{"name":"rina-reimer/byjus-capstones","owner":"rina-reimer","html_url":"https://github.com/rina-reimer/byjus-capstones","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"A collection of my capstone projects from BYJU's FutureSchool. Showcases proficiency in machine learni