igram\". Larger sizes are sometimes referred to by the value of n, e.g., \"four-gram\", \"five-gram\", and so on.","topics":[],"score":213247,"global_rank":252540,"on_pypi":false,"top_pypi":false,"python_rank":40973},{"name":"LauGds/Reeborg-s-World-Game","owner":"LauGds","html_url":"https://github.com/LauGds/Reeborg-s-World-Game","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Day-6","topics":[],"score":213239,"global_rank":252571,"on_pypi":false,"top_pypi":false,"python_rank":40974},{"name":"LauGds/password-generator","owner":"LauGds","html_url":"https://github.com/LauGds/password-generator","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Day-5","topics":[],"score":213239,"global_rank":252572,"on_pypi":false,"top_pypi":false,"python_rank":40975},{"name":"LauGds/rock-paper-scissors","owner":"LauGds","html_url":"https://github.com/LauGds/rock-paper-scissors","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Day-4","topics":[],"score":213239,"global_rank":252573,"on_pypi":false,"top_pypi":false,"python_rank":40976},{"name":"LJR41/practice_dojopets","owner":"LJR41","html_url":"https://github.com/LJR41/practice_dojopets","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":213239,"global_rank":252579,"on_pypi":false,"top_pypi":false,"python_rank":40977},{"name":"jhmartin/iptest-python","owner":"jhmartin","html_url":"https://github.com/jhmartin/iptest-python","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"DNS RR test container","topics":[],"score":213238,"global_rank":252587,"on_pypi":false,"top_pypi":false,"python_rank":40978},{"name":"Legoben/rss2yo","owner":"Legoben","html_url":"https://github.com/Legoben/rss2yo","stars":0,"forks":4,"watchers":0,"issues":0,"language":"Python","description":"Send subscribers a Yo when your RSS feed updates!","topics":[],"score":213236,"global_rank":252617,"on_pypi":