[{"name":"saransh2405/bi-gram-word-suggestion","owner":"saransh2405","html_url":"https://github.com/saransh2405/bi-gram-word-suggestion","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"In the fields of computational linguistics and probability, an n-gram is a contiguous sequence of n items from a given sequence of text or speech. The items can be phonemes, syllables, letters, words or base pairs according to the application. The n-grams typically are collected from a text or speech corpus. When the items are words, n-grams may also be called shingles.[1]  An n-gram of size 1 is referred to as a \"unigram\"; size 2 is a \"bigram\" (or, less commonly, a \"digram\"); size 3 is a \"trigram\". Larger sizes are sometimes referred to by the value of n, e.g., \"four-gram\", \"five-gram\", and so on.","topics":[],"score":229957,"global_rank":136321,"on_pypi":false,"top_pypi":false,"python_rank":22301},{"name":"jy492330/Tic-Tac-Toe","owner":"jy492330","html_url":"https://github.com/jy492330/Tic-Tac-Toe","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"A classic two player tic-tac-toe game board which can be played in the command-line. Key features of the game include a user-friendly visual guide of the game board displayed at every step, sound effects, random choice to select an initial player, and defensive programming.","topics":[],"score":229956,"global_rank":136324,"on_pypi":false,"top_pypi":false,"python_rank":22302},{"name":"brotheraaron/amiallergic","owner":"brotheraaron","html_url":"https://github.com/brotheraaron/amiallergic","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Trying this again in python this time","topics":[],"score":229956,"global_rank":136327,"on_pypi":false,"top_pypi":false,"python_rank":22303},{"name":"moltenform/kibo-python-task","owner":"moltenform","html_url":"https://github.com/moltenform/kibo-python-task","stars":0,"forks":0,"watchers":1,"issues":0,"lang