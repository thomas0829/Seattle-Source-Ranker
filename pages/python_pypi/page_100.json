rs":0,"issues":0,"language":"Python","description":"This honeypot is designed to listen on all TCP and UDP ports. It emulates the following services:  SSH (22/tcp) telnet (23/tcp) SMTP (25/tcp) HTTPS (443/tcp only) HTTP GET and CONNECT (on every other tcp port) SIP (5060/udp, with special support to detect sipvicious scans) Netis factory backdoor HTTP is autodetected by monitoring whether the first bytes sent by the client are either GET or CONNECT. In case of HTTP CONNECT requests, the emulated proxy always loops back to the honeypot itself.  Similarly, SSL/TLS is also autodetected by checking if the first bytes sent by the client look like the first bytes of the SSL Client Hello handshake message.  Any other unrecognized TCP connection or UDP packet is logged as-is in hexdump-like form.","topics":[],"score":299210,"global_rank":23128,"on_pypi":false,"top_pypi":false,"python_rank":4956},{"name":"aayushuppal/sappgen","owner":"aayushuppal","html_url":"https://github.com/aayushuppal/sappgen","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Python","description":"Simple App / WSGI Server App - Generator, Python","topics":[],"score":299210,"global_rank":30230,"on_pypi":true,"top_pypi":false,"python_rank":4957},{"name":"UWIT-IAM/uw-idp-custom","owner":"UWIT-IAM","html_url":"https://github.com/UWIT-IAM/uw-idp-custom","stars":0,"forks":0,"watchers":8,"issues":28,"language":"Python","description":"Local IdP configuration and etc customizations ","topics":[],"score":299205,"global_rank":23133,"on_pypi":false,"top_pypi":false,"python_rank":4958},{"name":"uw-it-aca/retention-dashboard","owner":"uw-it-aca","html_url":"https://github.com/uw-it-aca/retention-dashboard","stars":0,"forks":0,"watchers":9,"issues":22,"language":"Python","description":null,"topics":[],"score":299172,"global_rank":23149,"on_pypi":false,"top_pypi":false,"python_rank":4959},{"name":"vatsalcode/Satellite-Track","owner":"vatsalcode","html_url":"https://github.com/vatsalcode/Satellite-Track","stars":