y integrating the concepts of Automatic speech recognition, Artificial Intelligence, Natural Language Processing, and Interprocess communication. Having a robust assistant improves the time efficiency as well as reduces the efforts to perform simple repetitive tasks.","topics":[],"score":246618,"global_rank":68507,"on_pypi":false,"top_pypi":false,"python_rank":12522},{"name":"privatekenny/rotation","owner":"privatekenny","html_url":"https://github.com/privatekenny/rotation","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":246609,"global_rank":68521,"on_pypi":false,"top_pypi":false,"python_rank":12523},{"name":"rohit180497/Data-Encryption-Web-App","owner":"rohit180497","html_url":"https://github.com/rohit180497/Data-Encryption-Web-App","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":246600,"global_rank":68540,"on_pypi":false,"top_pypi":false,"python_rank":12524},{"name":"viking-sudo-rm/TAGParserDemo","owner":"viking-sudo-rm","html_url":"https://github.com/viking-sudo-rm/TAGParserDemo","stars":1,"forks":1,"watchers":4,"issues":4,"language":"Python","description":"Web demo for Tree Adjoining Grammar parser.","topics":["machine-learning","nlp","tree-adjoining-grammar"],"score":246600,"global_rank":68542,"on_pypi":false,"top_pypi":false,"python_rank":12525},{"name":"DinoV/pythoncapi","owner":"DinoV","html_url":"https://github.com/DinoV/pythoncapi","stars":1,"forks":1,"watchers":0,"issues":1,"language":"Python","description":null,"topics":[],"score":246598,"global_rank":68548,"on_pypi":false,"top_pypi":false,"python_rank":12526},{"name":"anyweez/regis","owner":"anyweez","html_url":"https://github.com/anyweez/regis","stars":6,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":246596,"global_rank":68551,"on_pypi":false,"top_pypi":false,"python_rank":12527},{"name":"algorithmiaio/algorithmia-bench","owner":"algorithmiaio","htm