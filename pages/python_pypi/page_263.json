ion":"Robinson is a Django application that can be used as the underlying foundation for a project that stores references to JPEG files as model instances. Projects that make use of the files' EXIF metadata can benefit from Robinson's automatic import of EXIF metadata at the time the model is saved. Moreover, Robinson offers built-in geolocation utility methods as well as fully functional admin forms that make it trivial to geocode photos that are missing geolocation EXIF metadata. As of right now, this application forces every photo to have a location, either specified manually through the admin form or automatically imported from the file's EXIF metadata. There are future plans to make it suitable for less specific use cases.","topics":[],"score":244254,"global_rank":73488,"on_pypi":false,"top_pypi":false,"python_rank":13112},{"name":"blake5634/iscrape","owner":"blake5634","html_url":"https://github.com/blake5634/iscrape","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"customizable job listing scraper for Indeed","topics":[],"score":244247,"global_rank":73495,"on_pypi":false,"top_pypi":false,"python_rank":13113},{"name":"michaelthoreau/projectkiwi3-client","owner":"michaelthoreau","html_url":"https://github.com/michaelthoreau/projectkiwi3-client","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":244247,"global_rank":73501,"on_pypi":false,"top_pypi":false,"python_rank":13114},{"name":"bdpedigo/maps","owner":"bdpedigo","html_url":"https://github.com/bdpedigo/maps","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":244242,"global_rank":73504,"on_pypi":false,"top_pypi":false,"python_rank":13115},{"name":"Parallels/pd-ai-agent-core-agents","owner":"Parallels","html_url":"https://github.com/Parallels/pd-ai-agent-core-agents","stars":0,"forks":0,"watchers":4,"issues":0,"language":"Python","description":null,"topics":[],"score":244230,"gl