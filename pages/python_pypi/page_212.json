erforms better than the widely used activation functions in text classification application.","topics":[],"score":254309,"global_rank":57866,"on_pypi":false,"top_pypi":false,"python_rank":10593},{"name":"praeclarum/alang","owner":"praeclarum","html_url":"https://github.com/praeclarum/alang","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"A programming language specializing in cross-compiling to lots of other languages","topics":[],"score":254305,"global_rank":57874,"on_pypi":false,"top_pypi":false,"python_rank":10594},{"name":"jeffeverett/robinhood-git-hook","owner":"jeffeverett","html_url":"https://github.com/jeffeverett/robinhood-git-hook","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Incentivize frequent commits by displaying Robinhood positions and portfolio value after every commit.","topics":[],"score":254302,"global_rank":57878,"on_pypi":false,"top_pypi":false,"python_rank":10595},{"name":"rSchleckser/QuizMate","owner":"rSchleckser","html_url":"https://github.com/rSchleckser/QuizMate","stars":0,"forks":0,"watchers":1,"issues":1,"language":"Python","description":null,"topics":[],"score":254302,"global_rank":57880,"on_pypi":false,"top_pypi":false,"python_rank":10596},{"name":"tejasgn1/llm_evaluation","owner":"tejasgn1","html_url":"https://github.com/tejasgn1/llm_evaluation","stars":0,"forks":1,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":254301,"global_rank":57882,"on_pypi":false,"top_pypi":false,"python_rank":10597},{"name":"maximusjstevens/ATL_masschange","owner":"maximusjstevens","html_url":"https://github.com/maximusjstevens/ATL_masschange","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Code used to develop the ICESat-2 mass change product (climate data processing, configure/run CFM, grid outputs, etc.)","topics":[],"score":254299,"global_rank":57883,"on_pypi":false,"top_pypi":false,"python_rank":10598},{"name":"jspaezp/elfra