s://github.com/arjunhmalhotra/clockarithmetic","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This simple program computes clock arithmetic as a function of two user formatted input prompts. The program splits up the entered time stamps and separates the hour, minute, and second inputs respectively from both user inputs. A range on the timestamps is a redundant restriction in the algorithm due to the nature of the input -- owing to the fact that no clock displays seconds and minutes higher than an increment of 60 and hours in that of 24. The program accounts for the 'overflow' of seconds into minutes, minutes into hours, and hours into the time on the next day.","topics":[],"score":207656,"global_rank":287180,"on_pypi":false,"top_pypi":false,"python_rank":44427},{"name":"arjunhmalhotra/securitylights-cycles","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/securitylights-cycles","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This program checks whether two security lights are on at a certain time, given certain on-off cycles. ","topics":[],"score":207656,"global_rank":287181,"on_pypi":false,"top_pypi":false,"python_rank":44428},{"name":"trevorbye/azure_sentiment_analysis","owner":"trevorbye","html_url":"https://github.com/trevorbye/azure_sentiment_analysis","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Testing Python API","topics":[],"score":207656,"global_rank":287183,"on_pypi":false,"top_pypi":false,"python_rank":44429},{"name":"aashaar/Neural-Network","owner":"aashaar","html_url":"https://github.com/aashaar/Neural-Network","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"A Python program to implement Neural Network (NN) having two hidden layers","topics":[],"score":207656,"global_rank":287199,"on_pypi":false,"top_pypi":false,"python_rank":44430},{"name":"kurtrm/gas_usage_calculator","owner":"kurtrm","html_url":"https