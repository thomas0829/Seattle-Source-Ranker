ured and the images in the database).","topics":[],"score":287506,"global_rank":28731,"on_pypi":false,"top_pypi":false,"python_rank":5865},{"name":"nick-terry/Splitting-GP","owner":"nick-terry","html_url":"https://github.com/nick-terry/Splitting-GP","stars":4,"forks":0,"watchers":2,"issues":0,"language":"Python","description":"Implementation and experiments for the Splitting GP model","topics":[],"score":287493,"global_rank":28739,"on_pypi":false,"top_pypi":false,"python_rank":5866},{"name":"zaro0508/sceptre-identity-resolver","owner":"zaro0508","html_url":"https://github.com/zaro0508/sceptre-identity-resolver","stars":4,"forks":1,"watchers":1,"issues":1,"language":"Python","description":"A set of Sceptre resolvers to help identify a stack","topics":[],"score":287492,"global_rank":28740,"on_pypi":false,"top_pypi":false,"python_rank":5867},{"name":"renysaldivar/Charms","owner":"renysaldivar","html_url":"https://github.com/renysaldivar/Charms","stars":3,"forks":1,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":287482,"global_rank":28743,"on_pypi":false,"top_pypi":false,"python_rank":5868},{"name":"chadduffey/pdf2john","owner":"chadduffey","html_url":"https://github.com/chadduffey/pdf2john","stars":4,"forks":3,"watchers":2,"issues":0,"language":"Python","description":"copy of the pdf2john app","topics":[],"score":287480,"global_rank":28745,"on_pypi":false,"top_pypi":false,"python_rank":5869},{"name":"wesleybeckner/mintdash","owner":"wesleybeckner","html_url":"https://github.com/wesleybeckner/mintdash","stars":2,"forks":2,"watchers":1,"issues":0,"language":"Python","description":"a minty dashboard!","topics":[],"score":287471,"global_rank":28750,"on_pypi":false,"top_pypi":false,"python_rank":5870},{"name":"Sage-Bionetworks/aws-alb-synapse-oidc","owner":"Sage-Bionetworks","html_url":"https://github.com/Sage-Bionetworks/aws-alb-synapse-oidc","stars":2,"forks":1,"watchers":3,"issues":0,"language":"Python","description":"Set up an AWS load