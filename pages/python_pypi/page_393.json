ome if any one of the characters at those indices are removed.","topics":[],"score":229644,"global_rank":113500,"on_pypi":false,"top_pypi":false,"python_rank":19645},{"name":"apc518/ffall","owner":"apc518","html_url":"https://github.com/apc518/ffall","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Python","description":"apply an ffmpeg command to all files of a certain type in a directory","topics":[],"score":229639,"global_rank":113512,"on_pypi":false,"top_pypi":false,"python_rank":19646},{"name":"baryhuang/metis-ai-services","owner":"baryhuang","html_url":"https://github.com/baryhuang/metis-ai-services","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":229639,"global_rank":113513,"on_pypi":false,"top_pypi":false,"python_rank":19647},{"name":"thenunachi/music","owner":"thenunachi","html_url":"https://github.com/thenunachi/music","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":229635,"global_rank":113516,"on_pypi":false,"top_pypi":false,"python_rank":19648},{"name":"EyasR/template","owner":"EyasR","html_url":"https://github.com/EyasR/template","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":229627,"global_rank":113533,"on_pypi":false,"top_pypi":false,"python_rank":19649},{"name":"tyfiero/crewai_hackathon","owner":"tyfiero","html_url":"https://github.com/tyfiero/crewai_hackathon","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":229627,"global_rank":113540,"on_pypi":false,"top_pypi":false,"python_rank":19650}]