he string will still be a palindrome if any one of the characters at those indices are removed.","topics":[],"score":229698,"global_rank":113301,"on_pypi":false,"top_pypi":false,"python_rank":19644},{"name":"AcroMace/whistlesheet","owner":"AcroMace","html_url":"https://github.com/AcroMace/whistlesheet","stars":2,"forks":0,"watchers":2,"issues":0,"language":"Python","description":"Turn whistles into sheet music","topics":[],"score":229691,"global_rank":113311,"on_pypi":false,"top_pypi":false,"python_rank":19645},{"name":"hparik11/Flappy_Bird_Game","owner":"hparik11","html_url":"https://github.com/hparik11/Flappy_Bird_Game","stars":2,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"A Flappy Bird Clone in Python","topics":[],"score":229683,"global_rank":113322,"on_pypi":false,"top_pypi":false,"python_rank":19646},{"name":"amerigirl/Midterm-Fandango-Clone","owner":"amerigirl","html_url":"https://github.com/amerigirl/Midterm-Fandango-Clone","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":229682,"global_rank":113330,"on_pypi":false,"top_pypi":false,"python_rank":19647},{"name":"fightforhash/PythonOthello","owner":"fightforhash","html_url":"https://github.com/fightforhash/PythonOthello","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Othello Game Python(Group of 5)","topics":[],"score":229682,"global_rank":113342,"on_pypi":false,"top_pypi":false,"python_rank":19648},{"name":"fightforhash/CoinCalculator","owner":"fightforhash","html_url":"https://github.com/fightforhash/CoinCalculator","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"H-Mart Coin Calculator","topics":[],"score":229682,"global_rank":113343,"on_pypi":false,"top_pypi":false,"python_rank":19649},{"name":"Tatianaob/dsa-mini-library","owner":"Tatianaob","html_url":"https://github.com/Tatianaob/dsa-mini-library","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","descr