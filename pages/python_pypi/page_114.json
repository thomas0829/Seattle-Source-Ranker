 71.35% average IoU on the test set.","topics":[],"score":289466,"global_rank":27207,"on_pypi":false,"top_pypi":false,"python_rank":5680},{"name":"dmarx/TextSummarization","owner":"dmarx","html_url":"https://github.com/dmarx/TextSummarization","stars":8,"forks":2,"watchers":1,"issues":0,"language":"Python","description":"Simple text LexRank text summarization in python","topics":[],"score":289450,"global_rank":27214,"on_pypi":false,"top_pypi":false,"python_rank":5681},{"name":"FredHutch/nextflow-aws-batch-squared","owner":"FredHutch","html_url":"https://github.com/FredHutch/nextflow-aws-batch-squared","stars":10,"forks":3,"watchers":8,"issues":4,"language":"Python","description":"Run Nextflow on AWS Batch (Squared)","topics":[],"score":289444,"global_rank":27216,"on_pypi":false,"top_pypi":false,"python_rank":5682},{"name":"psrc/geocoding-services","owner":"psrc","html_url":"https://github.com/psrc/geocoding-services","stars":0,"forks":0,"watchers":0,"issues":1,"language":"Python","description":null,"topics":[],"score":289408,"global_rank":27224,"on_pypi":false,"top_pypi":false,"python_rank":5683},{"name":"filipecalasans/mlp","owner":"filipecalasans","html_url":"https://github.com/filipecalasans/mlp","stars":14,"forks":5,"watchers":1,"issues":2,"language":"Python","description":"Multilayer Perceptron Implementation in Python","topics":["machine-learning","mlp","neural-network"],"score":289387,"global_rank":27234,"on_pypi":false,"top_pypi":false,"python_rank":5684},{"name":"AllenInstitute/Contrast_Analysis","owner":"AllenInstitute","html_url":"https://github.com/AllenInstitute/Contrast_Analysis","stars":3,"forks":2,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":289382,"global_rank":27239,"on_pypi":false,"top_pypi":false,"python_rank":5685},{"name":"bashmohandes/ProjectEuler","owner":"bashmohandes","html_url":"https://github.com/bashmohandes/ProjectEuler","stars":8,"forks":2,"watchers":2,"issues":0,"language":"Python","description":"