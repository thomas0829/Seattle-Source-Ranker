[{"name":"lordlosslyy/Semantic-Segmentation-CNN-for-India-Driving-Dataset","owner":"lordlosslyy","html_url":"https://github.com/lordlosslyy/Semantic-Segmentation-CNN-for-India-Driving-Dataset","stars":5,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"We use deep convolutional neural networks to experiment semantic segmentation task on India Driving Dataset. We use pixel accuracy and Intersection-Over-Union as the evaluation metrics and experiment different kinds of methods, including weighted loss, data augmentation, transfer learning, and U-Net architecture. Weighted loss method achieved 61.07% average IoU and data augmentation method with rotated and cropped images achieved 63.73% IoU. However, it largely increases the training time. Using the transfer learning VGG, we achieve 73.74% average pixel accuracy and 58.45% average IoU on the test set. In addition, we achieve 78.03% average test pixel accuracy and 64.04% average test IoU by the method of U-Net. Finally, we build a new model named Mobile-Deeplabv3+, and we achieved 83.56% average pixel accuracy and 71.35% average IoU on the test set.","topics":[],"score":288736,"global_rank":27624,"on_pypi":false,"top_pypi":false,"python_rank":5651},{"name":"smfxfc/FighterFactBot","owner":"smfxfc","html_url":"https://github.com/smfxfc/FighterFactBot","stars":3,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Reddit bot to deliver MMA fighter stats when called by a user. ","topics":[],"score":288733,"global_rank":27626,"on_pypi":false,"top_pypi":false,"python_rank":5652},{"name":"algorithmiaio/algorithmia-modeldeployment-action","owner":"algorithmiaio","html_url":"https://github.com/algorithmiaio/algorithmia-modeldeployment-action","stars":5,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Algorithmia Github Action capable of running Jupyter notebooks to create the ML model, uploading the model and updating the algorithm at Algorithmia","topics":["algorithmia","c