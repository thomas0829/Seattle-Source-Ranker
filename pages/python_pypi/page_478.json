lass exercises, and programming assignments.","topics":[],"score":228029,"global_rank":146824,"on_pypi":false,"top_pypi":false,"python_rank":23888},{"name":"saulthebear/insertion_sort","owner":"saulthebear","html_url":"https://github.com/saulthebear/insertion_sort","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"GA W11D4 HW - Python Insertion Sort & Bracket Matcher","topics":[],"score":228028,"global_rank":146839,"on_pypi":false,"top_pypi":false,"python_rank":23889},{"name":"manrit/TikTacToe","owner":"manrit","html_url":"https://github.com/manrit/TikTacToe","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":228028,"global_rank":146844,"on_pypi":false,"top_pypi":false,"python_rank":23890},{"name":"galenscovell/CS61A","owner":"galenscovell","html_url":"https://github.com/galenscovell/CS61A","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"UC Berkeley, Structure and Interpretation of Computer Programs","topics":[],"score":228027,"global_rank":146850,"on_pypi":false,"top_pypi":false,"python_rank":23891},{"name":"schlarpc/packmodule","owner":"schlarpc","html_url":"https://github.com/schlarpc/packmodule","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Python code packer for AWS Lambda","topics":[],"score":228024,"global_rank":239674,"on_pypi":true,"top_pypi":false,"python_rank":23892},{"name":"Mikey-Simmons/alien_invasion","owner":"Mikey-Simmons","html_url":"https://github.com/Mikey-Simmons/alien_invasion","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Alien Invasion Game. Made with pygame.","topics":[],"score":228023,"global_rank":146865,"on_pypi":false,"top_pypi":false,"python_rank":23893},{"name":"marvincolgin/microservice-api-docker","owner":"marvincolgin","html_url":"https://github.com/marvincolgin/microservice-api-docker","stars":1,"forks":0,"watchers":0,"issues":7,"language":"Python","descrip