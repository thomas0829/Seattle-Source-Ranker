dules in Python-Pandas, NumPy, Scikit-Learn, matplotlib, Imbalanced-learn","topics":[],"score":234553,"global_rank":95391,"on_pypi":false,"top_pypi":false,"python_rank":16659},{"name":"AndrewMitchell25/Beaver","owner":"AndrewMitchell25","html_url":"https://github.com/AndrewMitchell25/Beaver","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":234541,"global_rank":95414,"on_pypi":false,"top_pypi":false,"python_rank":16660},{"name":"orangatun/nlp-table-questioning","owner":"orangatun","html_url":"https://github.com/orangatun/nlp-table-questioning","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"NLP table questioning using Python","topics":[],"score":234541,"global_rank":95418,"on_pypi":false,"top_pypi":false,"python_rank":16661},{"name":"Ugo-Obiako/py-code-practice","owner":"Ugo-Obiako","html_url":"https://github.com/Ugo-Obiako/py-code-practice","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":234541,"global_rank":95420,"on_pypi":false,"top_pypi":false,"python_rank":16662},{"name":"sarthak7awasthi/face-detection","owner":"sarthak7awasthi","html_url":"https://github.com/sarthak7awasthi/face-detection","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":234541,"global_rank":95425,"on_pypi":false,"top_pypi":false,"python_rank":16663},{"name":"liamkirkpatrick/ALHIC228_4-study","owner":"liamkirkpatrick","html_url":"https://github.com/liamkirkpatrick/ALHIC228_4-study","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Code for analysis of ALHIC228_4. Includes ECM, Water Isotope, Coulter Counter, IC, and ICPMS data.","topics":[],"score":234541,"global_rank":95429,"on_pypi":false,"top_pypi":false,"python_rank":16664},{"name":"rendon/ands","owner":"rendon","html_url":"https://github.com/rendon/ands","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","de