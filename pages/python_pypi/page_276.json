[{"name":"johnnyodonnell/python-send-tcp-in-one-datagram","owner":"johnnyodonnell","html_url":"https://github.com/johnnyodonnell/python-send-tcp-in-one-datagram","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Send a TCP request in one IP datagram","topics":[],"score":243509,"global_rank":100431,"on_pypi":true,"top_pypi":false,"python_rank":13751},{"name":"flebel/django-robinson","owner":"flebel","html_url":"https://github.com/flebel/django-robinson","stars":5,"forks":0,"watchers":2,"issues":1,"language":"Python","description":"Robinson is a Django application that can be used as the underlying foundation for a project that stores references to JPEG files as model instances. Projects that make use of the files' EXIF metadata can benefit from Robinson's automatic import of EXIF metadata at the time the model is saved. Moreover, Robinson offers built-in geolocation utility methods as well as fully functional admin forms that make it trivial to geocode photos that are missing geolocation EXIF metadata. As of right now, this application forces every photo to have a location, either specified manually through the admin form or automatically imported from the file's EXIF metadata. There are future plans to make it suitable for less specific use cases.","topics":[],"score":243507,"global_rank":75744,"on_pypi":false,"top_pypi":false,"python_rank":13752},{"name":"mhbrewer/IzzysWebsite","owner":"mhbrewer","html_url":"https://github.com/mhbrewer/IzzysWebsite","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"This is a website for my friend's coffee shop.","topics":[],"score":243494,"global_rank":75757,"on_pypi":false,"top_pypi":false,"python_rank":13753},{"name":"Phillyclause89/ISO-8601_time_converter","owner":"Phillyclause89","html_url":"https://github.com/Phillyclause89/ISO-8601_time_converter","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"A simple time conversion function written in