ogy combines lectures, in-class and out-of-class exercises, and programming assignments.","topics":[],"score":227659,"global_rank":117446,"on_pypi":false,"top_pypi":false,"python_rank":20275},{"name":"codynhat/mmpool","owner":"codynhat","html_url":"https://github.com/codynhat/mmpool","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":227646,"global_rank":117461,"on_pypi":false,"top_pypi":false,"python_rank":20276},{"name":"colobas/obras","owner":"colobas","html_url":"https://github.com/colobas/obras","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"hard difficult expert very tough","topics":[],"score":227646,"global_rank":117463,"on_pypi":false,"top_pypi":false,"python_rank":20277},{"name":"izhangzhihao/zhwiki-word2vec","owner":"izhangzhihao","html_url":"https://github.com/izhangzhihao/zhwiki-word2vec","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":227646,"global_rank":117464,"on_pypi":false,"top_pypi":false,"python_rank":20278},{"name":"mohsafwat23/ME439MobileRobotEKF","owner":"mohsafwat23","html_url":"https://github.com/mohsafwat23/ME439MobileRobotEKF","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":227643,"global_rank":117468,"on_pypi":false,"top_pypi":false,"python_rank":20279},{"name":"gartician/snakemake-teaching-example","owner":"gartician","html_url":"https://github.com/gartician/snakemake-teaching-example","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":227642,"global_rank":117469,"on_pypi":false,"top_pypi":false,"python_rank":20280},{"name":"tverghis/learning_ebpf","owner":"tverghis","html_url":"https://github.com/tverghis/learning_ebpf","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Working through \"Learning eBPF\" by Liz Rice","topics":[],"score":227642,"global_rank":117471,"on_