e form.","topics":[],"score":304283,"global_rank":20867,"on_pypi":false,"top_pypi":false,"python_rank":4441},{"name":"nrbennet/quiver","owner":"nrbennet","html_url":"https://github.com/nrbennet/quiver","stars":4,"forks":3,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":304283,"global_rank":20868,"on_pypi":false,"top_pypi":false,"python_rank":4442},{"name":"awslabs/observation-extractor","owner":"awslabs","html_url":"https://github.com/awslabs/observation-extractor","stars":4,"forks":1,"watchers":1,"issues":1,"language":"Python","description":null,"topics":[],"score":304265,"global_rank":20876,"on_pypi":false,"top_pypi":false,"python_rank":4443},{"name":"miloprice/gpt3-discord-bot","owner":"miloprice","html_url":"https://github.com/miloprice/gpt3-discord-bot","stars":4,"forks":2,"watchers":1,"issues":4,"language":"Python","description":"A discord bot that uses the OpenAI API to generate responses.","topics":["discord-bot","gpt"],"score":304261,"global_rank":20880,"on_pypi":false,"top_pypi":false,"python_rank":4444},{"name":"nowei/advent-of-code","owner":"nowei","html_url":"https://github.com/nowei/advent-of-code","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":304207,"global_rank":20898,"on_pypi":false,"top_pypi":false,"python_rank":4445},{"name":"loydp/Advent_of_Code","owner":"loydp","html_url":"https://github.com/loydp/Advent_of_Code","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":304207,"global_rank":20899,"on_pypi":false,"top_pypi":false,"python_rank":4446},{"name":"f5devcentral/f5xc-shop-demo","owner":"f5devcentral","html_url":"https://github.com/f5devcentral/f5xc-shop-demo","stars":10,"forks":9,"watchers":3,"issues":10,"language":"Python","description":null,"topics":[],"score":304204,"global_rank":20900,"on_pypi":false,"top_pypi":false,"python_rank":4447},{"name":"georgevreilly/adventofcode","owner":"georgevreilly","h