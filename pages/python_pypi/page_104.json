icious scans) Netis factory backdoor HTTP is autodetected by monitoring whether the first bytes sent by the client are either GET or CONNECT. In case of HTTP CONNECT requests, the emulated proxy always loops back to the honeypot itself.  Similarly, SSL/TLS is also autodetected by checking if the first bytes sent by the client look like the first bytes of the SSL Client Hello handshake message.  Any other unrecognized TCP connection or UDP packet is logged as-is in hexdump-like form.","topics":[],"score":298462,"global_rank":23646,"on_pypi":false,"top_pypi":false,"python_rank":5161},{"name":"khodges42/Etrata","owner":"khodges42","html_url":"https://github.com/khodges42/Etrata","stars":6,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"CI Vuln Scanner","topics":[],"score":298416,"global_rank":23673,"on_pypi":false,"top_pypi":false,"python_rank":5162},{"name":"tdeason416/pitchbook","owner":"tdeason416","html_url":"https://github.com/tdeason416/pitchbook","stars":7,"forks":3,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":298414,"global_rank":23675,"on_pypi":false,"top_pypi":false,"python_rank":5163},{"name":"allenai/pipette","owner":"allenai","html_url":"https://github.com/allenai/pipette","stars":4,"forks":1,"watchers":5,"issues":0,"language":"Python","description":"Experiment workflows for Python","topics":[],"score":298393,"global_rank":23683,"on_pypi":false,"top_pypi":false,"python_rank":5164},{"name":"allenai/mcp-tool-eval","owner":"allenai","html_url":"https://github.com/allenai/mcp-tool-eval","stars":4,"forks":1,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":298382,"global_rank":23690,"on_pypi":false,"top_pypi":false,"python_rank":5165},{"name":"ridha/logviewer","owner":"ridha","html_url":"https://github.com/ridha/logviewer","stars":8,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Logviewer allows you to tail files to the web","topics":[],"score":2983