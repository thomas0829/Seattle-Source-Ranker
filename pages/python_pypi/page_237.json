rred that all the three parallel architectures have higher performance when compared with the existing classification systems. Also, our IELU performs better than the widely used activation functions in text classification application.","topics":[],"score":250750,"global_rank":60643,"on_pypi":false,"top_pypi":false,"python_rank":11832},{"name":"tejasai97/Yelp_Review_Classifier","owner":"tejasai97","html_url":"https://github.com/tejasai97/Yelp_Review_Classifier","stars":4,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Classification of Yelp Reviews into 1 star or 5 star categories based off the text content in the reviews.","topics":["kaggle","naive-bayes-classifier","nlp","nltk","python","python3","scikit-learn","scikitlearn-machine-learning","yelp","yelp-dataset"],"score":250749,"global_rank":60646,"on_pypi":false,"top_pypi":false,"python_rank":11833},{"name":"datatalking/csv_to_SQL_python","owner":"datatalking","html_url":"https://github.com/datatalking/csv_to_SQL_python","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"CSV_to_SQL converter SQL server","topics":[],"score":250747,"global_rank":60651,"on_pypi":false,"top_pypi":false,"python_rank":11834},{"name":"griffinpj/csv-column-replace","owner":"griffinpj","html_url":"https://github.com/griffinpj/csv-column-replace","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":250747,"global_rank":60652,"on_pypi":false,"top_pypi":false,"python_rank":11835},{"name":"erickb336/sagemaker-core-old","owner":"erickb336","html_url":"https://github.com/erickb336/sagemaker-core-old","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":250745,"global_rank":60654,"on_pypi":false,"top_pypi":false,"python_rank":11836},{"name":"sumitdvlp/AMIL-Feature-GUI-Tool","owner":"sumitdvlp","html_url":"https://github.com/sumitdvlp/AMIL-Feature-GUI-Tool","stars":1,"forks":0,"watchers":0,"issues":