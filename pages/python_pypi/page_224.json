otal probability of each Ngram to be written by the particular author in the email.","topics":[],"score":256553,"global_rank":55473,"on_pypi":false,"top_pypi":false,"python_rank":11165},{"name":"harvimt/steam_launcher","owner":"harvimt","html_url":"https://github.com/harvimt/steam_launcher","stars":5,"forks":1,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":256538,"global_rank":55484,"on_pypi":false,"top_pypi":false,"python_rank":11166},{"name":"LionKimbro/chassis2024","owner":"LionKimbro","html_url":"https://github.com/LionKimbro/chassis2024","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"a flexible chassis for assembling Python programs from parts","topics":[],"score":256530,"global_rank":76396,"on_pypi":true,"top_pypi":false,"python_rank":11167},{"name":"kehrl/big3","owner":"kehrl","html_url":"https://github.com/kehrl/big3","stars":4,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Scripts and libraries for investigating changes in ice dynamics at Helheim and Kangerlussuaq Glaciers, SE Greenland, using satellite observations and numerical models.","topics":["fortran","python"],"score":256528,"global_rank":55497,"on_pypi":false,"top_pypi":false,"python_rank":11168},{"name":"KevinXuxuxu/mini_c_compiler","owner":"KevinXuxuxu","html_url":"https://github.com/KevinXuxuxu/mini_c_compiler","stars":2,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Practicing project inspired by https://www.destroyallsoftware.com/screencasts/catalog/a-compiler-from-scratch","topics":[],"score":256527,"global_rank":55498,"on_pypi":false,"top_pypi":false,"python_rank":11169},{"name":"aadityaanaik/Mass-Email-Careershift-Contacts","owner":"aadityaanaik","html_url":"https://github.com/aadityaanaik/Mass-Email-Careershift-Contacts","stars":2,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":256522,"global_rank":55499,"on_pypi":false,"top_pypi":fals