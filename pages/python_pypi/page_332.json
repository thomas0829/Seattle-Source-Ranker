 the following modules in Python-Pandas, NumPy, Scikit-Learn, matplotlib, Imbalanced-learn","topics":[],"score":234909,"global_rank":95688,"on_pypi":false,"top_pypi":false,"python_rank":16594},{"name":"andymotta/ansible-iam-key-rotation","owner":"andymotta","html_url":"https://github.com/andymotta/ansible-iam-key-rotation","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Ansible Role to do Boto3 IAM Key Rotation on Target EC2 Instance","topics":["ansible","devops-tools","iam","python","sysadmin"],"score":234902,"global_rank":95691,"on_pypi":false,"top_pypi":false,"python_rank":16595},{"name":"aaronsteers/SimplerData","owner":"aaronsteers","html_url":"https://github.com/aaronsteers/SimplerData","stars":0,"forks":1,"watchers":1,"issues":4,"language":"Python","description":"\"Everything should be made as simple as possible, and no simpler.\" - Albert Einstein","topics":[],"score":234895,"global_rank":95702,"on_pypi":false,"top_pypi":false,"python_rank":16596},{"name":"Cam1337/SublimeText","owner":"Cam1337","html_url":"https://github.com/Cam1337/SublimeText","stars":3,"forks":0,"watchers":2,"issues":0,"language":"Python","description":"Sublime Text Plugins","topics":[],"score":234890,"global_rank":95706,"on_pypi":false,"top_pypi":false,"python_rank":16597},{"name":"Sage-Bionetworks/synapsegenie-example-registry","owner":"Sage-Bionetworks","html_url":"https://github.com/Sage-Bionetworks/synapsegenie-example-registry","stars":0,"forks":0,"watchers":5,"issues":0,"language":"Python","description":null,"topics":[],"score":234888,"global_rank":95708,"on_pypi":false,"top_pypi":false,"python_rank":16598},{"name":"brianwright2/isolation_forest","owner":"brianwright2","html_url":"https://github.com/brianwright2/isolation_forest","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Implementation of isolation forest algorithm in Python","topics":[],"score":234887,"global_rank":95709,"on_pypi":false,"top_pypi":false,"python_ra