ciency as well as reduces the efforts to perform simple repetitive tasks.","topics":[],"score":246022,"global_rank":69888,"on_pypi":false,"top_pypi":false,"python_rank":12598},{"name":"ZyTnT/Django-sample-userAuth","owner":"ZyTnT","html_url":"https://github.com/ZyTnT/Django-sample-userAuth","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":246022,"global_rank":69890,"on_pypi":false,"top_pypi":false,"python_rank":12599},{"name":"kamal-hamza/Carpool","owner":"kamal-hamza","html_url":"https://github.com/kamal-hamza/Carpool","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Carpool Website with Django","topics":[],"score":246022,"global_rank":69893,"on_pypi":false,"top_pypi":false,"python_rank":12600}]