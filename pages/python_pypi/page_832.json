[{"name":"arjunhmalhotra/fibonaccispirals","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/fibonaccispirals","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This program draws a fibonacci spiral through a graphical rectangle building program that creates every next rectangle as big as the cumulative sum of the areas of the rectangles already drawn.","topics":[],"score":209298,"global_rank":283200,"on_pypi":false,"top_pypi":false,"python_rank":41551},{"name":"arjunhmalhotra/clockarithmetic","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/clockarithmetic","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This simple program computes clock arithmetic as a function of two user formatted input prompts. The program splits up the entered time stamps and separates the hour, minute, and second inputs respectively from both user inputs. A range on the timestamps is a redundant restriction in the algorithm due to the nature of the input -- owing to the fact that no clock displays seconds and minutes higher than an increment of 60 and hours in that of 24. The program accounts for the 'overflow' of seconds into minutes, minutes into hours, and hours into the time on the next day.","topics":[],"score":209298,"global_rank":283201,"on_pypi":false,"top_pypi":false,"python_rank":41552},{"name":"arjunhmalhotra/securitylights-cycles","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/securitylights-cycles","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This program checks whether two security lights are on at a certain time, given certain on-off cycles. ","topics":[],"score":209298,"global_rank":283202,"on_pypi":false,"top_pypi":false,"python_rank":41553},{"name":"muniri92/leap_motion_python","owner":"muniri92","html_url":"https://github.com/muniri92/leap_motion_python","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Pytho