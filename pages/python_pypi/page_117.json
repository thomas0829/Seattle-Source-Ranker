[{"name":"SaloniDash7/McCulloch-Pitts-Animation","owner":"SaloniDash7","html_url":"https://github.com/SaloniDash7/McCulloch-Pitts-Animation","stars":4,"forks":2,"watchers":0,"issues":0,"language":"Python","description":"Python animation illustrating the McCulloch Pitts model of the neuron","topics":[],"score":289182,"global_rank":27856,"on_pypi":false,"top_pypi":false,"python_rank":5801},{"name":"lordlosslyy/Semantic-Segmentation-CNN-for-India-Driving-Dataset","owner":"lordlosslyy","html_url":"https://github.com/lordlosslyy/Semantic-Segmentation-CNN-for-India-Driving-Dataset","stars":5,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"We use deep convolutional neural networks to experiment semantic segmentation task on India Driving Dataset. We use pixel accuracy and Intersection-Over-Union as the evaluation metrics and experiment different kinds of methods, including weighted loss, data augmentation, transfer learning, and U-Net architecture. Weighted loss method achieved 61.07% average IoU and data augmentation method with rotated and cropped images achieved 63.73% IoU. However, it largely increases the training time. Using the transfer learning VGG, we achieve 73.74% average pixel accuracy and 58.45% average IoU on the test set. In addition, we achieve 78.03% average test pixel accuracy and 64.04% average test IoU by the method of U-Net. Finally, we build a new model named Mobile-Deeplabv3+, and we achieved 83.56% average pixel accuracy and 71.35% average IoU on the test set.","topics":[],"score":289179,"global_rank":27857,"on_pypi":false,"top_pypi":false,"python_rank":5802},{"name":"shimhz/Audio_Anti-spoofing_Sharpness","owner":"shimhz","html_url":"https://github.com/shimhz/Audio_Anti-spoofing_Sharpness","stars":6,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Interspeech 2023 - Multi-Dataset Co-Training with Sharpness-Aware Optimization for Audio Anti-spoofing","topics":[],"score":289177,"global_rank":27859,"on_pypi":fal