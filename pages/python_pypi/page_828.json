\", and so on.","topics":[],"score":213534,"global_rank":258061,"on_pypi":false,"top_pypi":false,"python_rank":41385},{"name":"raymond-devries/skagit60-scraping","owner":"raymond-devries","html_url":"https://github.com/raymond-devries/skagit60-scraping","stars":0,"forks":0,"watchers":0,"issues":3,"language":"Python","description":"I used these scripts to gather data for skagit60.com. ","topics":[],"score":213528,"global_rank":258078,"on_pypi":false,"top_pypi":false,"python_rank":41386},{"name":"spro/upordown-grapher","owner":"spro","html_url":"https://github.com/spro/upordown-grapher","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":213525,"global_rank":258085,"on_pypi":false,"top_pypi":false,"python_rank":41387},{"name":"kristianeschenburg/metrics","owner":"kristianeschenburg","html_url":"https://github.com/kristianeschenburg/metrics","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":213525,"global_rank":258086,"on_pypi":false,"top_pypi":false,"python_rank":41388},{"name":"AndresZourelli/crypto_bot","owner":"AndresZourelli","html_url":"https://github.com/AndresZourelli/crypto_bot","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":213525,"global_rank":258089,"on_pypi":false,"top_pypi":false,"python_rank":41389},{"name":"hwp/hwp_ear","owner":"hwp","html_url":"https://github.com/hwp/hwp_ear","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":213525,"global_rank":258094,"on_pypi":false,"top_pypi":false,"python_rank":41390},{"name":"Kyle1668/Data-Structures-and-Algorithms","owner":"Kyle1668","html_url":"https://github.com/Kyle1668/Data-Structures-and-Algorithms","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Collection of Python implementations of fundamental data structures and algorithms .","topics":[],"score":213525,"global_ran