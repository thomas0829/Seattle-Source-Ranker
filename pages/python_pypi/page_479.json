ly on the future of AI.     The teaching methodology combines lectures, in-class and out-of-class exercises, and programming assignments.","topics":[],"score":2280,"global_rank":146711,"final_score":2280,"on_pypi":false,"python_rank":23915},{"name":"csdiehl/ad315-sequences","owner":"csdiehl","html_url":"https://github.com/csdiehl/ad315-sequences","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":146712,"final_score":2280,"on_pypi":false,"python_rank":23916},{"name":"colobas/obras","owner":"colobas","html_url":"https://github.com/colobas/obras","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"hard difficult expert very tough","topics":[],"score":2280,"global_rank":146716,"final_score":2280,"on_pypi":false,"python_rank":23917},{"name":"nickdotreid/cf-stories","owner":"nickdotreid","html_url":"https://github.com/nickdotreid/cf-stories","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Cystic Fibrosis Stories","topics":[],"score":2280,"global_rank":146722,"final_score":2280,"on_pypi":false,"python_rank":23918},{"name":"izhangzhihao/zhwiki-word2vec","owner":"izhangzhihao","html_url":"https://github.com/izhangzhihao/zhwiki-word2vec","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":146731,"final_score":2280,"on_pypi":false,"python_rank":23919},{"name":"nickmagruder/databricks","owner":"nickmagruder","html_url":"https://github.com/nickmagruder/databricks","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":146742,"final_score":2280,"on_pypi":false,"python_rank":23920},{"name":"jahearn3/adventofcode2024","owner":"jahearn3","html_url":"https://github.com/jahearn3/adventofcode2024","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":146755