ion, recall, AUC and plotted ROC curve Used the following modules in Python-Pandas, NumPy, Scikit-Learn, matplotlib, Imbalanced-learn","topics":[],"score":235210,"global_rank":94145,"on_pypi":false,"top_pypi":false,"python_rank":16294},{"name":"codefellows/seattle-ops-401d5","owner":"codefellows","html_url":"https://github.com/codefellows/seattle-ops-401d5","stars":0,"forks":0,"watchers":6,"issues":0,"language":"Python","description":"Course Repository","topics":[],"score":235207,"global_rank":94146,"on_pypi":false,"top_pypi":false,"python_rank":16295},{"name":"rio-sanjuan/whats-my-wordle","owner":"rio-sanjuan","html_url":"https://github.com/rio-sanjuan/whats-my-wordle","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Word Suggester for Wordle Game","topics":["wordle","wordle-clone","wordle-game","wordle-helper","wordle-python","wordle-solver"],"score":235199,"global_rank":94166,"on_pypi":false,"top_pypi":false,"python_rank":16296},{"name":"lana-z/web-scraper","owner":"lana-z","html_url":"https://github.com/lana-z/web-scraper","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":235199,"global_rank":94172,"on_pypi":false,"top_pypi":false,"python_rank":16297},{"name":"jsulz/doogledoor","owner":"jsulz","html_url":"https://github.com/jsulz/doogledoor","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"What's going on with the doog?","topics":[],"score":235199,"global_rank":94173,"on_pypi":false,"top_pypi":false,"python_rank":16298},{"name":"xinghai-zhang/physics","owner":"xinghai-zhang","html_url":"https://github.com/xinghai-zhang/physics","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":235199,"global_rank":94178,"on_pypi":false,"top_pypi":false,"python_rank":16299},{"name":"brianm/secret_bot","owner":"brianm","html_url":"https://github.com/brianm/secret_bot","stars":0,"forks":0,"watchers":1,"issues":0,"langu