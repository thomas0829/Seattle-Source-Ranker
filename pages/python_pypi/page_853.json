[{"name":"arjunhmalhotra/random-drunk-walk","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/random-drunk-walk","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"The program simulates a drunkard's escape from a building (a random walk within a circle with a hole in the side of radius 30 degree). The program returns a printed output if the random walk permits him to escape the enclosure or not. We limit the program to 1000 steps so that the random walk doesn't go on for too long. ","topics":[],"score":208833,"global_rank":282667,"on_pypi":false,"top_pypi":false,"python_rank":42601},{"name":"arjunhmalhotra/mapping-leadlevels","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/mapping-leadlevels","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This program reads a text list of lead levels in the soil of Newark, Ohio, then graphs the lead values by longitude and latitude as a scatter plot over a baseman of the region. For reference, blue dots are lead levels less than 400 ppm, yellow dots are lead levels less than 1000 ppm, orange dots are lead levels less than 2000, and red dots are lead levels of anything greater than 2000 ppm.","topics":[],"score":208833,"global_rank":282668,"on_pypi":false,"top_pypi":false,"python_rank":42602},{"name":"arjunhmalhotra/fibonaccispirals","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/fibonaccispirals","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This program draws a fibonacci spiral through a graphical rectangle building program that creates every next rectangle as big as the cumulative sum of the areas of the rectangles already drawn.","topics":[],"score":208833,"global_rank":282669,"on_pypi":false,"top_pypi":false,"python_rank":42603},{"name":"arjunhmalhotra/clockarithmetic","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/clockarithmetic","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This simple program computes clock arithmetic as a function of two user formatted input prompts. The program splits up the entered time stamps and separates the hour, minute, and second inputs respectively from both user inputs. A range on the timestamps is a redundant restriction in the algorithm due to the nature of the input -- owing to the fact that no clock displays seconds and minutes higher than an increment of 60 and hours in that of 24. The program accounts for the 'overflow' of seconds into minutes, minutes into hours, and hours into the time on the next day.","topics":[],"score":208833,"global_rank":282670,"on_pypi":false,"top_pypi":false,"python_rank":42604},{"name":"arjunhmalhotra/securitylights-cycles","owner":"arjunhmalhotra","html_url":"https://github.com/arjunhmalhotra/securitylights-cycles","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"This program checks whether two security lights are on at a certain time, given certain on-off cycles. ","topics":[],"score":208833,"global_rank":282671,"on_pypi":false,"top_pypi":false,"python_rank":42605},{"name":"kurtrm/gas_usage_calculator","owner":"kurtrm","html_url":"https://github.com/kurtrm/gas_usage_calculator","stars":0,"forks":0,"watchers":0,"issues":3,"language":"Python","description":null,"topics":[],"score":208833,"global_rank":282677,"on_pypi":false,"top_pypi":false,"python_rank":42606},{"name":"DerekDiJin/PERSEUS_SPARK_frontend","owner":"DerekDiJin","html_url":"https://github.com/DerekDiJin/PERSEUS_SPARK_frontend","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"The frontend for interaction and display of data processed by PERSEUS_SPARK","topics":[],"score":208833,"global_rank":282698,"on_pypi":false,"top_pypi":false,"python_rank":42607},{"name":"sonntag/neuralnet","owner":"sonntag","html_url":"https://github.com/sonntag/neuralnet","stars":2,"forks":0,"watchers":1,"issues":0,"