mp-like form.","topics":[],"score":299037,"global_rank":23316,"on_pypi":false,"top_pypi":false,"python_rank":5014},{"name":"volfco/clickhouse-reshard","owner":"volfco","html_url":"https://github.com/volfco/clickhouse-reshard","stars":8,"forks":0,"watchers":3,"issues":0,"language":"Python","description":"A utility to reshard distributed data in a Clickhouse Cluster onto new nodes","topics":["clickhouse","clickhouse-server"],"score":299006,"global_rank":23331,"on_pypi":false,"top_pypi":false,"python_rank":5015},{"name":"tdeason416/pitchbook","owner":"tdeason416","html_url":"https://github.com/tdeason416/pitchbook","stars":7,"forks":3,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":298989,"global_rank":23337,"on_pypi":false,"top_pypi":false,"python_rank":5016},{"name":"ridha/logviewer","owner":"ridha","html_url":"https://github.com/ridha/logviewer","stars":8,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Logviewer allows you to tail files to the web","topics":[],"score":298973,"global_rank":30508,"on_pypi":true,"top_pypi":false,"python_rank":5017},{"name":"brfid/brfid.github.io","owner":"brfid","html_url":"https://github.com/brfid/brfid.github.io","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Technical writing portfolio built with Hugo and a VAX-to-PDP-11 publishing pipeline.","topics":[],"score":298958,"global_rank":23350,"on_pypi":false,"top_pypi":false,"python_rank":5018},{"name":"abe238/youtube-subscription-extractor","owner":"abe238","html_url":"https://github.com/abe238/youtube-subscription-extractor","stars":2,"forks":1,"watchers":0,"issues":0,"language":"Python","description":"Universal YouTube Subscription Data Extractor - Extract comprehensive channel information from YouTube subscription MHTML files with 100% data coverage","topics":[],"score":298936,"global_rank":23358,"on_pypi":false,"top_pypi":false,"python_rank":5019},{"name":"UWIT-IAM/uw-idp-custom","owner":"UWIT-I