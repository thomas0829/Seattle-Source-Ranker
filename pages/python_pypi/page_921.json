[{"name":"CookieLogic/Simple-Grader","owner":"CookieLogic","html_url":"https://github.com/CookieLogic/Simple-Grader","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"This is a python program to help instructors with large classes input grades for assignments quickly and easily.  It's designed to work with the University of Pittsburgh's Courseweb/Blackboard Learn system but should work with Canvas or other similar tools with relatively minor modifications.","topics":[],"score":212158,"global_rank":273636,"on_pypi":false,"top_pypi":false,"python_rank":46001},{"name":"saransh2405/bi-gram-word-suggestion","owner":"saransh2405","html_url":"https://github.com/saransh2405/bi-gram-word-suggestion","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"In the fields of computational linguistics and probability, an n-gram is a contiguous sequence of n items from a given sequence of text or speech. The items can be phonemes, syllables, letters, words or base pairs according to the application. The n-grams typically are collected from a text or speech corpus. When the items are words, n-grams may also be called shingles.[1]  An n-gram of size 1 is referred to as a \"unigram\"; size 2 is a \"bigram\" (or, less commonly, a \"digram\"); size 3 is a \"trigram\". Larger sizes are sometimes referred to by the value of n, e.g., \"four-gram\", \"five-gram\", and so on.","topics":[],"score":212154,"global_rank":273642,"on_pypi":false,"top_pypi":false,"python_rank":46002},{"name":"xinghai-zhang/Mhacks6","owner":"xinghai-zhang","html_url":"https://github.com/xinghai-zhang/Mhacks6","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Automatically generates powerpoint from news articles on the web.","topics":[],"score":212130,"global_rank":273709,"on_pypi":false,"top_pypi":false,"python_rank":46003},{"name":"kridos/FounderScraper","owner":"kridos","html_url":"https://github.com/kridos/FounderScraper","stars":0,