[{"name":"kishorekumarhanbar/Honeypot-","owner":"kishorekumarhanbar","html_url":"https://github.com/kishorekumarhanbar/Honeypot-","stars":8,"forks":4,"watchers":0,"issues":0,"language":"Python","description":"This honeypot is designed to listen on all TCP and UDP ports. It emulates the following services:  SSH (22/tcp) telnet (23/tcp) SMTP (25/tcp) HTTPS (443/tcp only) HTTP GET and CONNECT (on every other tcp port) SIP (5060/udp, with special support to detect sipvicious scans) Netis factory backdoor HTTP is autodetected by monitoring whether the first bytes sent by the client are either GET or CONNECT. In case of HTTP CONNECT requests, the emulated proxy always loops back to the honeypot itself.  Similarly, SSL/TLS is also autodetected by checking if the first bytes sent by the client look like the first bytes of the SSL Client Hello handshake message.  Any other unrecognized TCP connection or UDP packet is logged as-is in hexdump-like form.","topics":[],"score":300508,"global_rank":22402,"on_pypi":false,"top_pypi":false,"python_rank":4701},{"name":"Akash3121/Slot-Machine","owner":"Akash3121","html_url":"https://github.com/Akash3121/Slot-Machine","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":["python3"],"score":300503,"global_rank":22407,"on_pypi":false,"top_pypi":false,"python_rank":4702},{"name":"AmishaSomaiya/Machine-Learning","owner":"AmishaSomaiya","html_url":"https://github.com/AmishaSomaiya/Machine-Learning","stars":5,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Machine Learning Code Implementations in Python","topics":["central-limit-theorem","coordinate-descent-algorithm","kernel-ridge-regression","kmeans-clustering","kmeans-clustering-algorithm","lasso-regression","lloyds-algorithm","mnist-classification","native-python","neural-networks","numpy","polynomial-kernel","principal-component-analysis","pytorch","rbf-kernel","regularized-logistic-regression","representation-learning","self-su