CT requests, the emulated proxy always loops back to the honeypot itself.  Similarly, SSL/TLS is also autodetected by checking if the first bytes sent by the client look like the first bytes of the SSL Client Hello handshake message.  Any other unrecognized TCP connection or UDP packet is logged as-is in hexdump-like form.","topics":[],"score":300401,"global_rank":22423,"on_pypi":false,"top_pypi":false,"python_rank":4729},{"name":"bdamer/podsnapper","owner":"bdamer","html_url":"https://github.com/bdamer/podsnapper","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Tool to automatically download new podcasts from a list of RSS feeds.","topics":[],"score":300385,"global_rank":22429,"on_pypi":false,"top_pypi":false,"python_rank":4730},{"name":"soldni/tokreate","owner":"soldni","html_url":"https://github.com/soldni/tokreate","stars":6,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"A minimal library to create tokens using LLMs.","topics":["llm","nlp","python"],"score":300372,"global_rank":29013,"on_pypi":true,"top_pypi":false,"python_rank":4731},{"name":"milkshakeiii/cursesgame","owner":"milkshakeiii","html_url":"https://github.com/milkshakeiii/cursesgame","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":300367,"global_rank":22435,"on_pypi":false,"top_pypi":false,"python_rank":4732},{"name":"xieliaing/Side-Projects","owner":"xieliaing","html_url":"https://github.com/xieliaing/Side-Projects","stars":0,"forks":0,"watchers":1,"issues":2,"language":"Python","description":null,"topics":[],"score":300367,"global_rank":22436,"on_pypi":false,"top_pypi":false,"python_rank":4733},{"name":"davidfstr/webcrystal","owner":"davidfstr","html_url":"https://github.com/davidfstr/webcrystal","stars":35,"forks":2,"watchers":1,"issues":7,"language":"Python","description":"An archiving HTTP proxy and on-disk archival format for websites.","topics":["digital-preservation","http-proxy","websi