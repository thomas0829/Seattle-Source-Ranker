[{"name":"kishorekumarhanbar/Honeypot-","owner":"kishorekumarhanbar","html_url":"https://github.com/kishorekumarhanbar/Honeypot-","stars":9,"forks":4,"watchers":0,"issues":0,"language":"Python","description":"This honeypot is designed to listen on all TCP and UDP ports. It emulates the following services:  SSH (22/tcp) telnet (23/tcp) SMTP (25/tcp) HTTPS (443/tcp only) HTTP GET and CONNECT (on every other tcp port) SIP (5060/udp, with special support to detect sipvicious scans) Netis factory backdoor HTTP is autodetected by monitoring whether the first bytes sent by the client are either GET or CONNECT. In case of HTTP CONNECT requests, the emulated proxy always loops back to the honeypot itself.  Similarly, SSL/TLS is also autodetected by checking if the first bytes sent by the client look like the first bytes of the SSL Client Hello handshake message.  Any other unrecognized TCP connection or UDP packet is logged as-is in hexdump-like form.","topics":[],"score":304209,"global_rank":20888,"on_pypi":false,"top_pypi":false,"python_rank":4451},{"name":"samirsen/image-generator","owner":"samirsen","html_url":"https://github.com/samirsen/image-generator","stars":10,"forks":0,"watchers":3,"issues":0,"language":"Python","description":"Generate images from captions using GANs","topics":[],"score":304198,"global_rank":20894,"on_pypi":false,"top_pypi":false,"python_rank":4452},{"name":"nmlorg/ntelebot","owner":"nmlorg","html_url":"https://github.com/nmlorg/ntelebot","stars":1,"forks":0,"watchers":2,"issues":5,"language":"Python","description":null,"topics":[],"score":304186,"global_rank":20901,"on_pypi":false,"top_pypi":false,"python_rank":4453},{"name":"ZenithO-o/VisualizingFurryTwitter","owner":"ZenithO-o","html_url":"https://github.com/ZenithO-o/VisualizingFurryTwitter","stars":5,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Creating a graph of furry twitter to visualize the fandom in a new way","topics":[],"score":304176,"global_rank":20902,"on_pyp