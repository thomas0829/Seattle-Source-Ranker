[{"name":"kishorekumarhanbar/Honeypot-","owner":"kishorekumarhanbar","html_url":"https://github.com/kishorekumarhanbar/Honeypot-","stars":9,"forks":4,"watchers":0,"issues":0,"language":"Python","description":"This honeypot is designed to listen on all TCP and UDP ports. It emulates the following services:  SSH (22/tcp) telnet (23/tcp) SMTP (25/tcp) HTTPS (443/tcp only) HTTP GET and CONNECT (on every other tcp port) SIP (5060/udp, with special support to detect sipvicious scans) Netis factory backdoor HTTP is autodetected by monitoring whether the first bytes sent by the client are either GET or CONNECT. In case of HTTP CONNECT requests, the emulated proxy always loops back to the honeypot itself.  Similarly, SSL/TLS is also autodetected by checking if the first bytes sent by the client look like the first bytes of the SSL Client Hello handshake message.  Any other unrecognized TCP connection or UDP packet is logged as-is in hexdump-like form.","topics":[],"score":304242,"global_rank":20860,"on_pypi":false,"top_pypi":false,"python_rank":4451},{"name":"nmlorg/ntelebot","owner":"nmlorg","html_url":"https://github.com/nmlorg/ntelebot","stars":1,"forks":0,"watchers":2,"issues":5,"language":"Python","description":null,"topics":[],"score":304241,"global_rank":20861,"on_pypi":false,"top_pypi":false,"python_rank":4452},{"name":"SidU/ai_character","owner":"SidU","html_url":"https://github.com/SidU/ai_character","stars":2,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"AI Characters","topics":[],"score":304235,"global_rank":27030,"on_pypi":true,"top_pypi":false,"python_rank":4453},{"name":"georgevreilly/adventofcode","owner":"georgevreilly","html_url":"https://github.com/georgevreilly/adventofcode","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Advent of Code","topics":[],"score":304234,"global_rank":20862,"on_pypi":false,"top_pypi":false,"python_rank":4454},{"name":"Wind010/SolarPuttyDecryptor","owner":"Wind010","html_url":