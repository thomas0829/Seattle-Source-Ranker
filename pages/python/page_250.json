mendation based on the mood that an inquisitive starter can understand, by integrating the concepts of Automatic speech recognition, Artificial Intelligence, Natural Language Processing, and Interprocess communication. Having a robust assistant improves the time efficiency as well as reduces the efforts to perform simple repetitive tasks.","topics":[],"score":245886,"global_rank":70112},{"name":"kamal-hamza/Carpool","owner":"kamal-hamza","html_url":"https://github.com/kamal-hamza/Carpool","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Carpool Website with Django","topics":[],"score":245886,"global_rank":70113},{"name":"mycoleb/MNIST-MachineLearning","owner":"mycoleb","html_url":"https://github.com/mycoleb/MNIST-MachineLearning","stars":0,"forks":1,"watchers":1,"issues":1,"language":"Python","description":null,"topics":[],"score":245883,"global_rank":70118},{"name":"privatekenny/rotation","owner":"privatekenny","html_url":"https://github.com/privatekenny/rotation","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":245877,"global_rank":70127},{"name":"httpstergeek/reread","owner":"httpstergeek","html_url":"https://github.com/httpstergeek/reread","stars":2,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Splunk Add-on for reading csv/json files as events","topics":[],"score":245876,"global_rank":70129},{"name":"BrianAker/ansible-esxi","owner":"BrianAker","html_url":"https://github.com/BrianAker/ansible-esxi","stars":3,"forks":1,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":245873,"global_rank":70133},{"name":"rohit180497/Data-Encryption-Web-App","owner":"rohit180497","html_url":"https://github.com/rohit180497/Data-Encryption-Web-App","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":245868,"global_rank":70143}]