[{"name":"flebel/django-robinson","owner":"flebel","html_url":"https://github.com/flebel/django-robinson","stars":5,"forks":0,"watchers":2,"issues":1,"language":"Python","description":"Robinson is a Django application that can be used as the underlying foundation for a project that stores references to JPEG files as model instances. Projects that make use of the files' EXIF metadata can benefit from Robinson's automatic import of EXIF metadata at the time the model is saved. Moreover, Robinson offers built-in geolocation utility methods as well as fully functional admin forms that make it trivial to geocode photos that are missing geolocation EXIF metadata. As of right now, this application forces every photo to have a location, either specified manually through the admin form or automatically imported from the file's EXIF metadata. There are future plans to make it suitable for less specific use cases.","topics":[],"score":244484,"global_rank":76387},{"name":"mesflores/capacity-python","owner":"mesflores","html_url":"https://github.com/mesflores/capacity-python","stars":1,"forks":0,"watchers":3,"issues":0,"language":"Python","description":"Transportation discrete event simulation","topics":[],"score":244476,"global_rank":76397},{"name":"isabeldepapel/moviegraph","owner":"isabeldepapel","html_url":"https://github.com/isabeldepapel/moviegraph","stars":1,"forks":1,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":244476,"global_rank":76399},{"name":"jgardner04/helper-scripts","owner":"jgardner04","html_url":"https://github.com/jgardner04/helper-scripts","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":244476,"global_rank":76402},{"name":"BrandontMitchell/crypto-b0t","owner":"BrandontMitchell","html_url":"https://github.com/BrandontMitchell/crypto-b0t","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Automated Crypto Exchange System","topics":[],"score":