[{"name":"travcunn/CS450-dogpound","owner":"travcunn","html_url":"https://github.com/travcunn/CS450-dogpound","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Twitter-like service created for CS450","topics":[],"score":210085,"global_rank":279211},{"name":"petrilli/generalwords","owner":"petrilli","html_url":"https://github.com/petrilli/generalwords","stars":1,"forks":0,"watchers":1,"issues":1,"language":"Python","description":"A somewhat curated collection of words to use in nonce generation","topics":[],"score":210085,"global_rank":279213},{"name":"dawong94/cse415-Introduction-to-Artificial-Intelligence","owner":"dawong94","html_url":"https://github.com/dawong94/cse415-Introduction-to-Artificial-Intelligence","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Course description:  Artificial intelligence is a broad field encompassing computational models of human cognition, formal systems for representing and processing symbolic information, expert systems technology, and a variety of techniques for learning, understanding signals, and solving problems. This course provides a basic introduction to key techniques: state-space search, game-playing, probabilistic reasoning, and learning. Over the last 50 years the field has grown tremendously, and this course can only scratch the surface within the field.     This course begins with a discussion of what \"artificial intelligence\" means and how it can be useful. Next is a grounding in state-space search, problem formulation and solving. We then consider state-space search in the context of game playing, which then leads to alpha-beta pruning, expectimax search and the modeling of uncertainty. After that, we focus primarily on machine learning, starting with methods for reasoning under uncertainty. We cover learning of decision trees from examples, reinforcement learning in Markov Decision Processes, perceptron learning, and deep learning. We touch briefly on the future of AI.     The teaching methodology combines lectures, in-class and out-of-class exercises, and programming assignments.","topics":[],"score":210080,"global_rank":279218},{"name":"jschwarzwalder/Sort-XML","owner":"jschwarzwalder","html_url":"https://github.com/jschwarzwalder/Sort-XML","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Read in a file, process, export csv","topics":[],"score":210074,"global_rank":279226},{"name":"codynhat/mmpool","owner":"codynhat","html_url":"https://github.com/codynhat/mmpool","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":210072,"global_rank":279229},{"name":"colobas/obras","owner":"colobas","html_url":"https://github.com/colobas/obras","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"hard difficult expert very tough","topics":[],"score":210072,"global_rank":279230},{"name":"gabesk/osmrenderer","owner":"gabesk","html_url":"https://github.com/gabesk/osmrenderer","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":210068,"global_rank":279233},{"name":"a-hilaly/flask-sample","owner":"a-hilaly","html_url":"https://github.com/a-hilaly/flask-sample","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"flask blueprints sample","topics":[],"score":210064,"global_rank":279250},{"name":"brendanwallace/lolelo","owner":"brendanwallace","html_url":"https://github.com/brendanwallace/lolelo","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Fan website of league of legends predictions made with Monte Carlo simulations and the Elo rating system.","topics":[],"score":210050,"global_rank":279266},{"name":"graham-arnold-uw/MelanomaDetector","owner":"graham-arnold-uw","html_url":"https://github.com/graham-arnold-uw/MelanomaDetector","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"This script impl