uces the efforts to perform simple repetitive tasks.","topics":[],"score":248768,"global_rank":66314},{"name":"borwick/emacs.d","owner":"borwick","html_url":"https://github.com/borwick/emacs.d","stars":2,"forks":1,"watchers":2,"issues":0,"language":"Python","description":null,"topics":[],"score":248767,"global_rank":66316},{"name":"DevendraPratapYadav/Digit_recognition_ANN","owner":"DevendraPratapYadav","html_url":"https://github.com/DevendraPratapYadav/Digit_recognition_ANN","stars":2,"forks":1,"watchers":2,"issues":0,"language":"Python","description":"Implementing Neural Network using Theano and SciKit-learn in Python for digit recognition on MNIST dataset","topics":[],"score":248767,"global_rank":66317},{"name":"nicholasz2510/InternalAssessment","owner":"nicholasz2510","html_url":"https://github.com/nicholasz2510/InternalAssessment","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":248764,"global_rank":66327},{"name":"AppViewX/AVX12.2-Visual-Workflows","owner":"AppViewX","html_url":"https://github.com/AppViewX/AVX12.2-Visual-Workflows","stars":1,"forks":3,"watchers":1,"issues":0,"language":"Python","description":"Visual Workflows compatible with AVX 12.1 and AVX 12.2 ","topics":[],"score":248762,"global_rank":66329},{"name":"privatekenny/rotation","owner":"privatekenny","html_url":"https://github.com/privatekenny/rotation","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":248759,"global_rank":66335},{"name":"allenai/ai2-scholarqa-eval","owner":"allenai","html_url":"https://github.com/allenai/ai2-scholarqa-eval","stars":1,"forks":0,"watchers":0,"issues":1,"language":"Python","description":null,"topics":[],"score":248757,"global_rank":66347},{"name":"davecarpie/cycleops","owner":"davecarpie","html_url":"https://github.com/davecarpie/cycleops","stars":1,"forks":0,"watchers":0,"issues":2,"language":"Python","description":null,"topics":[],"score":248757,"global_ra