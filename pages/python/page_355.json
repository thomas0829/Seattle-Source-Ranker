gramming assignments.","topics":[],"score":2280,"global_rank":108112},{"name":"y4nnr/prediction","owner":"y4nnr","html_url":"https://github.com/y4nnr/prediction","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":108115},{"name":"manrit/TikTacToe","owner":"manrit","html_url":"https://github.com/manrit/TikTacToe","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":108118},{"name":"izhangzhihao/zhwiki-word2vec","owner":"izhangzhihao","html_url":"https://github.com/izhangzhihao/zhwiki-word2vec","stars":0,"forks":1,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":108138},{"name":"iNanzo/nHoang_PythonJsonWriter","owner":"iNanzo","html_url":"https://github.com/iNanzo/nHoang_PythonJsonWriter","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":108140},{"name":"warlicks/dungon-adventrue","owner":"warlicks","html_url":"https://github.com/warlicks/dungon-adventrue","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Create a text based adventure game for final assignment for TCSS 502. ","topics":[],"score":2280,"global_rank":108149},{"name":"calbucci/TweetDelete","owner":"calbucci","html_url":"https://github.com/calbucci/TweetDelete","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":2280,"global_rank":108156},{"name":"evandanderson/wordle","owner":"evandanderson","html_url":"https://github.com/evandanderson/wordle","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Command line wordle built in Python","topics":[],"score":2280,"global_rank":108167},{"name":"d-buckner/spotter-dashboards","owner":"d-buckner","html_url":"https://github.com/d-buckner/spotter-dashboards","stars":0,"forks":0,"watchers":1,"issues":0,"l