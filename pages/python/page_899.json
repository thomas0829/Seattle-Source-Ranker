[{"name":"saransh2405/bi-gram-word-suggestion","owner":"saransh2405","html_url":"https://github.com/saransh2405/bi-gram-word-suggestion","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"In the fields of computational linguistics and probability, an n-gram is a contiguous sequence of n items from a given sequence of text or speech. The items can be phonemes, syllables, letters, words or base pairs according to the application. The n-grams typically are collected from a text or speech corpus. When the items are words, n-grams may also be called shingles.[1]  An n-gram of size 1 is referred to as a \"unigram\"; size 2 is a \"bigram\" (or, less commonly, a \"digram\"); size 3 is a \"trigram\". Larger sizes are sometimes referred to by the value of n, e.g., \"four-gram\", \"five-gram\", and so on.","topics":[],"score":212327,"global_rank":267144},{"name":"Carlinha23/blogly","owner":"Carlinha23","html_url":"https://github.com/Carlinha23/blogly","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":212326,"global_rank":267159},{"name":"tianrunhe/Bernard","owner":"tianrunhe","html_url":"https://github.com/tianrunhe/Bernard","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":212324,"global_rank":267165},{"name":"minhng22/covid-19-jhu-extract","owner":"minhng22","html_url":"https://github.com/minhng22/covid-19-jhu-extract","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Extract covid-19 daily data from John Hopkins U dataset","topics":[],"score":212324,"global_rank":267170},{"name":"idiotleon/leetcode_solution_python_leon","owner":"idiotleon","html_url":"https://github.com/idiotleon/leetcode_solution_python_leon","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"Solutions to leetcode problems in Python3.","topics":[],"score":212317,"global_rank":267186},{"name":"Legoben/rss2yo","owner":"L