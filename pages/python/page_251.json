 virtual assistant empowered with disease prediction and movie recommendation based on the mood that an inquisitive starter can understand, by integrating the concepts of Automatic speech recognition, Artificial Intelligence, Natural Language Processing, and Interprocess communication. Having a robust assistant improves the time efficiency as well as reduces the efforts to perform simple repetitive tasks.","topics":[],"score":245859,"global_rank":70205},{"name":"kamal-hamza/Carpool","owner":"kamal-hamza","html_url":"https://github.com/kamal-hamza/Carpool","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Carpool Website with Django","topics":[],"score":245859,"global_rank":70207},{"name":"Micasou/expiditionhackssea2017","owner":"Micasou","html_url":"https://github.com/Micasou/expiditionhackssea2017","stars":2,"forks":0,"watchers":5,"issues":0,"language":"Python","description":null,"topics":[],"score":245858,"global_rank":70209},{"name":"UWNetworksLab/uProxy-benchmark","owner":"UWNetworksLab","html_url":"https://github.com/UWNetworksLab/uProxy-benchmark","stars":1,"forks":1,"watchers":10,"issues":0,"language":"Python","description":"uproxy testing and benchmark tools.","topics":[],"score":245855,"global_rank":70212},{"name":"hbergen/minimal-python-package","owner":"hbergen","html_url":"https://github.com/hbergen/minimal-python-package","stars":2,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"Skeleton for creating an importable python 3 package","topics":[],"score":245852,"global_rank":70213},{"name":"privatekenny/rotation","owner":"privatekenny","html_url":"https://github.com/privatekenny/rotation","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":245850,"global_rank":70219},{"name":"JarvisEQ/Team7","owner":"JarvisEQ","html_url":"https://github.com/JarvisEQ/Team7","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score"