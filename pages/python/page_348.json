 Random Forests and it gave AUC=0.94 and precision=0.85 (with 'gini' criterion) and AUC=0.92 & precision=0.83 (with 'entropy' criterion). Measured performance metrics-accuracy, precision, recall, AUC and plotted ROC curve Used the following modules in Python-Pandas, NumPy, Scikit-Learn, matplotlib, Imbalanced-learn","topics":[],"score":235416,"global_rank":102973},{"name":"naclonts/mylocalmarket","owner":"naclonts","html_url":"https://github.com/naclonts/mylocalmarket","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"App to find local farmers markets","topics":["django","es6","farmers-markets"],"score":235411,"global_rank":102979},{"name":"rlabrecque/GenerateProjectsMap","owner":"rlabrecque","html_url":"https://github.com/rlabrecque/GenerateProjectsMap","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Python","description":"This script generates a list of all of my git repos.","topics":[],"score":235411,"global_rank":102980},{"name":"ruiawang/Bulgarian-Solitaire","owner":"ruiawang","html_url":"https://github.com/ruiawang/Bulgarian-Solitaire","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Visualizing Bulgarian Solitaire game graphs with graphviz","topics":["bulgarian-solitaire","graphviz"],"score":235410,"global_rank":102989},{"name":"sabrinamianne/oc_project","owner":"sabrinamianne","html_url":"https://github.com/sabrinamianne/oc_project","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":235410,"global_rank":102995},{"name":"DevenPatel19/login_and_reg","owner":"DevenPatel19","html_url":"https://github.com/DevenPatel19/login_and_reg","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":null,"topics":[],"score":235410,"global_rank":103003},{"name":"tygris/HafniaCarbide","owner":"tygris","html_url":"https://github.com/tygris/HafniaCarbide","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"Monte C