[{"name":"kevingoldsmith/lastfm-extract","owner":"kevingoldsmith","html_url":"https://github.com/kevingoldsmith/lastfm-extract","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":"get tracks from last fm","topics":[],"score":212789,"global_rank":261710},{"name":"saransh2405/bi-gram-word-suggestion","owner":"saransh2405","html_url":"https://github.com/saransh2405/bi-gram-word-suggestion","stars":1,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"In the fields of computational linguistics and probability, an n-gram is a contiguous sequence of n items from a given sequence of text or speech. The items can be phonemes, syllables, letters, words or base pairs according to the application. The n-grams typically are collected from a text or speech corpus. When the items are words, n-grams may also be called shingles.[1]  An n-gram of size 1 is referred to as a \"unigram\"; size 2 is a \"bigram\" (or, less commonly, a \"digram\"); size 3 is a \"trigram\". Larger sizes are sometimes referred to by the value of n, e.g., \"four-gram\", \"five-gram\", and so on.","topics":[],"score":212787,"global_rank":261723},{"name":"SaralynOgden/BBSTrader","owner":"SaralynOgden","html_url":"https://github.com/SaralynOgden/BBSTrader","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Python","description":null,"topics":[],"score":212787,"global_rank":261730},{"name":"neu-seattle-cs5500-fall18/book-library-web-service-rasengan","owner":"neu-seattle-cs5500-fall18","html_url":"https://github.com/neu-seattle-cs5500-fall18/book-library-web-service-rasengan","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"book-library-web-service-rasengan created by GitHub Classroom","topics":[],"score":212786,"global_rank":261733},{"name":"daytonpe/mnist-digit-classifier","owner":"daytonpe","html_url":"https://github.com/daytonpe/mnist-digit-classifier","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Python","description":"