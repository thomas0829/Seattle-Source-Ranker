uman. Each God could have MANY Humans following him/her through a JOIN model of GuardianAngel. The God model could have many GuardianAngels but lets say s/he doesn\u2019t care about keeping track of all his/her follower Humans. Who said DB associations were boring?","topics":[],"score":1844,"global_rank":280710},{"name":"yaauie/text-chimp","owner":"yaauie","html_url":"https://github.com/yaauie/text-chimp","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Subscribe to Mailchimp lists via SMS","topics":[],"score":1844,"global_rank":280730},{"name":"nglasgow/Travel_Insight","owner":"nglasgow","html_url":"https://github.com/nglasgow/Travel_Insight","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":1844,"global_rank":280731},{"name":"nglasgow/Gym_Membership","owner":"nglasgow","html_url":"https://github.com/nglasgow/Gym_Membership","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"System of tracking which members are enrolled in which classes","topics":[],"score":1844,"global_rank":280732},{"name":"nglasgow/mind_thought","owner":"nglasgow","html_url":"https://github.com/nglasgow/mind_thought","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"A place to ask questions and get answers, as well as answer the questions of others","topics":[],"score":1844,"global_rank":280733},{"name":"nglasgow/collaborative_site","owner":"nglasgow","html_url":"https://github.com/nglasgow/collaborative_site","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Allows user to asks questions and get answers, as well as provide answers to other users. ","topics":[],"score":1844,"global_rank":280734},{"name":"nglasgow/date_tracker","owner":"nglasgow","html_url":"https://github.com/nglasgow/date_tracker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"A way to keep track of important dates","topics":[],"score":1844,"