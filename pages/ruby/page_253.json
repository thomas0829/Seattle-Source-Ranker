anAngels but lets say s/he doesn\u2019t care about keeping track of all his/her follower Humans. Who said DB associations were boring?","topics":[],"score":182552,"global_rank":411333},{"name":"tuckerd/list_it","owner":"tuckerd","html_url":"https://github.com/tuckerd/list_it","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Keep all of you grocery, hardware store... lists organized (CodeFellows - App A Day: Nested Resources)","topics":[],"score":182552,"global_rank":411334},{"name":"nglasgow/Travel_Insight","owner":"nglasgow","html_url":"https://github.com/nglasgow/Travel_Insight","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":182552,"global_rank":411335},{"name":"CrossTheStreams/rails_3_boilerplate","owner":"CrossTheStreams","html_url":"https://github.com/CrossTheStreams/rails_3_boilerplate","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":182552,"global_rank":411337},{"name":"sprestage/kitchen","owner":"sprestage","html_url":"https://github.com/sprestage/kitchen","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Kitchen application tracks your recipes and ingredients.","topics":[],"score":182552,"global_rank":411339},{"name":"MargeRosen/horoscope","owner":"MargeRosen","html_url":"https://github.com/MargeRosen/horoscope","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":182552,"global_rank":411342},{"name":"bvuongx/Recipes_you_name_it","owner":"bvuongx","html_url":"https://github.com/bvuongx/Recipes_you_name_it","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":182552,"global_rank":411345},{"name":"bvuongx/Recipes","owner":"bvuongx","html_url":"https://github.com/bvuongx/Recipes","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":182552,"global_rank":411346}