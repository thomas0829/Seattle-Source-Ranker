odel, God. The MANY side model would be Human. Each God could have MANY Humans following him/her through a JOIN model of GuardianAngel. The God model could have many GuardianAngels but lets say s/he doesn\u2019t care about keeping track of all his/her follower Humans. Who said DB associations were boring?","topics":[],"score":174969,"global_rank":432483},{"name":"nglasgow/Travel_Insight","owner":"nglasgow","html_url":"https://github.com/nglasgow/Travel_Insight","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":null,"topics":[],"score":174969,"global_rank":432484},{"name":"jdlehman/bowling_scorer","owner":"jdlehman","html_url":"https://github.com/jdlehman/bowling_scorer","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":"given a formatted string, scores a bowling game","topics":[],"score":174969,"global_rank":432489},{"name":"pg/RubySettlers","owner":"pg","html_url":"https://github.com/pg/RubySettlers","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Settlers of Catan written in Ruby","topics":[],"score":174963,"global_rank":432495},{"name":"toastynerd/design_playground","owner":"toastynerd","html_url":"https://github.com/toastynerd/design_playground","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":null,"topics":[],"score":174961,"global_rank":432500},{"name":"suyesh/apple2","owner":"suyesh","html_url":"https://github.com/suyesh/apple2","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":null,"topics":[],"score":174961,"global_rank":432501},{"name":"suyesh/appleorange","owner":"suyesh","html_url":"https://github.com/suyesh/appleorange","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":null,"topics":[],"score":174961,"global_rank":432502},{"name":"bvuongx/membership","owner":"bvuongx","html_url":"https://github.com/bvuongx/membership","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":nul