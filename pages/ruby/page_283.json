?","topics":[],"score":175257,"global_rank":430911},{"name":"sprestage/kitchen","owner":"sprestage","html_url":"https://github.com/sprestage/kitchen","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":"Kitchen application tracks your recipes and ingredients.","topics":[],"score":175257,"global_rank":430913},{"name":"bvuongx/Recipes_you_name_it","owner":"bvuongx","html_url":"https://github.com/bvuongx/Recipes_you_name_it","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":null,"topics":[],"score":175257,"global_rank":430914},{"name":"bvuongx/Recipes","owner":"bvuongx","html_url":"https://github.com/bvuongx/Recipes","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":null,"topics":[],"score":175257,"global_rank":430915},{"name":"pg/RubySettlers","owner":"pg","html_url":"https://github.com/pg/RubySettlers","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Settlers of Catan written in Ruby","topics":[],"score":175251,"global_rank":430932},{"name":"jf647/chef-omnibus","owner":"jf647","html_url":"https://github.com/jf647/chef-omnibus","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":"Installs Omnibus using chef-cligem","topics":[],"score":175248,"global_rank":430935},{"name":"jf647/chef-god","owner":"jf647","html_url":"https://github.com/jf647/chef-god","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":"Sets up the god process manager using chef-cligem","topics":[],"score":175248,"global_rank":430936},{"name":"jf647/chef-fpm","owner":"jf647","html_url":"https://github.com/jf647/chef-fpm","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":"Installs fpm using chef-cligem","topics":[],"score":175248,"global_rank":430937},{"name":"jf647/chef-foreman","owner":"jf647","html_url":"https://github.com/jf647/chef-foreman","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Ruby","description":"Installs