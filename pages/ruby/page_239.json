[{"name":"nglasgow/Travel_Insight","owner":"nglasgow","html_url":"https://github.com/nglasgow/Travel_Insight","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":183185,"global_rank":400241},{"name":"tuckerd/list_it","owner":"tuckerd","html_url":"https://github.com/tuckerd/list_it","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"Keep all of you grocery, hardware store... lists organized (CodeFellows - App A Day: Nested Resources)","topics":[],"score":183185,"global_rank":400242},{"name":"ggriffis/the-gods-must-be-crazy","owner":"ggriffis","html_url":"https://github.com/ggriffis/the-gods-must-be-crazy","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":"An app to demonstrate a One-to-Many (via has_one :through/has_many) database association.  Using a through object is helpful when you want to store information specific to the association of two items\u2014instead of just wanting to store the association itself. Using these helper methods the MANY side model will be cognizant of the ONE model but the ONE side model will not be directly cognizant of the MANY model. Both will be cognizant of the JOIN model, however. This is a rare scenario. Let\u2019s use a bizarre, somewhat contrived, and controversial example. Let\u2019s say we have a ONE side model, God. The MANY side model would be Human. Each God could have MANY Humans following him/her through a JOIN model of GuardianAngel. The God model could have many GuardianAngels but lets say s/he doesn\u2019t care about keeping track of all his/her follower Humans. Who said DB associations were boring?","topics":[],"score":183185,"global_rank":400244},{"name":"CrossTheStreams/rails_3_boilerplate","owner":"CrossTheStreams","html_url":"https://github.com/CrossTheStreams/rails_3_boilerplate","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Ruby","description":null,"topics":[],"score":183185,"global_rank":400245},{"name"