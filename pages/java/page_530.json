[{"name":"dknoern/calllog","owner":"dknoern","html_url":"https://github.com/dknoern/calllog","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"Call log for charitable help or crisis line.","topics":[],"score":182380,"global_rank":413137},{"name":"maringantis/Distributed-client-server-model","owner":"maringantis","html_url":"https://github.com/maringantis/Distributed-client-server-model","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"The project involves the primitives of developing a distributed system.The distributed system we developed had two servers and a client. The model had to compute and calculate the arithmetic. The first server has few operators and the second system other operations. If the client requested the arithmetic involving the operator from the first client then the response is directed to the client.If the arithmetic involves the operation from the second server then the operation is first checked in the initial server then checks in the next server.If the operation is found it computes the calculation and returns the value to the first server, then this server returns the required response to the client. If the requested operation is not found in any server then it prompts for any other operation.","topics":[],"score":182378,"global_rank":413150},{"name":"tameravci/FreqItemSet_Apriori","owner":"tameravci","html_url":"https://github.com/tameravci/FreqItemSet_Apriori","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"Frequent Itemsets Mining and Performance Competition","topics":[],"score":182370,"global_rank":413188},{"name":"schlarpc/RevivalBook","owner":"schlarpc","html_url":"https://github.com/schlarpc/RevivalBook","stars":0,"forks":0,"watchers":1,"issues":2,"language":"Java","description":"Minecraft mod for Hardcore multiplayer","topics":[],"score":182364,"global_rank":413208},{"name":"supercoffee/cs372-lab5","owner":"supercoffee","html_url":"https://github.c