k":386308},{"name":"maringantis/Distributed-client-server-model","owner":"maringantis","html_url":"https://github.com/maringantis/Distributed-client-server-model","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"The project involves the primitives of developing a distributed system.The distributed system we developed had two servers and a client. The model had to compute and calculate the arithmetic. The first server has few operators and the second system other operations. If the client requested the arithmetic involving the operator from the first client then the response is directed to the client.If the arithmetic involves the operation from the second server then the operation is first checked in the initial server then checks in the next server.If the operation is found it computes the calculation and returns the value to the first server, then this server returns the required response to the client. If the requested operation is not found in any server then it prompts for any other operation.","topics":[],"score":1846,"global_rank":386313},{"name":"kanishkt/Direction","owner":"kanishkt","html_url":"https://github.com/kanishkt/Direction","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":null,"topics":[],"score":1846,"global_rank":386317},{"name":"AlecAnthonyGarcia/BuildItBigger","owner":"AlecAnthonyGarcia","html_url":"https://github.com/AlecAnthonyGarcia/BuildItBigger","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"[Project 4] Build It Bigger for Udacity's Android Developer Nanodegree","topics":[],"score":1846,"global_rank":386322},{"name":"luisnaranjo733/info498d_final_project","owner":"luisnaranjo733","html_url":"https://github.com/luisnaranjo733/info498d_final_project","stars":0,"forks":0,"watchers":0,"issues":2,"language":"Java","description":null,"topics":[],"score":1846,"global_rank":386328},{"name":"KenjiChao/Codility-Solutions-Java-","owner":"KenjiChao","html_url":"https