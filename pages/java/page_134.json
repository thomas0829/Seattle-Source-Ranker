[{"name":"cleemonaghan/Word-Frequency","owner":"cleemonaghan","html_url":"https://github.com/cleemonaghan/Word-Frequency","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"This project counts the words inside of a text file, using a red-black tree. The file name is entered in the command-line argument. Then, the program will count the word frequencies and then give a prompt asking the user for words, for which it will give the frequency and other information. The following commands are built in: < and > will get the first key and the last key, respectively. <word and >word will get the predecessor and successor of the word in question. &word will get the rank of a word, while *rank will get the word with integer rank given.","topics":[],"score":224956,"global_rank":142029},{"name":"cleemonaghan/Sorting-Tasks","owner":"cleemonaghan","html_url":"https://github.com/cleemonaghan/Sorting-Tasks","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"This project's goal is to find a valid ordering of a number of tasks using a directed graph. It parses a .task file, that will be specified on the command line. A file of n lines will define n different tasks. Each line of the file is a tab-separated list, where the first token is some new task, and all remaining tokens are the other tasks that must be done prior to it. Every listed task in the file will be the first task on exactly one line, and no task is directly dependent on itself. This program first determines whether or not there are tasks that are mutually dependent. It will output the answer to that question. When no tasks are co-dependent, the program will then output a numbered list which sorts the tasks into a valid order. However, some .task files will contain mutual dependencies. If several tasks are dependent on each other (either directly or indirectly), then they must be done at the same time. In this case, some numbered items will be comma-separated lists.","topics":[],"score":224956,"global_rank":142030},{"name":"jonatan-ivanov/sleuth-gh-1659","owner":"jonatan-ivanov","html_url":"https://github.com/jonatan-ivanov/sleuth-gh-1659","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"https://github.com/spring-cloud/spring-cloud-sleuth/issues/1659","topics":[],"score":224956,"global_rank":142037},{"name":"jonatan-ivanov/sleuth-gh-1663","owner":"jonatan-ivanov","html_url":"https://github.com/jonatan-ivanov/sleuth-gh-1663","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"https://github.com/spring-cloud/spring-cloud-sleuth/issues/1663","topics":[],"score":224956,"global_rank":142038},{"name":"ShwetaGupta15/Projects","owner":"ShwetaGupta15","html_url":"https://github.com/ShwetaGupta15/Projects","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":224956,"global_rank":142040},{"name":"eginez/skillsharpening","owner":"eginez","html_url":"https://github.com/eginez/skillsharpening","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":224956,"global_rank":142059},{"name":"tesfahunfola/GuestTypeDetector","owner":"tesfahunfola","html_url":"https://github.com/tesfahunfola/GuestTypeDetector","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":null,"topics":[],"score":224949,"global_rank":142107},{"name":"BellaHardy18/GameChangerModel","owner":"BellaHardy18","html_url":"https://github.com/BellaHardy18/GameChangerModel","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":224948,"global_rank":142130},{"name":"ghadlich/ProjectEulerSolutions","owner":"ghadlich","html_url":"https://github.com/ghadlich/ProjectEulerSolutions","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"Solutions to Project Euler Problems","topics":[],"score":224942,"global_rank":142208},{"name":"elefteroff/caresoftapp1","owner":"