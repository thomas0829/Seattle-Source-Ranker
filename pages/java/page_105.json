[{"name":"amaslov/JavaWorkspace","owner":"amaslov","html_url":"https://github.com/amaslov/JavaWorkspace","stars":2,"forks":1,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":229728,"global_rank":109902},{"name":"kunj17/Distributed-System","owner":"kunj17","html_url":"https://github.com/kunj17/Distributed-System","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"This repository will contain different basic programs of Distributed System","topics":[],"score":229726,"global_rank":109908},{"name":"cthorpen/TrekConnect","owner":"cthorpen","html_url":"https://github.com/cthorpen/TrekConnect","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Java","description":null,"topics":[],"score":229721,"global_rank":109934},{"name":"saransh2405/question-answering-nlp","owner":"saransh2405","html_url":"https://github.com/saransh2405/question-answering-nlp","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Java","description":"Question and answering system based on natural language processing using corpus from wikipedia  Answering questions from a corpus has always been viewed as an important aspect of natural language processing. Given the size of Wikipedia and web in general, and the information on such websites answering questions would lead to building a structural and associated data. This report aims at represented how a corpus can be processed to accurately give answers to related questions. For this, new algorithm has been proposed.  A QA implementation, usually a computer program, may construct its answers by querying a structured database of knowledge or information, usually a knowledge base. More commonly, QA systems can pull answers from an unstructured collection of natural language documents. Here a similar attempt at solving the problem has been performed, where part of a article from Wikipedia has been used as corpus and was tested against different type of questions that the program can answer correctly. Advanced QA requires sophisticated text processing tools based on state-of-the-art NLP.","topics":[],"score":229711,"global_rank":109956},{"name":"leej63/Hangman","owner":"leej63","html_url":"https://github.com/leej63/Hangman","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Java","description":null,"topics":[],"score":229673,"global_rank":110005},{"name":"xschildw/pocversion","owner":"xschildw","html_url":"https://github.com/xschildw/pocversion","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":229668,"global_rank":110021},{"name":"abdisati/Java-Animation","owner":"abdisati","html_url":"https://github.com/abdisati/Java-Animation","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":229668,"global_rank":110026},{"name":"robeil/my-github-actions","owner":"robeil","html_url":"https://github.com/robeil/my-github-actions","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":229668,"global_rank":110029},{"name":"tmparayil/CapstoneProject","owner":"tmparayil","html_url":"https://github.com/tmparayil/CapstoneProject","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Java","description":"MemoryManager","topics":[],"score":229645,"global_rank":110075},{"name":"daveclay/aftxr-processing","owner":"daveclay","html_url":"https://github.com/daveclay/aftxr-processing","stars":0,"forks":0,"watchers":0,"issues":0,"language":"Java","description":null,"topics":[],"score":229644,"global_rank":110077},{"name":"jd2rogers2/work-from-happy-place","owner":"jd2rogers2","html_url":"https://github.com/jd2rogers2/work-from-happy-place","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":229613,"global_rank":110119},{"name":"NimaSherpa10/Java","owner":"NimaSherpa10","html_url":"https://github.com/NimaSherpa10/Java","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","descri