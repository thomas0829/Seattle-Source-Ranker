[{"name":"maringantis/Distributed-client-server-model","owner":"maringantis","html_url":"https://github.com/maringantis/Distributed-client-server-model","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"The project involves the primitives of developing a distributed system.The distributed system we developed had two servers and a client. The model had to compute and calculate the arithmetic. The first server has few operators and the second system other operations. If the client requested the arithmetic involving the operator from the first client then the response is directed to the client.If the arithmetic involves the operation from the second server then the operation is first checked in the initial server then checks in the next server.If the operation is found it computes the calculation and returns the value to the first server, then this server returns the required response to the client. If the requested operation is not found in any server then it prompts for any other operation.","topics":[],"score":190076,"global_rank":352490},{"name":"aarya-ci/ProjectEuler","owner":"aarya-ci","html_url":"https://github.com/aarya-ci/ProjectEuler","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"Some walkthrough for Project Euler question in java and python","topics":[],"score":190076,"global_rank":352502},{"name":"TDA/Java-Algorithms","owner":"TDA","html_url":"https://github.com/TDA/Java-Algorithms","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":190068,"global_rank":352514},{"name":"HenryCWong/worldmusicsorter","owner":"HenryCWong","html_url":"https://github.com/HenryCWong/worldmusicsorter","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"Sorts Music Based on the language the title of the song is written in","topics":[],"score":190068,"global_rank":352515},{"name":"ayoung1/TurnBasedRoguelike","owner":"ayoung1","html_url":"https://github