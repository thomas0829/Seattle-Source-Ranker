hers":1,"issues":1,"language":"Java","description":null,"topics":[],"score":294599,"global_rank":24353},{"name":"algorithmiaio/algorithmia-android","owner":"algorithmiaio","html_url":"https://github.com/algorithmiaio/algorithmia-android","stars":5,"forks":1,"watchers":21,"issues":0,"language":"Java","description":"Algorithmia Android Client","topics":[],"score":294589,"global_rank":24357},{"name":"navreeetkaur/machine-learning-algorithms","owner":"navreeetkaur","html_url":"https://github.com/navreeetkaur/machine-learning-algorithms","stars":4,"forks":3,"watchers":0,"issues":4,"language":"Java","description":"Implementation of Machine Learning algorithms from scratch","topics":["bayes-classifier","bayesian","classification","classification-algorithims","fashion-mnist","k-means-clustering","k-means-implementation-in-python","k-nearest-neighbours","naive-bayes-classifier","pca-analysis","principal-component-analysis"],"score":294511,"global_rank":24386},{"name":"prashanth08/Modelling-and-Analysis-of-Wireless-Sensor-Networks-with-Link-state-Routing-and-Security","owner":"prashanth08","html_url":"https://github.com/prashanth08/Modelling-and-Analysis-of-Wireless-Sensor-Networks-with-Link-state-Routing-and-Security","stars":7,"forks":4,"watchers":1,"issues":0,"language":"Java","description":"The main objective of this project is to simulate and analyze protocols associated with Alternate path routing (APR) which can be used to achieve efficient routing in communications networks. We describe the link state routing approach to APR in connection-oriented networks, and evaluate their performance using simulations. The source node transmits the node to its nearest neighbor and depending on the approach, alternate paths can be computed at intermediate nodes. We present initial simulation results to show the working and mechanism of APR using J2ME Wireless Toolkit. Further, we look at full network level privacy spectrum which comprises of identity, route, location and data privacy. Existing privacy schemes of wireless sensor networks only provide partial network level privacy. In this project, we propose full network level privacy solution that addresses this problem in APR protocols. This solution comprises of Identity, Route, Location (IRL) and data privacy mechanism that collectively provides protection against privacy disclosure attacks such as eavesdropping and hop-by-hop trace back attacks.","topics":[],"score":294504,"global_rank":24391},{"name":"n3zukochan/Mega_Project_Solutions","owner":"n3zukochan","html_url":"https://github.com/n3zukochan/Mega_Project_Solutions","stars":5,"forks":6,"watchers":1,"issues":0,"language":"Java","description":"Solutions to the Mega Project List by @karan","topics":[],"score":294460,"global_rank":24402},{"name":"gitraspigner/UW-Intro-Data-Structures-Projects","owner":"gitraspigner","html_url":"https://github.com/gitraspigner/UW-Intro-Data-Structures-Projects","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"Data structures projects from an intro class I took my freshman year (2017) at the University of Washington.","topics":[],"score":294315,"global_rank":24464},{"name":"fireduck64/es-stats","owner":"fireduck64","html_url":"https://github.com/fireduck64/es-stats","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"Tools for throwing things into Elasticsearch","topics":[],"score":294230,"global_rank":24503},{"name":"ExpediaGroup/housekeeping","owner":"ExpediaGroup","html_url":"https://github.com/ExpediaGroup/housekeeping","stars":3,"forks":3,"watchers":10,"issues":5,"language":"Java","description":"Common functionality for managing and cleaning up orphaned paths","topics":[],"score":294212,"global_rank":24512},{"name":"abcdabcd987/LLIRInterpreter","owner":"abcdabcd987","html_url":"https://github.com/abcdabcd987/LLIRInterpreter","stars":14,"forks":1,"watchers":0,"issues":0,"language":"Java","description":"Single file interpreter (or naive virtual machi