ame":"overlordnyaldee/ArrowWall","owner":"overlordnyaldee","html_url":"https://github.com/overlordnyaldee/ArrowWall","stars":2,"forks":1,"watchers":1,"issues":0,"language":"Java","description":"A Bukkit plugin that lets a user summon a wall of arrows.","topics":[],"score":230657,"global_rank":108193},{"name":"MHAN001/INFO6205_334","owner":"MHAN001","html_url":"https://github.com/MHAN001/INFO6205_334","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Java","description":null,"topics":[],"score":230643,"global_rank":108247},{"name":"amaslov/JavaWorkspace","owner":"amaslov","html_url":"https://github.com/amaslov/JavaWorkspace","stars":2,"forks":1,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230640,"global_rank":108249},{"name":"Sage-Bionetworks/BridgeDataUploadUtils","owner":"Sage-Bionetworks","html_url":"https://github.com/Sage-Bionetworks/BridgeDataUploadUtils","stars":0,"forks":4,"watchers":12,"issues":6,"language":"Java","description":"Bridge Upload Utils for Archive and Encryption","topics":[],"score":230637,"global_rank":108255},{"name":"saransh2405/question-answering-nlp","owner":"saransh2405","html_url":"https://github.com/saransh2405/question-answering-nlp","stars":1,"forks":1,"watchers":1,"issues":0,"language":"Java","description":"Question and answering system based on natural language processing using corpus from wikipedia  Answering questions from a corpus has always been viewed as an important aspect of natural language processing. Given the size of Wikipedia and web in general, and the information on such websites answering questions would lead to building a structural and associated data. This report aims at represented how a corpus can be processed to accurately give answers to related questions. For this, new algorithm has been proposed.  A QA implementation, usually a computer program, may construct its answers by querying a structured database of knowledge or information, usually a knowledge base. More commonly, QA systems can pull answers from an unstructured collection of natural language documents. Here a similar attempt at solving the problem has been performed, where part of a article from Wikipedia has been used as corpus and was tested against different type of questions that the program can answer correctly. Advanced QA requires sophisticated text processing tools based on state-of-the-art NLP.","topics":[],"score":230623,"global_rank":108270},{"name":"kyxap/receipt-processor-challenge","owner":"kyxap","html_url":"https://github.com/kyxap/receipt-processor-challenge","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":"receipt-processor-challenge","topics":[],"score":230613,"global_rank":108307},{"name":"huzaifa-vartana/northeastern-course-chatbot","owner":"huzaifa-vartana","html_url":"https://github.com/huzaifa-vartana/northeastern-course-chatbot","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230613,"global_rank":108321},{"name":"paulfranco/ScoreKeeper","owner":"paulfranco","html_url":"https://github.com/paulfranco/ScoreKeeper","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"simple soccer score keeper Android App","topics":[],"score":230602,"global_rank":108341},{"name":"ZTLaine/OptionalsPractice","owner":"ZTLaine","html_url":"https://github.com/ZTLaine/OptionalsPractice","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230599,"global_rank":108358},{"name":"Sayedli/Sha-3","owner":"Sayedli","html_url":"https://github.com/Sayedli/Sha-3","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230599,"global_rank":108368},{"name":"ryanvickr/Binary-Search-Tree","owner":"ryanvickr","html_url":"https://github.com/ryanvickr/Binary-Search-Tree","stars":1,"forks":0,"watchers":0,"issues":0,"language":"Java","description":"A simple application which scans a data file and