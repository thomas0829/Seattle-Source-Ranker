erformed, where part of a article from Wikipedia has been used as corpus and was tested against different type of questions that the program can answer correctly. Advanced QA requires sophisticated text processing tools based on state-of-the-art NLP.","topics":[],"score":230491,"global_rank":108962},{"name":"kvn147/SyntaxChecker","owner":"kvn147","html_url":"https://github.com/kvn147/SyntaxChecker","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230489,"global_rank":108970},{"name":"kvn147/MyStackMyQueue","owner":"kvn147","html_url":"https://github.com/kvn147/MyStackMyQueue","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230489,"global_rank":108971},{"name":"josecorella/git101_remote","owner":"josecorella","html_url":"https://github.com/josecorella/git101_remote","stars":0,"forks":0,"watchers":2,"issues":0,"language":"Java","description":"Git 101 Workshop Remote","topics":[],"score":230467,"global_rank":109039},{"name":"DevenPatel19/HelloFX","owner":"DevenPatel19","html_url":"https://github.com/DevenPatel19/HelloFX","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230435,"global_rank":109129},{"name":"DevenPatel19/CourseEnrollmentSystem","owner":"DevenPatel19","html_url":"https://github.com/DevenPatel19/CourseEnrollmentSystem","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230435,"global_rank":109130},{"name":"Halinston/midterm-java-cs143","owner":"Halinston","html_url":"https://github.com/Halinston/midterm-java-cs143","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":230435,"global_rank":109136},{"name":"jspores237/JsTennisShop","owner":"jspores237","html_url":"https://github.com/jspores237/JsTennisShop","stars":0,"forks":0,"watchers":1,"issues":0,"language":"Java","description":null,"topics":[],"score":23